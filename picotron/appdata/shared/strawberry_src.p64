:: lib/bin_flag.lua
--[[pod_format="raw",created="2025-05-20 13:49:35",modified="2025-05-22 11:54:08",revision=3492]]
function check_flag(val, flag)
	return (val & flag) == flag
end

BinaryFlag = create_class()

function create_flags(lst,zero_name)
	local flags = {}
	local cv = 1
	for _,val in pairs(lst) do
		flags[val] = cv
		cv*=2
	end
	if zero_name then
		flags[zero_name] = 0
	end
	return flags
end

function BinaryFlag:_init(attribs)
	self.val = attribs.value
	if (self.val==nil) self.val = 0
end

function BinaryFlag:check(flag)
	return (self.val & flag) == flag
end

function BinaryFlag:get(flag)
	return self.val
end

function BinaryFlag:set(flag)
	self.val = self.val | flag
end

function BinaryFlag:set_all(val)
	self.val = val
end

function BinaryFlag:toggle(flag)
	self.val = self.val ~ flag
end

function BinaryFlag:unset(flag)
	self.val = self.val & (~flag)
end

:: lib/create_class.lua
--[[pod_format="raw",created="2025-05-07 13:26:52",modified="2025-05-22 11:54:08",revision=5363]]
do

local _class = {}

function _class:__call(attribs)
	attribs = attribs or {}

	local inst = {}
	
	inst.apply_defaults = function(self,attribs)
		for k,v in pairs(attribs) do
			if self[k] == nil then
				self[k] = v
			end
		end
	end
	
	for _,sup in pairs(self.super) do
		local sup_inst = sup(attribs)
		for k,v in pairs(sup_inst) do
			inst[k]=v
		end
--		if sup_inst._init then
--			sup_inst._init(inst, attribs)
--		end
	end
	
	for k,v in pairs(self) do
		inst[k]=v
	end
	
	setmetatable(inst,self)
	
	if self._init then
		self._init(inst, attribs)
	end
	
	return inst
end

function create_class(...)
	local nc = {}

	setmetatable(nc,_class)
	
	nc.class = nc
	nc.super = {...}
	
	return nc
end

end

:: lib/get_print_rect.lua
--[[pod_format="raw",created="2025-05-22 11:18:18",modified="2025-05-22 11:54:08",revision=128]]
function get_print_rect(text,x,y,c)
	local print_rect = {x=x,y=y}
	local pdt = get_draw_target()
	set_draw_target(userdata("u8",1,1))
	print_rect.w = print(text,0,0)
	print_rect.h = peek(0x0054f4)
	set_draw_target(pdt)
	return print_rect
end
:: lib/mouse.lua
--[[pod_format="raw",created="2025-03-27 10:01:44",modified="2025-07-22 14:01:46",revision=8624,xstickers={}]]
-- Mouse and mouse button classes
-- Mouse is a singleton, needs update called every frame.

CLICK_STATES = create_flags(
	{
		"clicked",
		"held",
		"released",
	},
	"none"
)

CLICK_TRANSITION = {
	[true] = {
		[CLICK_STATES.none] = CLICK_STATES.clicked,
		[CLICK_STATES.clicked] = CLICK_STATES.held,
		[CLICK_STATES.held] = CLICK_STATES.held,
		[CLICK_STATES.released] = CLICK_STATES.released,
	},
	[false] = {
		[CLICK_STATES.none] = CLICK_STATES.none,
		[CLICK_STATES.clicked] = CLICK_STATES.released,
		[CLICK_STATES.held] = CLICK_STATES.released,
		[CLICK_STATES.released] = CLICK_STATES.none,
	}
}

MouseButton = create_class()

function MouseButton:_init(attribs)
	self.name = attribs.name
	self.flag = attribs.flag
	self.last_released= 100
	self.click_state = BinaryFlag()
	self.n_clicks = 1
end

function MouseButton:update(button_flags)
	local clicked = check_flag(button_flags,self.flag)

	self.last_released+=1
	
--	if self.last_released == 25 then
--		self.n_clicks = 0
--	end
	
	self.click_state:set_all(
		CLICK_TRANSITION[clicked][self.click_state:get()]
	)
	
	if self.click_state:check(CLICK_STATES.released) then
		self.last_released = 0
	elseif self.click_state:check(CLICK_STATES.clicked) and 
		self.last_released < 25 then
		self.n_clicks += 1
	elseif self.click_state:check(CLICK_STATES.clicked) then
		self.n_clicks = 1
	end
	
--	self.last_double_clicked+=1
--	self.ppr=self.cpr
--	self.cpr=click
--	self.dc=false
--	self.tc=false
--	if self:clicked() and self.last_double_clicked < 25 then
--		self.tc=true
--		self.last_clicked=25
--		self.last_double_clicked = 25
--	elseif self:clicked() and self.last_clicked < 25 then
--		self.dc=true
--		self.last_clicked=25
--		self.last_double_clicked = 0
--	elseif self:clicked() then
--		self.last_clicked=0
--	end
end

function MouseButton:not_clicked()
	return self.click_state:get() == 0
end

function MouseButton:clicked()
	return self.click_state:check(CLICK_STATES.clicked)
end

function MouseButton:released()
	return self.click_state:check(CLICK_STATES.released)
end

function MouseButton:held()
	return self.click_state:check(CLICK_STATES.held)
end

Mouse = {
	pos=vec(0,0),
	last_pos=vec(0,0),
	scroll=vec(0,0),
	lmb=MouseButton{name="lmb",flag=0b1},
	rmb=MouseButton{name="rmb",flag=0b10},
	mmb=MouseButton{name="mmb",flag=0b100},
	pointer=1,
	last_updated=-1,
}
Mouse.btns = {Mouse.lmb,Mouse.rmb,Mouse.mmb}

function Mouse:update()
	local x,y,bmap,sx,sy = mouse()

	self.scroll=vec(sx,sy)
	self.last_pos=self.pos
	self.pos = vec(x,y)
	
	window{cursor=self.pointer}
	self.pointer = 1
	
	self.lmb:update(bmap)
	self.rmb:update(bmap)
	self.mmb:update(bmap)
end

function Mouse:set_pointer(p)
	self.pointer = p
end

function Mouse:has_moved()
	return self.pos - self.last_pos
end

function Mouse:is_in(r)
	return (
		self.pos.x>=r.pos.x and
		self.pos.y>=r.pos.y and
		self.pos.x<=r.pos.x+(r.w or 0) and
		self.pos.y<=r.pos.y+(r.h or 0)
	)
end

function get_mouse_listener()
	return Mouse
end

:: lib/perf.lua
--[[pod_format="raw",created="2025-03-27 11:23:47",modified="2025-04-07 13:32:47",revision=6974]]
function create_perf_tracker()
	return {
		total=0,
		log=log_perf_step,
		draw=draw_tracker,
		new_frame=new_log_perf_frame,
		prev_frames={},
		prev_frames_mem={},
	}
end

function new_log_perf_frame(tracker)
	add(tracker.prev_frames,tracker.total)
	add(tracker.prev_frames_mem,(flr(stat(0)/1024^2*100)/100))
	tracker.total=0
	while #tracker > 0 do
		deli(tracker,1)
	end
	while #tracker.prev_frames > 60*5 do
		deli(tracker.prev_frames,1)
	end
	while #tracker.prev_frames_mem > 10 do
		deli(tracker.prev_frames_mem,1)
	end
end

function log_perf_step(tracker,name,col)
	local cur_stat = stat(1)-tracker.total
	add(tracker,{name=name,col=col,val=cur_stat})
	tracker.total += cur_stat
end

function draw_tracker(tracker)
	local x = get_display():width()-1
	local y = get_display():height()-1
	--rectfill(x-2,0,x,y,1)
	line(x-2,y,x,y,7)
	line(x-2,y-100,x,y-100,7)
	line(x-2,y-200,x,y-200,7)
	local st = 0
	for item in all(tracker) do
		local nxt = st+flr(item.val*100)
		line(x-1,y-st,x-1,y-nxt,item.col)
		st = nxt
	end
	local c=1
	local s=tracker.total
	local m=(flr(stat(0)/1024^2*100)/100)
	for i = 0,min(#tracker.prev_frames-1,9) do
		c+=1
		s+=tracker.prev_frames[#tracker.prev_frames-i]
		m+=tracker.prev_frames_mem[#tracker.prev_frames_mem-i]
	end
	
	local mx = 0
	if #tracker.prev_frames > 0 then
		
		for f in all(tracker.prev_frames) do
			mx = max(mx,f)
		end
		line(x-2,y-mx*100,x,y-mx*100,8)
--		if mx > 0.5 then
--			local s = flr(mx*100).."%"
--			print(s,x-2-5*#s,max(0,y-mx*100),8)
--		end
	end
	
	local s = flr(s/c*100).."%"
	local m = flr(m/c).."mb"
	local fps = "FPS: "..flr(stat(7))
	local mx_s = flr(mx*100).."%"
	local mw = max(#s,max(#fps,max(#mx_s,#m)))
	rectfill(x-8-5*mw,y-42,x-3,y,1)
	print(s,x-4-5*#s,y-30,7)
	print(m,x-4-5*#m,y-20,6)
	print(fps,x-4-5*#fps,y-10,7)
	print(mx_s,x-4-5*#mx_s,y-40,8)
	
end

:: lib/sec_ord.lua
--[[pod_format="raw",created="2025-04-04 13:52:52",modified="2025-05-22 09:00:30",revision=1024]]
PI = 3.141592654

SecOrdDyn = create_class()

function SecOrdDyn:_init(attribs)
	self.pos = attribs.pos or vec(0,0)
	self.f = attribs.f
	self.z = attribs.z
	self.r = attribs.r
	self:apply_defaults{
		target = self.pos,
		x=self.pos.x,
		y=self.pos.y,
		prev_targ=self.pos,
		vel=vec(0,0),
		k1 = self.z / (PI * self.f),
		k2 = 1 / (2 * PI * self.f)^2,
		k3 = self.r * self.z / (2 * PI * self.f),
	}
end

function SecOrdDyn:update(new_pos)
	self.target = new_pos or self.target
	local targ_vel = self.target-self.prev_targ
	self.prev_targ = self.target
	self.pos = self.pos + self.vel
	self.x=flr(self.pos.x*100)/100
	self.y=flr(self.pos.y*100)/100
	self.vel = self.vel + (self.target + self.k3*targ_vel - self.pos - self.k1*self.vel)/self.k2
end

:: lib/sort_list.lua
--[[pod_format="raw",created="2025-05-22 12:10:18",modified="2025-05-22 15:11:22",revision=553]]
function sort_list_alpha(lst)
	local n = #lst
	
	for i = 1,n do
		local swapped = false
		for j = 1,n-i do
			if alpha_a_gt_b(lst[j],lst[j+1]) then
				lst[j], lst[j+1] = lst[j+1], lst[j]
				swapped=true
			end
		end
		
		if not swapped then
			break
		end
	end
	
	return lst
end

function alpha_a_gt_b(a,b)
	for i = 1,min(#a,#b) do
		if ord(a[i]) < ord(b[i]) then
			return false
		elseif ord(a[i]) > ord(b[i]) then
			return true
		end
	end
	return #a > #b
end

:: lib/traceback.lua
--[[pod_format="raw",created="2025-05-21 05:53:56",modified="2025-05-21 07:59:54",revision=247]]
window{
	width=200,
	height=100
}

function _init()
	cd("..")
	local fp = env().argv[1]
	base_env = unpod(fetch(fullpath("lib/xi_gui/data/base_env.pod")))
	
	local new_env = {}
	
	for _,nm in pairs(base_env) do
		new_env[nm] = _ENV[nm]
	end
	
	src = fetch(fp)
	
	assert(src,"Src file not found.")
	
--	src = src .. [[
--		_init()
--		while true do
--			_update()
--			_draw()
--			yield()
--		end
--	]]
	
	prog, err = load(src,"@"..fp,"t",new_env)
	assert(err==nil,err)
	prog_routine = cocreate(prog)
end

function _update()
	if keyp("space") then exit() end
	
	if costatus(prog_routine) != "dead" then
		success, err = coresume(prog_routine)
		if not success then
			traceback = debug.traceback(prog_routine)
		end
	end
end

function _draw()
	cls(1)
	print(err,2,2,7)
	print(traceback,2,12,7)
end

