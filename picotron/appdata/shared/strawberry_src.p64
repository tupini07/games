for file in all(ls("lib/xi_gui/mixins")) do
	include("lib/xi_gui/mixins/"..file)
end

include "lib/xi_gui/elems/container.lua"
include "lib/xi_gui/elems/canvas.lua"

include "lib/xi_gui/elems/label.lua"
