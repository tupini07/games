--[[pod_format="raw",created="2025-03-31 21:07:49",modified="2025-05-07 12:05:11",revision=1323]]
do

local SmlCheckBox = {}

local checked_spr = (
unpod("b64:bHo0ABsAAAAZAAAA8ApweHUAQyAGBQQHMBcABwAHAAcQBxAHQEcA")
)

local unchecked_spr = (
unpod("b64:bHo0ABsAAAAZAAAA8ApweHUAQyAGBQRHAAcgBwAHIAcAByAHAEcA")
)

function SmlCheckBox:draw_self()
	local pos=self:get_pos()
	local sprite = unchecked_spr
	if self.selected then
		sprite = checked_spr
	end
	pal(7,self:get_theme_colour(self.cur_col))
	spr(sprite,pos.x+self.l_pad,pos.y+self.t_pad)
	pal(7,7)
	print_small(
		self.text,
		pos.x+9+self.l_pad,
		pos.y+self.t_pad,
		self:get_theme_colour(self.text_col)
	)
end

function create_small_checkbox(attribs)
	assert(attribs.callback, "No callback provided when creating checkbox.")

	local l_pad = attribs.l_pad or 0
	local text  = attribs.text or ""

	merge_template(attribs,
		{
			l_pad=l_pad,
			w=8+2*l_pad+4*#text,
			h=7,
			text=text,
			text_col="basic_text",
			hover_col="highlight",
			t_pad=0,
		}
	)
	
	return create_new_elem(SmlCheckBox,attribs,create_checkbox)
end

end

:: src/sml_label.lua
--[[pod_format="raw",created="2025-03-31 13:33:54",modified="2025-05-07 12:33:02",revision=1263]]
do

local SmlLabel={}

function SmlLabel:set_text(text)
	if text == self.text then return end
	self.text=text
	local nw = print_small(self.text,0,-1000)
	if nw != self.w then
		self:update_dims{w=nw}
	end
end

function SmlLabel:draw_self()
	if self.hide then return end

	local pos = self:get_pos()
	if self.y_off then
		pos.y+=self.y_off
	end
	print_small(self.text,pos.x,pos.y,self:get_theme_colour(self.text_col))
end

function create_sml_label(attribs)
	-- Required attributes:
	-- text: text to display
	-- Optional attributes:
	-- text_col: text colour name
	
	assert(attribs.text, "No text provided when creating label.")
	
	merge_template(attribs,{text_col="basic_text",h=10,w=#attribs.text*4+2})

	return create_new_elem(SmlLabel,attribs)
end

end
