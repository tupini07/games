:: lib/xi_gui/dim_funcs.lua
--[[pod_format="raw",created="2025-03-28 07:14:20",modified="2025-05-23 12:00:32",revision=6323]]
function full_width(padding)
	padding = padding or 0
	return function(e)
		if not e.parent then
			return 10
		end
		
		return (e.parent.w or 10)-2*padding
	end
end

function full_height(padding)
	padding = padding or 0
	return function(e)
		if not e.parent then
			return 10
		end
		
		return (e.parent.h or 10)-2*padding
	end
end


function contents_height(padding)
	padding = padding or 0
	return function(e)
		local h = 0
		for el in all(e.elems) do
			h+=el.h
			if e.gap_size then h+=e.gap_size end
		end
		h += 2*padding
		return h
	end
end

function contents_width(padding)
	padding = padding or 0
	return function(e)
		local w = 0
		for el in all(e.elems) do
			if el != e then
				w+=el.w
			end
		end
		w += 2*padding
		return w
	end
end


function percent_of_height(val,minimum)
	if val > 1 then val/=100 end
	val = mid(0,val,1)
	return function(e)
		if not e.parent then return e.w end
		local h = e.parent.h*val
		if minimum then
			h = max(minimum,h)
		end
		return h
	end
end

function percent_of_width(val,minimum)
	if val > 1 then val/=100 end
	val = mid(0,val,1)
	return function(e)
		if not e.parent then return e.w end
		local w = (e.parent.w or 0)*val
		if minimum then
			w = max(minimum,w)
		end
		return w
	end
end

function remaining_width(padding)
	padding = padding or 0
	return function(e)
		if not e.parent then return e.w end
		local w = e.parent.w
		for el in all(e.parent.elems) do
			if el != e then
				w-=el.w
			end
		end
		w -= 2*padding
		return w
	end
end

function remaining_height(padding)
	padding = padding or 0
	return function(e)
		if not e.parent then return e.w end
		local h = e.parent.h
		for el in all(e.parent.elems) do
			if el != e then
				h-=el.h
			end
			h-=2*padding
		end
		return h
	end
end

:: lib/xi_gui/elem.lua
--[[pod_format="raw",created="2025-03-27 09:41:07",modified="2025-08-23 07:34:59",revision=88721,xstickers={}]]
-- XiGuiElem class
-- Base class for all elements

do

XiGuiElem = create_class()

function XiGuiElem:_init(attribs)
	local w, h = attribs.w, attribs.h
	local w_func, h_func = nil, nil
	if type(w) == "function" then
		attribs.w_func = w
		attribs.w = nil
	end
	if type(h) == "function" then
		attribs.h_func = h
		attribs.h = nil
	end

	self:apply_defaults{
		elems={},
		pos = vec(0,0),
		abs_pos = vec(0,0),
		canv_pos = vec(0,0),
	}
	
	for k,v in pairs(attribs) do
		self[k] = v
	end
end

function XiGuiElem:calc_pos(abs_origin,canv_origin)
	self.abs_pos = abs_origin + self.pos
	self.canv_pos = canv_origin + self.pos
	
	if self.offset then
		self.abs_pos+=self.offset
		self.canv_pos+=self.offset
	end
	
	if self.pos.x < 0 then
		self.canv_pos.x += (self.parent.w or 0) - (self.w or 0) + 1
		self.abs_pos.x += (self.parent.w or 0) - (self.w or 0) + 1
	end
	
	if self.pos.y < 0 then
		self.canv_pos.y += (self.parent.h or 0) - (self.h or 0) + 1
		self.abs_pos.y += (self.parent.h or 0) - (self.h or 0) + 1
	end
	
	for _,el in pairs(self.elems) do
--		if (not el:out_of_bounds()) el:update_all(self.abs_pos,self.canv_pos)
		el:calc_pos(self.abs_pos,self.canv_pos)
	end
end

function XiGuiElem:update_all(abs_origin,canv_origin)
--	self:calc_pos(abs_origin,canv_origin)

	self:update()
	
	for _,el in pairs(self.elems) do
--		if (not el:out_of_bounds()) el:update_all(self.abs_pos,self.canv_pos)
		el:update_all(self.abs_pos,self.canv_pos)
	end
end

function XiGuiElem:update()
end

function XiGuiElem:get_gui()
	if not self.parent then return self end
	return self.parent:get_gui()
end

function XiGuiElem:get_rect()
	return {
		pos=self.abs_pos,
		w=self.w,
		h=self.h
	}
end

function XiGuiElem:draw_all()
	self:clip()
	self:draw()
	for _,el in pairs(self.elems) do
		if (not el:out_of_bounds()) el:draw_all()
	end
	self.redraw_needed = false
	self.child_requested_redraw = false
end

function XiGuiElem:draw()
end

--[[GROUP:Gui interactions]]

function XiGuiElem:add_to(parent,pos,index)
	if self.parent then self:remove() end

	self.parent = parent
	self.pos = pos or vec(0,0)
	self:calc_z()
	
	if parent.scroll and type(parent.scroll) == "userdata" then
		self.offset = -1*parent.scroll
	else
		self.offset = nil
	end
	
	self:calc_pos(parent.abs_pos,parent.canv_pos)
	
	index = index or #parent.elems+1
	
	add(parent.elems,self,index)

	self:self_moved()
	self:parent_width_change()
	self:parent_height_change()
	self.parent:child_width_change()
	self.parent:child_height_change()
	
	if self.class != TextEditor then
		self:update_all(parent.abs_pos,parent.canv_pos)
	end
	
	if self.scrollbar and self.scrollbar.parent == nil then
		self.scrollbar:add_to(self,vec(-1,0))
	end
	
	self:after_added()
	
	return self
end

function XiGuiElem:after_added()
end

function XiGuiElem:out_of_bounds()
	return self.abs_pos.x > self.parent.abs_pos.x + self.parent.w or
		self.abs_pos.y > self.parent.abs_pos.y + self.parent.h or
		self.abs_pos.x + (self.w or 0) < self.parent.abs_pos.x or
		self.abs_pos.y + (self.h or 0) < self.parent.abs_pos.y
end

function XiGuiElem:add_elem(e,pos,index)
	e:add_to(self,pos,index)
	return self
end

function XiGuiElem:calc_z()
	if self.z == nil and self.parent and self.parent.z then
		self.z = self.parent.z+1
	elseif self.parent and self.parent.z then
		self.z = max(self.parent.z+1, self.z)
	end
end

function XiGuiElem:has_focus(target)
	target = target or self
	if not self.parent then return false end
	return self.parent:has_focus(target)
end

function XiGuiElem:set_focus(target)
	target = target or self
	return self.parent:set_focus(target)
end

function XiGuiElem:fix_hold(target)
	target = target or self
	return self.parent:fix_hold(target)
end

function XiGuiElem:get_theme()
	if (not self.parent) return {}
	return self.parent:get_theme()
end

function XiGuiElem:get_theme_colour(col_name)
	if (not self.parent) return 0
	return self.parent:get_theme_colour(col_name)
end

function XiGuiElem:show_tooltip(args,origin)
	origin = origin or self
	if self.parent then
		self.parent:show_tooltip(args,origin)
	end
end

--function XiGuiElem:get_pos()
--	local pos = self.pos
--	
--	if self.offset then
--		pos+=self.offset
--	end
--
--	if self.parent then
--		return self.parent:get_pos() + pos
--	else
--		return pos
--	end
--end

function XiGuiElem:clip()
	self.parent:clip()
	clip(self.canv_pos.x,self.canv_pos.y,self.w,self.h,true)
--	clip()
end

function XiGuiElem:remove()
	local parent = self.parent
	self.parent = nil
	self.pos=nil
	self.z=nil
	
	del(parent.elems,self)

	parent:child_width_change(self)
	parent:child_height_change(self)
	return self
end

function XiGuiElem:remove_elem(e)
	e:remove()
end

function XiGuiElem:request_redraw(full,origin)
	if origin == nil then
		origin = self
	end
	
	if full or origin == self then
		self.redraw_needed = true
	else
		self.child_requested_redraw = true
	end
	
	if self.parent then
		self.parent:request_redraw(full,origin)
	end
end

function XiGuiElem:redraw_all()
	self.redraw_needed = true
	for _, el in pairs(self.elems) do
		el:redraw_all()
	end
end

--[[GROUP:update dims]]

function XiGuiElem:update_dims(attribs)
	for k, v in pairs(attribs) do
		local prev_v = self[k]
		self[k]=v
		
		if k == "h" and prev_v!=v then
			self:self_height_change()
		
			if self.parent then
				self.parent:child_height_change(self)
				for _,el in pairs(self.parent.elems) do
					if (el!=self) el:sibling_height_change()
				end
			end
			
			for _,el in pairs(self.elems) do
				el:parent_height_change()
			end
		elseif k == "w" and prev_v!=v then
			self:self_width_change()
		
			if self.parent then
				self.parent:child_width_change(self)
				for _,el in pairs(self.parent.elems) do
					if (el!=self) el:sibling_width_change()
				end
			end
			
			for _,el in pairs(self.elems) do
				el:parent_width_change()
			end
		elseif k == "pos" and (prev_v.x != v.x or prev_v.y != v.y) then
			self:self_moved()
			if self.parent then
				self.parent:child_moved()
			end
		end
	end
end

function XiGuiElem:get_top_click_target()
	if self.z == nil then
		self:calc_z()
	end
	if not get_mouse_listener():is_in(self:get_rect()) then
		return nil
	else
		local best_option = (self.clickable and self) or nil
		for _,e in pairs(self.elems) do
			local op = e:get_top_click_target()
			if op and (not best_option or op.z >= best_option.z) then
				best_option = op
			end
		end
		return best_option
	end
end

function XiGuiElem:get_top_scroll_target()
	if self.z == nil then
		self:calc_z()
	end
	if not get_mouse_listener():is_in(self:get_rect()) then
		return nil
	else
		local best_option = (self.scrollable and self) or nil
		for _,e in pairs(self.elems) do
			local op = e:get_top_scroll_target()
			if op and (not best_option or op.z >= best_option.z) then
				best_option = op
			end
		end
		return best_option
	end
end

function XiGuiElem:child_moved()
	self:request_redraw(true)
end

function XiGuiElem:self_moved()
	if (self.parent) self:calc_pos(self.parent.abs_pos,self.parent.canv_pos)
end

function XiGuiElem:self_width_change()
	self:request_redraw(true)
end

function XiGuiElem:self_height_change()
	self:request_redraw(true)
end

function XiGuiElem:child_width_change(origin)
	self:refresh_width()
end

function XiGuiElem:parent_width_change()
	self:refresh_width()
end

function XiGuiElem:sibling_width_change()
	self:refresh_width()
end

function XiGuiElem:child_height_change(origin)
	self:refresh_height()
end

function XiGuiElem:parent_height_change()
	self:refresh_height()
end

function XiGuiElem:sibling_height_change()
	self:refresh_height()
end

function XiGuiElem:refresh_width()
	if type(self.w_func) == "function" then
		self:update_dims{w=self:w_func()}
	end
end

function XiGuiElem:refresh_height()
	if type(self.h_func) == "function" then
		self:update_dims{h=self:h_func()}
	end
end

end

