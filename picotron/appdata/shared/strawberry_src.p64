--[[pod_format="raw",created="2025-03-27 10:24:36",modified="2025-05-22 15:11:22",revision=13543]]
TextBtn = create_class(_SolidBtn)

function TextBtn:_init(attribs)
	assert(self.text, "No text provided when creating text button.")
	assert(self.callback, "No callback provided when creating text button.")
	
	if attribs.small_text then
		self:apply_defaults{
			w=#attribs.text*4+5,
			h=7,
			l_pad=2,
			t_pad=1,
			text_col="bg",
		}
	else
		self:apply_defaults{
			w=#attribs.text*5+10,
			h=11,
			l_pad=5,
			t_pad=2,
			text_col="bg",
		}
	end
end

function TextBtn:draw()
	local cur_col = self:get_theme_colour(self.cur_col)
	
	rrectfill(
		self.canv_pos.x,
		self.canv_pos.y,
		self.w,
		self.h,
		self.r or 0,
		cur_col
	)
	
	if self.small_text then
		print(
			"\014"..self.text,
			self.canv_pos.x+self.l_pad,
			self.canv_pos.y+self.t_pad,
			self:get_theme_colour(self.text_col)
		)
	else
		print(
			self.text,
			self.canv_pos.x+self.l_pad,
			self.canv_pos.y+self.t_pad,
			self:get_theme_colour(self.text_col)
		)
	end
end

:: lib/xi_gui/elems/tooltip.lua
--[[pod_format="raw",created="2025-03-31 14:10:51",modified="2025-05-22 12:30:04",revision=6823]]
do

Tooltip = create_class(Canvas)

function Tooltip:_init(attribs)
	local dh = 3
	local w = 10
	
	if type(self.text) == "string" then
		self.text = split(self.text,"\n",false)
	end
	
	if self.title then
		local print_rect = get_print_rect(self.title,0,0)
		dh+=print_rect.h
		w = max(w,print_rect.w+10)
	end
	
	if self.text then
		for _,l in pairs(self.text) do
			local print_rect = get_print_rect(l,0,0)
			w = max(w,10+print_rect.w)
			dh+=print_rect.h
		end
	end

	self:apply_defaults{
		w=w,
		h=dh,
		title_col="light",
		text_col="basic_text",
		border_col="middle",
	}
	
	if attribs.bg_col == nil then
		self.bg_col = "bg"
	end

	
	if self.code then
		local tlns = self.text
		self.text = {}
		local pl
		for ln in all(tlns) do
			local nl =  TextLine{text=ln,prev=pl}
			add(self.text,nl)
			pl=nl
		end
	end
end

function Tooltip:update_pos()
	local pos=Mouse.pos+vec(7,7)
	
	local max_x = self.parent.w-self.w-5
	local max_y = self.parent.h-self.h-5
	
	pos.x=min(max_x,pos.x)
	pos.y=min(max_y,pos.y)
	
	self:update_dims{pos=pos}
end

function Tooltip:update()
	self:update_pos()
end

function Tooltip:draw()
	local pos = self.canv_pos
	local y = pos.y+2
	local oy = pos.y+2
	rectfill(
		pos.x,
		pos.y,
		pos.x+self.w-1,
		pos.y+self.h-1,
		self:get_theme_colour(self.bg_col)
	)
	
	if self.title then
		local pr = print(self.title,pos.x+5,y,self:get_theme_colour(self.title_col))
		y = pos.y+2+peek(0x0054f4)-oy
	end

	local text_col = self:get_theme_colour(self.text_col)

	for _,l in pairs(self.text or {}) do
		if self.code then
			l:print{
				pos = vec(pos.x+5,y),
				bg_col = self.bg_col,
				theme = self:get_theme(),
				highlight_syntax=true,
				func_descs={},
				user_funcs={},
				rainbow_brackets=self.rainbow_brackets
			}
		else
			print(l,pos.x+5,y,text_col)
		end
		y = pos.y+2+peek(0x0054f4)-oy
	end

	rect(
		pos.x,pos.y,pos.x+self.w-1,pos.y+self.h-1,self:get_theme_colour(self.border_col)
	)
end

end

:: lib/xi_gui/elems/vert_layout.lua
--[[pod_format="raw",created="2025-03-27 12:12:23",modified="2025-05-27 07:01:49",revision=14106,xstickers={}]]
do 

ALIGN_LEFT = 1
ALIGN_RIGHT = 2
ALIGN_CENTRE = 3

VertLayout = create_class()

function VertLayout:_init(attribs)
	self:apply_defaults{
		gap_size=0,
		l_pad=0,
		t_pad=0,
		wrap=false,
		align=ALIGN_LEFT,
	}
end

function VertLayout:refresh_content_position()
	assert(false)

	local cols = {
		{
			max_width=0,
		},
	}
	local y = self.t_pad
	local cur_col = cols[1]
	
	for e in all(self.elems) do
		if not e.special_typ then
			if self.wrap and y+e.h+self.t_pad > self.h then
				y = self.t_pad
				add(cols,
					{
						max_width = 0
					}
				)
				cur_col = cols[#cols]
			end
			add(cur_col, e)
			y+=self.gap_size+e.h
			cur_col.max_width = max(cur_col.max_width,e.w)
		end
	end
	
	local tw = 0--self.l_pad*2
	for i,col in ipairs(cols) do
		tw+=col.max_width
	end
	
--	local adj = max((self.w-self.l_pad*(#cols+1))/tw,1)
	local adj = (self.w-self.l_pad*(#cols+1))/tw
	
	local x = self.l_pad
	for col in all(cols) do
		y = self.t_pad
		for e in all(col) do
			local xpos = 0
			if self.align == ALIGN_RIGHT then
				xpos=col.max_width*adj-e.w
			elseif self.align == ALIGN_CENTRE then
				xpos=(col.max_width*adj-e.w)/2 
			end
			e.pos = vec(x+xpos,y)
			y+=self.gap_size+e.h
		end
		x+=col.max_width*adj+self.l_pad
	end
	
	self:update_content_size()
	
	assert(false)
	
	self:request_redraw(true)
end

function VertLayout:self_height_change()
	self:refresh_content_position()
end

function VertLayout:self_width_change()
	self:refresh_content_position()
end

function VertLayout:child_height_change()
	self:refresh_height()
	self:refresh_content_position()
end

function VertLayout:child_width_change()
	self:refresh_width()
	self:refresh_content_position()
end

end
:: lib/xi_gui/elems/width_ruler.lua
--[[pod_format="raw",created="2025-03-28 08:37:09",modified="2025-04-07 18:10:24",revision=3451]]
do

local WidthRuler={
}

function WidthRuler:draw_self(pos)
	local lc = self:get_theme_colour(self.line_col)
	local tc = self:get_theme_colour(self.text_col)
	local ws = tostr(flr(self.w)).."px"

	if self.percent then
		ws = tostr(flr(100*self.parent.w/self.parent.parent.w+0.5)).."%"
	end	

	line(pos.x,pos.y+5,pos.x+(self.w-#ws*5-6)/2,pos.y+5,lc)
	line(pos.x,pos.y+5,pos.x+2,pos.y+7,lc)
	line(pos.x,pos.y+5,pos.x+2,pos.y+3,lc)
	line(pos.x+self.w-1,pos.y+5,pos.x+self.w-3,pos.y+7,lc)
	line(pos.x+self.w-1,pos.y+5,pos.x+self.w-3,pos.y+3,lc)
	line(pos.x+(self.w+#ws*5+6)/2,pos.y+5,pos.x+self.w-1,pos.y+5,lc)
	print(ws,pos.x+(self.w-#ws*5)/2,pos.y+1)
end

function create_width_ruler(attribs)
	-- Measures current container
	merge_template(attribs,{text_col="highlight",line_col="highlight",h=10,w=full_width()})

	return create_new_elem(WidthRuler,attribs)
end

end
:: lib/xi_gui/elems/_btn.lua
--[[pod_format="raw",created="2025-03-28 06:19:09",modified="2025-05-26 19:26:59",revision=11127,xstickers={}]]
do

_Btn = create_class(XiGuiElem,Clickable)

local BS_NONE = 0
local BS_HOVER = 1
local BS_CLICK = 2
local BS_HOLD = 3
local BS_RELEASE = 4

function _Btn:_init(attribs)
	self:apply_defaults{
		base_col="middle",
		hover_col="light",
		click_col="highlight",
		disabled_col="bg",
		enabled=true,
	}
	self.hovered = false
	self.click_state = BS_NONE
	self.prev_click_state = BS_NONE
	self.cur_col = self.base_col
	self.hover_for = 0
	
	if attribs.bg_col == nil then
		self.bg_col = "bg"
	end
end

function _Btn:disable()
	self.enabled = false
	self.cur_col = self.disabled_col
	self:request_redraw()
end

function _Btn:update()
--	Container.update(self)
	if self.click_state == BS_RELEASE or 
		(not self.hovered and self.click_state != BS_NONE)
	then
		self.click_state = BS_NONE
		self.cur_col = self.base_col
	end
	
	if self.click_state == BS_NONE and self.hovered then
		self.click_state = BS_HOVER
	end
	
	if self.prev_click_state != self.click_state then
		self:request_redraw(true)
	end
	
	self.prev_click_state = self.click_state
	
	if self.click_state == BS_HOVER then
		self.hover_for += 1
		if self.hover_for >= 30 and self.tooltip then
			self:show_tooltip(self.tooltip)
		end
	else
		self.hover_for = 0
	end
	
	if self.click_state == BS_HOLD then
		if (self.hold_for >= 25 or self.hold_for == 0) and 
			self.hold_repeat
		then
			self:callback()
			self.hold_for = min(self.hold_for,18)
		end
		self.hold_for += 1
	else
		self.hold_for = 0
	end
end

--function round_rect(x,y,w,h,col,fill,rounding)
--	rounding = rounding or 1
--	local func = rect
--	if fill then func = rectfill end
--	
--	for i = 1,rounding do
--		rectfill(
--		x+i,
--		y,
--		x+w-1-i,
--		y+h-1,
--		col
--	)
--	rectfill(
--		x,
--		y+i,
--		x+w-1,
--		y+h-1-i,
--		col
--	)
--	end
--end

function _Btn:lmb_click()
	if not self.enabled then return end
	
	self.click_state = BS_CLICK
	
	self.cur_col = self.click_col
end

function _Btn:lmb_hold()
	if not self.enabled then return end

	self.click_state = BS_HOLD

	self.cur_col = self.click_col
end

function _Btn:lmb_release()
	if not self.enabled then return end
	self.click_state = BS_RELEASE

	self.cur_col = self.click_col

	if not self.hold_repeat then
		self:callback()
	end
end

function _Btn:hover()
	if not self.enabled then return end
	
	self.hovered = true
	self.cur_col = self.hover_col

	Mouse:set_pointer("pointer")
end

function _Btn:end_hover()
	if not self.enabled then return end

	self.hovered = false

	self.cur_col = self.base_col
end

_SolidBtn = create_class(Canvas,_Btn)

end

