--[[pod_format="raw",created="2025-03-31 13:18:28",modified="2025-05-06 11:03:34",revision=6006]]
do

local _tab={}


function _tab:activate()
	text_ed.content = self.content
	self.selected = true
	for tab in all(tabs) do
	end
end

function _tab:draw_self()
	local pos = self:get_pos()
	local nm_parts = split(self.content.id,"/",false)
	local bg_col = self:get_theme_colour("middle")
	if self.selected then
		bg_col = self:get_theme_colour("light")
	end
	pal(7,bg_col)
	spr(8,pos.x,pos.y+1)
	rectfill(pos.x+3,pos.y+1,pos.x+self.w-4,pos.y+self.h-1,bg_col)
	spr(9,pos.x+self.w-3,pos.y+1)
	pal(7,7)
	print(tostr(nm_parts[#nm_parts]),pos.x+5,pos.y+3,self:get_theme_colour("tab_text"))
end

function create_tab(attribs)
	assert(attribs.content, "Tab not associeted with content.")

	merge_template(
		attribs,
		{
			w=5*tostr(#attribs.content.id)+10,
			h=12,
			callback=function() end,
			crs=create_cursor(attribs.content,1,1)
		}
	)

	local _tab = create_new_elem(_tab,attribs,_create_btn)
	
	return _tab
end

end
