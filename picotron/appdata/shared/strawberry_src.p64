--end

function TextEditor:add_sticker(idx)
	local s = self.content:add_sticker({ln_n=1,idx=idx,off=vec(3,3)})
	s:add_to(self,vec(-1000,1000))
	s.te=self
	self.content.line_refresh_needed=true
	return s
end

--[[GROUP:mouse]]

function TextEditor:lmb_click()
	local mse_at = self:create_crs_at_mse()
	if not key("shift") then
		self.content.selection = nil
		self.held_crs = mse_at
	elseif self.held_crs == nil then
		self.held_crs=self.content.crs
	end
	self.content.crs = mse_at
	self:request_redraw(true)
end

function TextEditor:lmb_hold()
	local mse_at = self:create_crs_at_mse()
	if self.held_crs and not self.held_crs:matches(mse_at) then
		self.content.crs = mse_at
		self.content.selection = create_selection(self.content.crs, self.held_crs)
	elseif self.held_crs then
		self.content.crs = mse_at
		self.content.selection = nil
	end
	self:fix_hold()
	self:request_redraw(true)
end

function TextEditor:lmb_release()
--	self.held_crs = nil
	self.autocomplete = nil
	self:request_redraw(true)
	
	if self.highlight_syntax and key("ctrl") then
		local mse_at = self:create_crs_at_mse()
	
		local token_at_pos, context = mse_at:get_ln():get_token_at_pos(
			mse_at.xpos,
			self.func_descs,
			self.user_funcs
		)
		
		if token_at_pos and context == 4 then
			token_at_pos = sub(token_at_pos,2,#token_at_pos-1)
			
			local path = self.content:get_fullpath(token_at_pos)
			
			if path and fstat(path) == "file" then
				open(path)
			end
		end
	end
end

function TextEditor:mmb_release()
--	self.held_crs = nil
	self.autocomplete = nil
	self:request_redraw(true)
	
	if self.highlight_syntax then
		local mse_at = self:create_crs_at_mse()
	
		local token_at_pos, context = mse_at:get_ln():get_token_at_pos(
			mse_at.xpos,
			self.func_descs,
			self.user_funcs
		)
		
		if token_at_pos and context == 4 then
			token_at_pos = sub(token_at_pos,2,#token_at_pos-1)
			
			local path = self.content:get_fullpath(token_at_pos)
			
			if path and fstat(path) == "file" then
				open(path)
			end
		end
	end
end

function TextEditor:lmb_click_double()
	get_mouse_listener():set_pointer(text_ed_cursor)
	local mse_at = self:create_crs_at_mse()
	select_token(mse_at,self)
	self.held_crs = nil
	self.autocomplete = nil
	self:request_redraw(true)
end

function TextEditor:lmb_click_triple()
	get_mouse_listener():set_pointer(text_ed_cursor)
	local mse_at = self:create_crs_at_mse()
	self.content.crs:move_to(#self.content.crs:get_ln().text+1)
	local start = self.content.crs:copy()
	start:move_to(self.content.crs:get_ln():get_indent()+1)
	self.content.selection = create_selection(start,self.content.crs)
	self.held_crs = nil
	self.autocomplete = nil
	self:request_redraw(true)
end

function TextEditor:mouse_scroll()
	self:update_scroll()
end

function TextEditor:hover()
	get_mouse_listener():set_pointer(text_ed_cursor)
	local mse_at = self:create_crs_at_mse()
	
	if self.highlight_syntax then
		local token_at_pos, context = mse_at:get_ln():get_token_at_pos(
			mse_at.xpos,
			self.func_descs,
			self.user_funcs
		)
		if self.content.err and mse_at.ln_n == self.content.err.ln_n and self.content.err.tkn == token_at_pos then
			self:show_tooltip{text={self.content.err.msg}}
		elseif token_at_pos and context == CON_BASE_FUNC then
			self:show_tooltip(self.func_descs[token_at_pos])
		elseif token_at_pos and context == CON_USER_FUNC then
			for _,lkp in pairs(self.user_funcs) do
				if lkp[token_at_pos] then
					self:show_tooltip(lkp[token_at_pos])
					break
				end
			end
		elseif token_at_pos and context == 4 and sub(token_at_pos,1,1)=="\"" then
			local file = nil
			
			local fp = sub(token_at_pos,2,#token_at_pos-1)
			local path = self.content:get_fullpath(fp)
			
			if self.file_previews and path and fstat(path) == "file" then
				local cur_tooltip = self:get_gui().tooltip
				
				if cur_tooltip and cur_tooltip.title == fp then
					self:show_tooltip()
					return
				end
			
				file = fetch(path)
				local unpd = unpod(file)
				if (unpd) file = unpd
				if type(file) == "string" then
					local lns = split(file,"\n",false)
					local lns_to_show={}
					for i = 1,min(#lns,10) do
						add(lns_to_show,lns[i])
					end
					self:show_tooltip(
						{
							title=fp,
							text=lns_to_show,
							w=256,
							code=path:ext()=="lua"
						}
					)
				elseif type(file) == "table" and path:ext() == "gfx" then
					self:show_tooltip(
						{
							title=fp,
							spritesheet=file,
						}
					)
				elseif type(file) == "table" then
					local lns = {}
					local light = self:get_theme_colour("light")
					local text_col = self:get_theme_colour("basic_text")
					
					if light >= 10 then
						light = chr(light+87)
					end
					
					if text_col >= 10 then
						text_col = chr(text_col+87)
					end
					
					for k,v in pairs(file) do
						add(lns,"\f"..light..tostr(k)..": ".."\f"..text_col..tostr(v))
						if #lns >= 10 then
							break
						end
					end
					self:show_tooltip(
						{
							title=fp,
							text=lns,
						}
					)
				end
			elseif self.string_previews then
				local out = nil
				local formatted, err = load("return "..token_at_pos)
				if formatted and type(formatted) == "function" then
					formatted = formatted()
					if formatted then
						self:show_tooltip(
							{
								text={tostr(formatted)},
							}
						)
					end
				end
			end
--			elseif token_at_pos then
--				self:show_tooltip({title=token_at_pos})
		end
	end
end

--[[GROUP:find/replace]]

function TextEditor:perform_find()
	local to_find = self.find_textbox:get_text()
	
	if #to_find == 0 then
		return
	end
	
	local found = self.content:find(to_find)
	if #found == 0 then
		notify("Could not find '"..to_find.."'.")
	else
		local sel = found[1]
		for _,option in pairs(found) do
			local ln_n = option:get_start().ln_n
			local xpos = option:get_start().xpos
			if (
				ln_n > self.content.crs.ln_n or
				(ln_n == self.content.crs.ln_n and xpos > self.content.crs.xpos)
			) then
				sel = option
				break
			end
		end
		local nd = sel:get_end()
		self.content.crs:move_to(nd.xpos,nd.ln_n)
		self.content.selection = create_selection(
			sel:get_start(),
			self.content.crs
		)
		self:jump_to_cursor()
		self:request_redraw(true)
	end
end

function TextEditor:perform_replace()
	local to_find = self.find_textbox:get_text()
	local to_replace = self.replace_textbox:get_text()
	
	if #to_find == 0 then
		return
	end
	
	if self.content.selection then
		local cur_selection = self.content.selection:get_text()
		if cur_selection == to_find then
			self.content.selection:delete()
			self.content.crs=self.content.selection:get_start()
			self.content.selection=nil
			
			local ln = self.content.crs:get_ln()
			local st, nd = sub(ln.text,0,self.content.crs.xpos-1), sub(ln.text,self.content.crs.xpos,#ln.text)
		
			self.content:replace_line_content(self.content.crs.ln_n,st..to_replace..nd)
			self.content.crs:right(#to_replace[1])
		end
	end
	
	self:perform_find()
end

--[[GROUP:update]]

function TextEditor:update()
	self.parent:request_redraw(true)

	local theme = self:get_theme()

	sel_coltab = userdata("u8",64,64)
	sel_coltab:peek(0x8000,0,64*64)
	
	self.ln_n_width = 4*max(2,#tostr(#self.content.lns))+3
	
	for i = 0,31 do
		if i != theme.bg then
			sel_coltab:set(i,theme.te_selection,theme.bg)
		end
	end

	while self.single_line and #self.content.lns > 1 do
		self.content:delete_ln(2)
	end

	local mse=get_mouse_listener()
	
--	if self.search_drawer then
--		self.search_drawer.pos = vec(self.w-self.search_drawer.w-10,self.h-self.search_drawer.h)
--		self.ln_drawer.pos = vec(self.w-self.ln_drawer.w-30,self.h-self.ln_drawer.h)
--	end
	
--	self.bookmark_drawer.pos = vec(self.w-self.bookmark_drawer.w,self.bookmark_top)
	
	self:update_bookmarks()
	self:update_todos()
	
	self.content:update(self.since_inp)
	
	self.user_funcs[self.content.id] = self.content.user_funcs or {}
	
	self.since_inp += 1
	
	if self.word_wrap and not self.highlight_syntax then
		self.scroll_target.x = 0
	end
	
--	local mse_at
--
--	if mse:is_in({pos=self:get_pos(),w=self.w,h=self.h}) then
--		
--	end
	
	local prev_scroll = self.scroll.pos
	if self.smooth_scroll then
		self.scroll:update(self.scroll_target)
		self.scroll.x = flr(self.scroll.x)
		self.scroll.y = max(0,self.scroll.y)
	else
		self.scroll.x, self.scroll.y = self.scroll_target.x, self.scroll_target.y
		self.scroll.pos = vec(self.scroll.x, self.scroll.y)
	end
	
	if flr(self.scroll.x) != flr(prev_scroll.x) or flr(self.scroll.y) != flr(prev_scroll.y) then
		self:request_redraw(true)
		self.ln_at_top, self.top_offset = unpack(self:binary_search_top_ln())
		for el in all(self.elems) do
			if el.special_typ == "sticker" then
				el.offset = vec(self.scroll.x,self.scroll.y)*-1
			end
		end
--		self.scrollbar:update_thumb()
	end
	
	self.content_w, self.content_h = self:get_content_size()
	if self.scrollbar then
		self.scrollbar:update_thumb()
	end
	
	if self.searchable then
		if key("ctrl") and keyp("f") then
			open_find(self)
		elseif key("ctrl") and keyp("g") then
			self:perform_find()
		elseif key("ctrl") and keyp("h") then
			self:perform_replace()
		elseif key("ctrl") and keyp("l") then
			if self.ln_drawer._open then
				self.ln_drawer:close()
				self:set_focus()
			else
				self.search_drawer:close()
				self.ln_drawer:open()
				self.goto_textbox.content:replace_line_content(1,"")
				self.goto_textbox:set_focus()
			end
		end
	end

	if not self:has_focus() then return end
	
	if self.dynamic_height then
		local h = min(self.max_height,self.content_h)
		if h != self.h then
			self:update_dims{h=h}
		end
	end
	
	update_keyb_input(self)
		
	if self.since_inp == 30 and self.highlight_syntax and self.enable_autocomplete then
		self.autocomplete, self.auto_filled=get_autocomp_list(self)
--		notify("Create autocomp "..tostr(self.autocomplete))
--		self.autocomp_pos = 1
		self:request_redraw(true)
	end
end

function TextEditor:update_bookmarks()
	if self.content.bookmarks != self.bookmarks then
		remove_bookmarks(self)
		self.bookmarks = self.content.bookmarks
		set_bookmarks(self,self.bookmarks)
	end
end

function TextEditor:update_todos()
	if self.content.todos != self.todos then
		remove_todos(self)
		self.todos = self.content.todos
		set_todos(self,self.todos)
	end
end

function TextEditor:update_scroll()
	local mse = get_mouse_listener()
	if key("ctrl") and (not self.word_wrap or self.highlight_syntax) then
		if mse.scroll.y > 0 then
			self.scroll_target.x -= 30
			self.scroll_target.x = max(0,self.scroll_target.x)
--				btn_prssd(self)
		elseif mse.scroll.y < 0 then
			self.scroll_target.x += 30
--				btn_prssd(self)
		end
	else
		if mse.scroll.y > 0 then
			self.scroll_target.y -= 33
--				btn_prssd(self)
		elseif mse.scroll.y < 0 then
			self.scroll_target.y += 33
--				btn_prssd(self)
		end
		if mse.scroll.x < 0 then
			self.scroll_target.x -= 30
			
--				btn_prssd(self)
		elseif mse.scroll.x > 0 then
			self.scroll_target.x += 30
--				btn_prssd(self)
		end
	end
	if self.content_w < self.w*0.8 then
		self.scroll_target.x = 0
	else
		self.scroll_target.x = max(0,self.scroll_target.x)
	
		self.scroll_target.x=mid(self.scroll_target.x,0,max(0,self.content_w-self.w+min(self.w/2,100)))
	end

	if self.content_h < self.h*0.8 then
		self.scroll_target.y = 0
	end
--	self.scroll_target.x=mid(self.scroll_target.x,0,max(0,self.content_w-self.w+min(self.w,100)))
	self.scroll_target.y=mid(self.scroll_target.y,0,max(0,self.content_h-self.h+50))
end

function TextEditor:update_user_funcs(funcs,id)
	self.user_funcs[id] = funcs
end

--[[GROUP:draw]]

function TextEditor:request_redraw(full,origin)
	if origin == nil then
		origin = self
	end
	
	if origin == self then
		self.redraw_needed = true
	else
		self.child_requested_redraw = true
	end
	
	if self.parent then
		self.parent:request_redraw(full,origin)
	end
end

function TextEditor:draw_all()
	local origin = self.canv_pos
	local theme = self:get_theme()
	local bg_col = theme[self.bg_col]
	
	self:clip()

	self.just_refreshed = false
	if not self.redraw_needed and self.screen_area and not self.changed_width and not self.changed_height then
		self.redraw_needed = false
		self.child_requested_redraw = false
		
		self.screen_area:blit(get_draw_target(),0,0,origin.x,origin.y)
		self:draw_cursor(origin)
		if self.since_inp > 1 then
			if self.content.line_refresh_needed and (not self.corefresh or costatus(self.corefresh) == "dead") then
				self.corefresh = cocreate(refresh_content)
				self:request_redraw(true)
			elseif self.corefresh and costatus(self.corefresh) == "dead" then
				self.corefresh = nil
				self:request_redraw(true)
				self.just_refreshed = true
			elseif self.corefresh and costatus(self.corefresh) != "dead" then
				local w = self.w-2*self.l_pad
				if self.show_ln_ns then
					w-= self.ln_n_width
				end
				if self.scrollbar then
					w-=self.scrollbar.w
				end
				if self.bookmark_drawer._open and self.bookmarks and #self.bookmarks > 0 then
					w-=self.bookmark_drawer.w
				end
				if self.max_line_len then
					w=min(w,self.max_line_len*5-2*self.l_pad)
				end
				assert(coresume(
					self.corefresh,
					self.content,
					{
						syntax = self.highlight_syntax,
						word_wrap = self.word_wrap,
						width = w,
						bg_col = bg_col,
						theme = theme,
						word_wrap=self.word_wrap,
						focused=self.changed_width,
						highlight_syntax=self.highlight_syntax,
						func_descs=self.func_descs,
						user_funcs=self.user_funcs,
						rainbow_brackets=self.rainbow_brackets
					}
				))
			end
		end
	else
		self:draw()
		self.redraw_needed = false
		self.child_requested_redraw = false
	end
	
	for _,el in pairs(self.elems) do
		el:draw_all()
	end
end

function TextEditor:draw()
	local origin = self.canv_pos
	local theme = self:get_theme()
	local bg_col = theme[self.bg_col]

	self.lx, self.ly = nil, nil

	local pdt = get_draw_target()

	self.screen_area = userdata("u8",self.w,self.h)
	
--	
--	self.screen_area += bg_col
	
	set_draw_target(self.screen_area)
	clip()
--	local pos = self:get_pos()

	rectfill(0,0,self.w-1,self.h-1,bg_col)

	local sel_start_ln, sel_end_ln = -1, -1
	local sel_start_x, sel_end_x = -1, -1
	
	if self.content.selection then
		local st, nd = self.content.selection:get_start(), self.content.selection:get_end()
		sel_start_ln = st.ln_n
		sel_start_x = st.xpos
		sel_end_ln = nd.ln_n
		sel_end_x = nd.xpos
	end

	local i = self.ln_at_top
	local y = self.t_pad+self.top_offset
	
	while y < self.h and i <= #self.content.lns do
		local crs_pos = nil
		if i == self.content.crs.ln_n then
			crs_pos=self.content.crs.xpos
		end
		
		local cs_start, cs_end = -1, -1
		if sel_start_ln <= i and sel_end_ln >= i then
			if sel_start_ln == i then
				cs_start = sel_start_x
			else
				cs_start = 1
			end
			if sel_end_ln == i then
				cs_end = sel_end_x
			else
				cs_end = #self.content.lns[i].text+1
			end
		end
	
		local x = self.l_pad-self.scroll.x
		
		local w = self.w-2*self.l_pad
		if self.show_ln_ns then
			x+= self.ln_n_width
			w-= self.ln_n_width
		end
		if self.scrollbar then
			w-=self.scrollbar.w
		end
		if self.bookmark_drawer._open and self.bookmarks and #self.bookmarks > 0 then
			w-=self.bookmark_drawer.w
		end
		if self.max_line_len then
			w=min(w,self.max_line_len*5-2*self.l_pad)
		end
		if (self.monospace) then
			x-=self.l_pad
			x=print("	",x,-1000)
		end
		
		local err_tkn
		if self.content.err and self.content.err.ln_n == i then
			err_tkn = self.content.err.tkn
		end
		
		local clx, cly = self.content.lns[i]:print{
			pos = vec(x,y),
			bg_col = bg_col,
			theme = theme,
			crs_xpos = crs_pos,
			sel_start_x = cs_start,
			sel_end_x = cs_end,
			word_wrap=self.word_wrap,
			w=w,
			focused=self.changed_width,
			highlight_syntax=self.highlight_syntax,
			func_descs=self.func_descs,
			user_funcs=self.user_funcs,
			err_tkn = err_tkn,
			rainbow_brackets=self.rainbow_brackets
		}
		
		if clx then
			self.lx = clx
			self.ly = cly
		end
		
		y+=self.content.lns[i].h
		i+=1
	end
	
	self.changed_width = false
	self.changed_height = false
	
	if self.max_line_len then
		local x=self.max_line_len*5+self.l_pad-self.scroll.x
		if self.show_ln_ns then x+= self.ln_n_width end
		fillp(
			0b00000000,
			0b00000000,
			0b11111111,
			0b11111111,
			0b00000000,
			0b00000000,
			0b11111111,
			0b11111111
		)
		poke(0x550b,0x3f)
		line(x,0,x,self.h,theme["middle"])
		poke(0x550b,0x00)
		fillp()
	end
	
	if self.show_ln_ns then
		rectfill(0,0,self.ln_n_width-1,self.h,theme["middle"])
		local i = self.ln_at_top
		local y = self.t_pad+self.top_offset
		
		while i <= #self.content.lns and y+self.content.lns[i].h < 0 do
			y+=self.content.lns[i].h
			i+=1
		end
		
		local ln_n_hc = self:get_theme_colour(self.ln_n_highlight_col)
		
		while y < self.h and i <= #self.content.lns do
			poke(0x5f58,0x81)
			if i == self.content.crs.ln_n then
				pal(7,ln_n_hc)
			else
				pal(7,bg_col)
			end
			
			local ln_n = tostr(i)
			
			print(ln_n,(max(2,#tostr(#self.content.lns))-#ln_n)*4+2,y,7)
				
			pal(7,7)
			poke(0x5f58,0x00)
			y+=self.content.lns[i].h
			i+=1
		end
	end
	
	
	
	if self.autocomplete and self.lx and self.ly then
		local y = self.ly+12
		local w = 0
		local x = self.lx
		
		for _,itm in pairs(self.autocomplete) do
			w=max(#itm*5+16,w)
		end
		
		local st = max(1,self.autocomp_pos-2)
		local nd = min(#self.autocomplete,max(self.autocomp_pos+2,5))
	
		if #self.autocomplete <= 7 then
			st = 1
			nd = #self.autocomplete
		end
	
		local h = (nd-st+1)*10+4
		
		y=mid(0,y,self.h-h)
		x=mid(0,x,self.w-w-2)
		
		if st > 1 then h+=10 end
		if nd < #self.autocomplete then h+=10 end
		if st == 1 and nd < #self.autocomplete then
			h+=10
			nd+=1
		end
		
		rectfill(x,y-2,x+w-1,y+h-5,theme["bg"])
		line(x,y-3,x+w-1,y-3,theme["middle"])
		line(x,y+h-5,x+w-1,y+h-5,theme["middle"])
		fillp(
			0b11111111,
			0b00000000,
			0b11111111,
			0b11111111,
			0b11111111,
			0b00000000,
			0b11111111,
			0b11111111
		)
		poke(0x550b,0x3f)
		line(x,y-2,x,y+h-5,theme["middle"])
		line(x+w-1,y-2,x+w-1,y+h-5,theme["middle"])
		fillp()
		poke(0x550b,0x00)
		
		pal(7,theme["middle"])
		spr(35,x+w-7,y)
		pal(7,7)
		
		if st > 1 then
			print("...",x+3,y,theme["middle"])
			y+=10
		end
		for i = st,nd do
			local col = theme["middle"]
			if self.autocomp_pos == i then
				col = theme["light"]
			end
			print(self.autocomplete[i],x+3,y,col)
			y+=10
		end
		if nd < #self.autocomplete then
			print("...",x+3,y,theme["middle"])
		end
	end

	set_draw_target(pdt)
	self.screen_area:blit(get_draw_target(),0,0,origin.x,origin.y)
	self:clip()
	self:draw_cursor(origin)
end

function TextEditor:draw_cursor(origin)
	if (
		self:has_focus() and 
		self.lx and
		flr(t()*3)%2 == 1 and
		(not self.show_ln_ns or 
			(self.lx > self.ln_n_width and self.lx < self.w)
		)
	) then
		line(origin.x+self.lx-1,origin.y+self.ly-1,origin.x+self.lx-1,origin.y+self.ly+7,self:get_theme_colour("te_cursor"))
	end
end

--[[GROUP]]


function init_tokenizer()
	KEYWORD_COLS = {}
	for kwd in all(KEYWORDS) do
		KEYWORD_COLS[kwd]="te_keyword"
	end
	for kwd in all(NUMBER_WORDS) do
		KEYWORD_COLS[kwd]="te_number"
	end
	OPEN_SCOPE_LKP = {}
	for kwd in all(OPEN_SCOPE_TKNS) do
		OPEN_SCOPE_LKP[kwd]=true
	end
	CLOSE_SCOPE_LKP = {}
	for kwd in all(CLOSE_SCOPE_TKNS) do
		CLOSE_SCOPE_LKP[kwd]=true
	end
	
	te_func_descs = fetch("lib/xi_gui/data/func_defs.pod")
	
--	local func_defs = load_json_file("lib/xi_gui/data/func_defs.json")
--	
--	te_func_descs = {}
--	
--	for name,def in pairs(func_defs) do
--		add_te_func(name,def.title,wrap_lines(def.text,50))
--	end
--	
--	store("lib/xi_gui/data/func_defs.pod",te_func_descs)
end

end

:: lib/xi_gui/text_ed/input.lua
--[[pod_format="raw",created="2025-03-27 09:00:44",modified="2025-08-31 08:48:17",revision=18236,xstickers={}]]
function update_keyb_input(e)
	if key("ctrl") and key("shift") then
		for k,f in pairs(CTRL_SHIFT_KEYS) do
			if keyp(k) then
				f(e)
				if not no_changing_key(k) then
					btn_prssd(e)
				end
				return
			end
		end
		return
	elseif key("ctrl") then
		for k,f in pairs(CTRL_KEYS) do
			if keyp(k) then
				local has_ac = e.autocomplete != nil
				f(e)
				if k!="z" and k!="y" and not no_changing_key(k) then
					btn_prssd(e)
				end
				if k=="right" and has_ac then
					e.since_inp = 30
				end
				return
			end
		end
		return
	elseif key("alt") then
		for k,f in pairs(ALT_KEYS) do
			if keyp(k) then
				f(e)
				btn_prssd(e)
				return
			end
		end
	else
		if key("shift") then
			for k,f in pairs(SHIFT_KEYS) do
				if keyp(k) then
					f(e)
					if not no_changing_key(k) then
						btn_prssd(e)
					end
					return
				end
			end
		end
		for k,f in pairs(SPECIAL_KEYS) do
			if keyp(k) then
				f(e)
				if not no_changing_key(k) then
					btn_prssd(e)
				end
				return
			end
		end
	end

	local k = ""
	while peektext() do
		k = k..readtext()
	end
	
	if #k > 0 then
		btn_prssd(e)

		if e.content.selection then
			e.content.selection:delete()
			e.content.crs=e.content.selection:get_start()
			e.content.selection=nil
		end
		
		local ln = e.content.crs:get_ln()
		local st, nd = sub(ln.text,0,e.content.crs.xpos-1), sub(ln.text,e.content.crs.xpos,#ln.text)
	
		e.content:replace_line_content(e.content.crs.ln_n,st..k..nd)
		e.content.crs:right(#k)
	end
end

function no_changing_key(k)
	for _,comp_key in pairs({
		"up",
		"down",
		"left",
		"right",
		"home",
		"end",
		"pagedown",
		"pageup"
	}) do
		if k == comp_key then
			return true
		end
	end
	return false
end

function btn_prssd(e)
	e.content.line_refresh_needed=true
	non_changing_btn_press(e)
end

function non_changing_btn_press(e)
	e.since_inp=0
	e.autocomplete=nil
	e.autocomp_pos=1
	e:request_redraw(true)
	e:jump_to_cursor()
end

function press_del(e)
	if e.content.selection then
		e.content.selection:delete()
		e.content.crs=e.content.selection:get_start()
		e.content.selection=nil
	else
		local ln = e.content.crs:get_ln()
		local st, nd = sub(ln.text,0,e.content.crs.xpos-1), sub(ln.text,e.content.crs.xpos,#ln.text)
	
		if e.content.crs.xpos <= #ln.text then
			e.content:replace_line_content(e.content.crs.ln_n,st..sub(nd,2,#nd))
		elseif ln.next then
			e.content:replace_line_content(e.content.crs.ln_n,ln.text..ln.next.text)
			e.content:delete_line(e.content.crs.ln_n+1)
		end
	end
end

function press_enter(e)
	if e.enter_callback then
		e:enter_callback()
		return
	end

	if e.content.selection then
		e.content.selection:delete()
		e.content.crs=e.content.selection:get_start()
		e.content.selection=nil
	end
	
	if e.single_line then
		return
	end
	
	local ln = e.content.crs:get_ln()
	local st, nd = sub(ln.text,0,e.content.crs.xpos-1), sub(ln.text,e.content.crs.xpos,#ln.text)

	e.content:replace_line_content(e.content.crs.ln_n,st)
	
	local ni = ln:get_indent()

	for i=1,ni do
		nd="	"..nd
	end

	e.content:add_line(e.content.crs.ln_n+1,nd)
	e.content.crs:move_to(ni+1,e.content.crs.ln_n+1)
end

function press_shift_enter(e)
	if e.enter_callback then
		e:enter_callback()
		return
	end

	if e.content.selection then
		e.content.selection:delete()
		e.content.crs=e.content.selection:get_start()
		e.content.selection=nil
	end
	
	if e.single_line then
		return
	end
	
	local ln = e.content.crs:get_ln()
	local block_end = ln:get_block_end()
	
	if e.content.crs.xpos != #ln.text+1 or not block_end then
		press_enter(e)
		return
	end

	local tabs = ""
	for _ = 1,ln:get_indent() do
		tabs = tabs.."	"
	end
	e.content:add_line(e.content.crs.ln_n+1,tabs.."	")
	e.content:add_line(e.content.crs.ln_n+2,tabs..block_end)
	e.content.crs:move_to(#e.content.lns[e.content.crs.ln_n+1].text+1,e.content.crs.ln_n+1)
end

function press_backspace(e)
	if e.content.selection then
		e.content.selection:delete()
		e.content.crs=e.content.selection:get_start()
		e.content.selection=nil
	else
		local ln = e.content.crs:get_ln()
		local st, nd = sub(ln.text,0,e.content.crs.xpos-1), sub(ln.text,e.content.crs.xpos,#ln.text)
	
		if e.content.crs.xpos > 1 then
			e.content:replace_line_content(e.content.crs.ln_n,sub(st,0,#st-1)..nd)
			e.content.crs:left(1,e.word_wrap)
		elseif ln.prev then
			e.content.crs:move_to(#e.content.lns[e.content.crs.ln_n-1].text+1,e.content.crs.ln_n-1)
			e.content:replace_line_content(e.content.crs.ln_n,ln.prev.text..ln.text)
			e.content:delete_line(e.content.crs.ln_n+1)
		end
	end
end

function press_tab(e)
	if e.tab_callback then
		e:tab_callback()
		return
	end

	if e.content.selection then
		local st, nd = e.content.selection:get_start(), e.content.selection:get_end()
		for l=st.ln_n,nd.ln_n do
			local ln = e.content.lns[l]
			e.content:replace_line_content(l,"	"..ln.text)	
		end
		st:right(1,e.word_wrap)
		nd:right(1,e.word_wrap)
		return
	elseif e.autocomplete and e.autocomp_pos > 0 then
		local to_add = sub(e.autocomplete[e.autocomp_pos],#e.auto_filled+1,#e.autocomplete[e.autocomp_pos])
	
		local ln = e.content.crs:get_ln()
		local st, nd = sub(ln.text,0,e.content.crs.xpos-1), sub(ln.text,e.content.crs.xpos,#ln.text)
	
		e.content:replace_line_content(e.content.crs.ln_n,st..to_add..nd)
		e.content.crs:right(#to_add,e.word_wrap)
		return
	end
	local ln = e.content.crs:get_ln()
	local st, nd = sub(ln.text,0,e.content.crs.xpos-1), sub(ln.text,e.content.crs.xpos,#ln.text)

	e.content:replace_line_content(e.content.crs.ln_n,st.."	"..nd)
	e.content.crs:right(1,e.word_wrap)
end

function unindent(e)
	local st, nd = e.content.crs, e.content.crs
	if e.content.selection then
		st, nd = e.content.selection:get_start(), e.content.selection:get_end()
	end
	for l=st.ln_n,nd.ln_n do
		local ln = e.content.lns[l]
		if sub(ln.text,1,1) == "	" then
			e.content:replace_line_content(l,sub(ln.text,2))
			if l == st.ln_n then
				st:left(1,e.word_wrap)
			end
			if l == nd.ln_n and st!=nd then
				nd:left(1,e.word_wrap)
			end
		end
	end
end

function comment_lines(e)
	local st, nd = e.content.crs, e.content.crs
	local remove_comment = false
	if e.content.selection then
		st, nd = e.content.selection:get_start(), e.content.selection:get_end()
	end
	if sub(st:get_ln().text,1,2) == "--" then
		remove_comment = true
	end
	
	for i=st.ln_n,nd.ln_n do
		if remove_comment and sub(e.content.lns[i].text,1,2) == "--" then
			e.content:replace_line_content(i,sub(e.content.lns[i].text,3,#e.content.lns[i].text))
			if st != nd and i == nd.ln_n then
				nd:left(2)
			end
		elseif not remove_comment and sub(e.content.lns[i].text,1,2) != "--" then
			e.content:replace_line_content(i,"--"..e.content.lns[i].text)
			if st != nd and i == nd.ln_n then
				nd:right(2)
			end
		end
	end
	if remove_comment then
		st:left(2)
	else
		st:right(2)
	end
	
end

function block_comment_lines(e)
	if not e.content.selection then
		return
	end 
	local st, nd = e.content.selection:get_start(), e.content.selection:get_end()
	local stln = st:get_ln()
	local ndln = nd:get_ln()
	
	if sub(stln.text,st.xpos-4,st.xpos-1) == "--[[" and sub(ndln.text,nd.xpos,nd.xpos+1) == "]]" then
		e.content:replace_line_content(st.ln_n,sub(stln.text,0,st.xpos-5)..sub(stln.text,st.xpos,#stln.text))
		if st.ln_n==nd.ln_n then
			nd:left(4,e.word_wrap)
		end
		st:left(4,e.word_wrap)
		e.content:replace_line_content(nd.ln_n,sub(ndln.text,0,nd.xpos-1)..sub(ndln.text,nd.xpos+2,#ndln.text))
	else
		e.content:replace_line_content(st.ln_n,sub(stln.text,0,st.xpos-1).."--[["..sub(stln.text,st.xpos,#stln.text))
		if st.ln_n==nd.ln_n then
			nd:right(4,e.word_wrap)
		end
		st:right(4,e.word_wrap)
		e.content:replace_line_content(nd.ln_n,sub(ndln.text,0,nd.xpos-1).."]]"..sub(ndln.text,nd.xpos,#ndln.text))
	end
end

function press_copy(e)
	if not e.content.selection then
		return
	end
	local st, nd = e.content.selection:get_start(), e.content.selection:get_end()
	
	if st.ln_n == nd.ln_n then
		local txt = sub(st:get_ln().text,st.xpos,nd.xpos-1)
		set_clipboard(txt)
	else
		local txt = ""
		for l = st.ln_n,nd.ln_n do
			if l==st.ln_n then
				txt = sub(st:get_ln().text,st.xpos,#st:get_ln().text).."\n"
			elseif l==nd.ln_n then
				txt = txt..sub(nd:get_ln().text,0,nd.xpos-1)
			else
				txt = txt..e.content.lns[l].text.."\n"
			end
		end
		set_clipboard(txt)
	end
end

function press_cut(e)
	if not e.content.selection then
		return
	end
	local st, nd = e.content.selection:get_start(), e.content.selection:get_end()
	
	if st.ln_n == nd.ln_n then
		local txt = sub(st:get_ln().text,st.xpos,nd.xpos-1)
		set_clipboard(txt)
	else
		local txt = ""
		for l = st.ln_n,nd.ln_n do
			if l==st.ln_n then
				txt = sub(st:get_ln().text,st.xpos,#st:get_ln().text).."\n"
			elseif l==nd.ln_n then
				txt = txt..sub(nd:get_ln().text,0,nd.xpos-1)
			else
				txt = txt..e.content.lns[l].text.."\n"
			end
		end
		set_clipboard(txt)
	end
	e.content.selection:delete()
	e.content.crs=e.content.selection:get_start()
	e.content.selection=nil
end

function press_paste(e)
	if e.content.selection then
		e.content.selection:delete()
		e.content.crs=e.content.selection:get_start()
		e.content.selection=nil
	end
	local txt = split(get_clipboard(),"\n",false)
	local ln = e.content.crs:get_ln()
	local st, nd = sub(ln.text,0,e.content.crs.xpos-1), sub(ln.text,e.content.crs.xpos,#ln.text)

	if #txt == 1 then
		e.content:replace_line_content(e.content.crs.ln_n,st..txt[1]..nd)
		e.content.crs:right(#txt[1])
	else
		for i,ltxt in ipairs(txt) do
			if i == 1 then
				e.content:replace_line_content(e.content.crs.ln_n,st..ltxt)
			elseif i == #txt then
				e.content:add_line(e.content.crs.ln_n+i-1,ltxt..nd)
				e.content.crs:move_to(#ltxt+1,e.content.crs.ln_n+i-1)
			else
				e.content:add_line(e.content.crs.ln_n+i-1,ltxt)
			end
		end
		
	end
end

function press_ctrl_right(e)
	if not e.autocomplete or e.autocomp_pos < 1 then
		return
	end
	
	local to_add = e.autocomplete[e.autocomp_pos][#e.auto_filled+1]
	local ln = e.content.crs:get_ln()
	local st, nd = sub(ln.text,0,e.content.crs.xpos-1), sub(ln.text,e.content.crs.xpos,#ln.text)
	
	e.content:replace_line_content(e.content.crs.ln_n,st..to_add..nd)
	e.content.crs:right(1,e.word_wrap)
end

--[[GROUP:home/end]]

function press_home(e)
	e.content.selection = nil
	e.content.crs:move_to(1)
	non_changing_btn_press(e)
end

function press_end(e)
	e.content.selection = nil
	e.content.crs:move_to(#e.content.crs:get_ln().text+1)
	non_changing_btn_press(e)
end

function press_shift_home(e)
	if not e.content.selection then
		e.content.selection = create_selection(e.content.crs:copy(),e.content.crs)
	end
	e.content.crs:move_to(1)
	if e.content.selection.c1:matches(e.content.selection.c2) then
		e.content.selection = nil
	end
	non_changing_btn_press(e)
end

function press_shift_end(e)
	if not e.content.selection then
		e.content.selection = create_selection(e.content.crs:copy(),e.content.crs)
	end
	e.content.crs:move_to(#e.content.crs:get_ln().text+1)
	if e.content.selection.c1:matches(e.content.selection.c2) then
		e.content.selection = nil
	end
	non_changing_btn_press(e)
end

function press_ctrl_home(e)
	e.content.selection = nil
	e.content.crs:move_to(1,1)
	non_changing_btn_press(e)
end

function press_ctrl_end(e)
	e.content.selection = nil
	e.content.crs:move_to(#e.content.lns[#e.content.lns].text,#e.content.lns)
	non_changing_btn_press(e)
end

function press_ctrl_shift_home(e)
	if not e.content.selection then
		e.content.selection = create_selection(e.content.crs:copy(),e.content.crs)
	end
	e.content.crs:move_to(1,1)
	if e.content.selection.c1:matches(e.content.selection.c2) then
		e.content.selection = nil
	end
	non_changing_btn_press(e)
end

function press_ctrl_shift_end(e)
	if not e.content.selection then
		e.content.selection = create_selection(e.content.crs:copy(),e.content.crs)
	end
	e.content.crs:move_to(#e.content.lns[#e.content.lns].text,#e.content.lns)
	if e.content.selection.c1:matches(e.content.selection.c2) then
		e.content.selection = nil
	end
	non_changing_btn_press(e)
end

--[[GROUP:pageup/down]]

function press_pagedown(e)
	e.content.selection = nil
	e.content.crs:down(20,e.word_wrap)
	non_changing_btn_press(e)
end

function press_pageup(e)
	e.content.selection = nil
	e.content.crs:up(20,e.word_wrap)
	non_changing_btn_press(e)
end

function press_shift_pagedown(e)
	if not e.content.selection then
		e.content.selection = create_selection(e.content.crs:copy(),e.content.crs)
	end
	e.content.crs:down(20,e.word_wrap)
	if e.content.selection.c1:matches(e.content.selection.c2) then
		e.content.selection = nil
	end
	non_changing_btn_press(e)
end

function press_shift_pageup(e)
	if not e.content.selection then
		e.content.selection = create_selection(e.content.crs:copy(),e.content.crs)
	end
	e.content.crs:up(20,e.word_wrap)
	if e.content.selection.c1:matches(e.content.selection.c2) then
		e.content.selection = nil
	end
	non_changing_btn_press(e)
end

function press_ctrl_pagedown(e)
	e.content.selection = nil
	local ln_n = e.content.crs.ln_n
	local best_ln = nil
	for _,fd in pairs(e.content.user_funcs or {}) do
		if fd.ln_n > ln_n and (not best_ln or fd.ln_n < best_ln) then
			best_ln = fd.ln_n
		end
	end
	if (not best_ln) return
	e.content.crs:move_to(1,best_ln)
	e.content.crs:move_to(#e.content.crs:get_ln().text+1)
	non_changing_btn_press(e)
	e.scroll_target.y = e.content.crs:get_ln().btm-20
end

function press_ctrl_pageup(e)
	e.content.selection = nil
	local ln_n = e.content.crs.ln_n
	local best_ln = nil
	for _,fd in pairs(e.content.user_funcs or {}) do
		if fd.ln_n < ln_n and (not best_ln or fd.ln_n > best_ln) then
			best_ln = fd.ln_n
		end
	end
	if (not best_ln) return
	e.content.crs:move_to(1,best_ln)
	e.content.crs:move_to(#e.content.crs:get_ln().text+1)
	non_changing_btn_press(e)
	e.scroll_target.y = e.content.crs:get_ln().btm-20
end

--[[GROUP:cursor]]

function press_left(e)
	e.content.selection = nil
	e.content.crs:left(1,e.word_wrap)
	non_changing_btn_press(e)
end

function press_right(e)
	e.content.selection = nil
	e.content.crs:right(1,e.word_wrap)
	non_changing_btn_press(e)
end

function press_up(e)
	e.content.selection = nil
	if e.autocomplete == nil then
		e.content.crs:up(1,e.word_wrap)
		non_changing_btn_press(e)
	else
		if e.autocomp_pos > 0 then
			e.autocomp_pos-=1
			e:request_redraw(true)
		else
			e.content.crs:up(1,e.word_wrap)
			non_changing_btn_press(e)
		end
	end
end

function press_down(e)
	e.content.selection = nil
	if e.autocomplete == nil then
		e.content.crs:down(1,e.word_wrap)
		non_changing_btn_press(e)
	else
		e.autocomp_pos = min(e.autocomp_pos+1,#e.autocomplete)
		e:request_redraw(true)
	end
end

function press_shift_left(e)
	if not e.content.selection then
		e.content.selection = create_selection(e.content.crs:copy(),e.content.crs)
	end
	e.content.crs:left(1,e.word_wrap)
	if e.content.selection.c1:matches(e.content.selection.c2) then
		e.content.selection = nil
	end
	non_changing_btn_press(e)
end

function press_shift_right(e)
	if not e.content.selection then
		e.content.selection = create_selection(e.content.crs:copy(),e.content.crs)
	end
	e.content.crs:right(1,e.word_wrap)
	if e.content.selection.c1:matches(e.content.selection.c2) then
		e.content.selection = nil
	end
	non_changing_btn_press(e)
end

function press_shift_down(e)
	if not e.content.selection then
		e.content.selection = create_selection(e.content.crs:copy(),e.content.crs)
	end
	e.content.crs:down(1,e.word_wrap)
	if e.content.selection.c1:matches(e.content.selection.c2) then
		e.content.selection = nil
	end
	non_changing_btn_press(e)
end

function press_shift_up(e)
	if not e.content.selection then
		e.content.selection = create_selection(e.content.crs:copy(),e.content.crs)
	end
	e.content.crs:up(1,e.word_wrap)
	if e.content.selection.c1:matches(e.content.selection.c2) then
		e.content.selection = nil
	end
	non_changing_btn_press(e)
end

function press_ctrl_left(e)
	local txt = e.content.crs:get_ln().text
	
	e.content.selection = nil
	if e.content.crs.xpos <= 1 then
		e.content.crs:left(1,e.word_wrap)
	else
		while (
			e.content.crs.xpos-1 > 1 and 
			get_char_type(txt[e.content.crs.xpos-1]) == 1
		) do
			e.content.crs:left(1,e.word_wrap)
		end
		local base_type = get_char_type(txt[e.content.crs.xpos-1])
		while (
			e.content.crs.xpos-1 >= 1 and (
				get_char_type(txt[e.content.crs.xpos-1]) == base_type or
				get_char_type(txt[e.content.crs.xpos]) == 1
			)
		) do
			e.content.crs:left(1,e.word_wrap)
		end
	end
	non_changing_btn_press(e)
end

function press_ctrl_right(e)
	local txt = e.content.crs:get_ln().text
	e.content.selection = nil
	
	if e.content.crs.xpos >= #txt+1 then
		e.content.crs:right(1,e.word_wrap)
	else
		while (
			e.content.crs.xpos < #txt+1 and 
			get_char_type(txt[e.content.crs.xpos]) == 1
		) do
			e.content.crs:right(1,e.word_wrap)
		end
		local base_type = get_char_type(txt[e.content.crs.xpos])
		while (
			e.content.crs.xpos < #txt+1 and (
				get_char_type(txt[e.content.crs.xpos]) == base_type
			)
		) do
			e.content.crs:right(1,e.word_wrap)
		end
	end
	non_changing_btn_press(e)
end

function press_ctrl_shift_left(e)
	local txt = e.content.crs:get_ln().text
	
	if not e.content.selection then
		e.content.selection = create_selection(e.content.crs:copy(),e.content.crs)
	end
	if e.content.crs.xpos <= 1 then
		e.content.crs:left(1,e.word_wrap)
	else
		while (
			e.content.crs.xpos-1 > 1 and 
			get_char_type(txt[e.content.crs.xpos-1]) == 1
		) do
			e.content.crs:left(1,e.word_wrap)
		end
		local base_type = get_char_type(txt[e.content.crs.xpos-1])
		while (
			e.content.crs.xpos-1 >= 1 and (
				get_char_type(txt[e.content.crs.xpos-1]) == base_type or
				get_char_type(txt[e.content.crs.xpos]) == 1
			)
		) do
			e.content.crs:left(1,e.word_wrap)
		end
	end
	if e.content.selection.c1:matches(e.content.selection.c2) then
		e.content.selection = nil
	end
	non_changing_btn_press(e)
end

function press_ctrl_shift_right(e)
	local txt = e.content.crs:get_ln().text
	
	if not e.content.selection then
		e.content.selection = create_selection(e.content.crs:copy(),e.content.crs)
	end
	
	if e.content.crs.xpos >= #txt+1 then
		e.content.crs:right(1,e.word_wrap)
	else
		while (
			e.content.crs.xpos < #txt+1 and 
			get_char_type(txt[e.content.crs.xpos]) == 1
		) do
			e.content.crs:right(1,e.word_wrap)
		end
		local base_type = get_char_type(txt[e.content.crs.xpos])
		while (
			e.content.crs.xpos < #txt+1 and (
				get_char_type(txt[e.content.crs.xpos]) == base_type
			)
		) do
			e.content.crs:right(1,e.word_wrap)
		end
	end
	if e.content.selection.c1:matches(e.content.selection.c2) then
		e.content.selection = nil
	end
	non_changing_btn_press(e)
end

--[[GROUP:line manip]]

function duplicate_lines(e)
	local st, nd = e.content.crs, e.content.crs
	if e.content.selection then
		st, nd = e.content.selection:get_start(), e.content.selection:get_end()
	end
	
	for i = 0,nd.ln_n-st.ln_n do
		local ln_n = nd.ln_n-i
		local text = e.content.lns[ln_n].text
		e.content:add_line(nd.ln_n+1, text)
	end
	local n_lines = nd.ln_n-st.ln_n+1
	st:down(n_lines)
	if st!=nd then
		nd:down(n_lines)
	end
end

function shift_line_down(e)
	local st, nd = e.content.crs, e.content.crs
	if e.content.selection then
		st, nd = e.content.selection:get_start(), e.content.selection:get_end()
	end
	
	for i = 0,nd.ln_n-st.ln_n do
		local ln_n = st.ln_n
		local text = e.content.lns[ln_n].text
		e.content:delete_line(ln_n)
		e.content:add_line(nd.ln_n+1, text)
	end
	st:down(1)
	if st!=nd then
		nd:down(1)
	end
end

function shift_line_up(e)
	local st, nd = e.content.crs, e.content.crs
	if e.content.selection then
		st, nd = e.content.selection:get_start(), e.content.selection:get_end()
	end
	
	for i = 0,nd.ln_n-st.ln_n do
		local ln_n = st.ln_n+i
		local text = e.content.lns[ln_n].text
		e.content:delete_line(ln_n)
		e.content:add_line(st.ln_n-1+i, text)
	end
	st:up(1)
	if st!=nd then
		nd:up(1)
	end
end

function select_all(e)
	e.content.crs:move_to(#e.content.lns[#e.content.lns].text+1,#e.content.lns)
	e.content.selection = create_selection(e.content.crs,create_cursor(e.content,1,1))
end

--[[GROUP:undo/redo]]

function press_undo(e)
	e.content.undo_stacks:undo()
	e:jump_to_cursor()
end

function press_redo(e)
	e.content.undo_stacks:redo()
	e:jump_to_cursor()
end

--[[GROUP:find]]

function open_find(e)
	if not e.searchable then
		return
	end

	if e.search_drawer._open then
		e.search_drawer:close()
		e:set_focus()
	else
		e.search_drawer:open()
		e.ln_drawer:close()
		if e.content.selection then
			e.find_textbox.content:replace_line_content(1,e.content.selection:get_text(true))
			e.find_textbox.content.crs:move_to(#e.find_textbox.content.lns[1].text+1)
			e.find_textbox.content.selection = create_selection(
				create_cursor(e.find_textbox.content,1,1),
				e.find_textbox.content.crs
			)
		end
		e.find_textbox:set_focus()
	end
end

--[[BOOKMARK:Key defs]]

SPECIAL_KEYS = {
	delete = press_del,
	enter = press_enter,
	backspace = press_backspace,
	tab = press_tab,
	up = press_up,
	down = press_down,
	left = press_left,
	right = press_right,
	home = press_home,
	["end"] = press_end,
	pagedown = press_pagedown,
	pageup = press_pageup,
}

CTRL_KEYS = {
	a = select_all,
	b = comment_lines,
	d = duplicate_lines,
	c = press_copy,
	insert = press_copy,
	v = press_paste,
	x = press_cut,
	right = press_ctrl_right,
	z = press_undo,
	y = press_redo,
	home = press_ctrl_home,
	["end"] = press_ctrl_end,
	left = press_ctrl_left,
	right = press_ctrl_right,
	w = press_home, -- pressing staWt (I guess in Boston?)
	e = press_end,
	pagedown = press_ctrl_pagedown,
	pageup = press_ctrl_pageup,
}

CTRL_SHIFT_KEYS = {
	b = block_comment_lines,
	home = press_ctrl_shift_home,
	["end"] = press_ctrl_shift_end, 
	left = press_ctrl_shift_left,
	right = press_ctrl_shift_right,
}

SHIFT_KEYS = {
	tab = unindent,
	down = press_shift_down,
	up = press_shift_up,
	right = press_shift_right,
	left = press_shift_left,
	home = press_shift_home,
	["end"] = press_shift_end,
	pagedown = press_shift_pagedown,
	pageup = press_shift_pageup,
	delete = press_cut,
	insert = press_paste,
	enter = press_shift_enter,
}

ALT_KEYS = {
	down = shift_line_down,
	up = shift_line_up,
}

:: lib/xi_gui/text_ed/selection.lua
--[[pod_format="raw",created="2025-03-28 13:04:38",modified="2025-05-27 14:53:22",revision=1913,xstickers={}]]
tes = [[f=fetch("/appdata")
]]

function create_selection(c1,c2)
	local s = {
		c1 = c1,
		c2 = c2,
		get_start = get_first_crs,
		get_end = get_last_crs,
		delete = delete_selection,
		get_text = get_selection_text,
	}
	return s
end

function get_first_crs(s)
	if s.c1.ln_n < s.c2.ln_n then
		return s.c1
	elseif s.c2.ln_n < s.c1.ln_n then
		return s.c2
	elseif s.c1.xpos < s.c2.xpos then
		return s.c1
	else
		return s.c2
	end
end

function get_last_crs(s)
	if s.c1.ln_n < s.c2.ln_n then
		return s.c2
	elseif s.c2.ln_n < s.c1.ln_n then
		return s.c1
	elseif s.c1.xpos < s.c2.xpos then
		return s.c2
	else
		return s.c1
	end
end

function delete_selection(s)
	local st, nd = s:get_start(), s:get_end()
	local new_text = sub(st:get_ln().text,0,st.xpos-1) .. sub(nd:get_ln().text,nd.xpos,#nd:get_ln().text)
	st.content:replace_line_content(st.ln_n,new_text)
	for _ = st.ln_n+1,nd.ln_n do
		st.content:delete_line(st.ln_n+1)
	end
end

-- Get the text from inside the selection.
function get_selection_text(s, just_one_line)
	local st, nd = s:get_start(), s:get_end()
	if st.ln_n == nd.ln_n then
		return sub(st:get_ln().text,st.xpos,nd.xpos-1)
	elseif just_one_line then
		return sub(st:get_ln().text,st.xpos)
	else
		local text = sub(st:get_ln().text,st.xpos).."\n"
		for ln_n = st.ln_n+1,nd.ln_n-1 do
			text = st.content.lns[ln_n].text.."\n"
		end
		text = text..sub(nd:get_ln().text,1,nd.xpos-1)
		return text
	end
end

:: lib/xi_gui/text_ed/stickers.lua
--[[pod_format="raw",created="2025-05-25 17:27:58",modified="2025-05-27 12:11:05",revision=968,xstickers={}]]
do

Sticker = create_class(XiGuiElem,Draggable)

STICKERS = fetch("gfx/stickers.gfx")

function Sticker:_init(attribs)
	self.special_typ = "sticker"
	
	local sprite = STICKERS[attribs.idx].bmp
	local mask = sprite:min(1)*5
	
	self:apply_defaults{
		sprite=sprite,
		mask=mask,
		w=sprite:width()+1,
		h=sprite:height()+1,
--		z=10,
	}
	
	self.held = false
end

function Sticker:draw()
	local pos = self.canv_pos
	if self.hide then return end
	
	if self:get_theme_colour("bg") == 7 then
		pal(30,1)
	else
		pal(30,7)
	end
	if self.dragged then
		spr(self.mask,pos.x+1,pos.y+1)
		spr(self.sprite,pos.x,pos.y)
	else
		spr(self.sprite,pos.x+1,pos.y+1)
	end
	pal(30,30)
end

function Sticker:lmb_click()
	Draggable.lmb_click(self)
	
	del(self.ln.stickers,self)
end

function Sticker:lmb_release()
	Draggable.lmb_release(self)
	
	local crs = self.te:create_crs_at_mse()
	local ln = crs:get_ln()
	
	self.ln = ln
	
	self.off = vec(self.pos.x+self.te.scroll.x,self.pos.y+self.te.scroll.y-self.ln.btm)
	
	if self.offset then
		self.off += self.offset
	end

	add(self.ln.stickers,self)
end

function Sticker:rmb_release()
	del(self.ln.stickers,self)
	del(self.te.content.stickers,self)
	self:remove()
end

end

do

StickerBtn = create_class(_Btn)

function StickerBtn:_init(attribs)
	-- Required attributes:
	-- sprite: sprite to display
	-- callback: function to call when button
	-- 	is pressed. No arguments are
	-- 	passed to the funciton.
	-- Optional attributes:
	-- pos: vec containing position on screen
	--	     relative to parent
	-- w, h: width, height
	-- bg_col, hover_col, click_col:
	-- 	colour names
	-- v_pad, h_pad: padding around icon
	-- selected: true, false or function
	
	assert(attribs.sprite, "No sprite provided when creating text button.")
	assert(attribs.callback, "No callback provided when creating text button.")
	
	local s = attribs.sprite
	if type(s) != "userdata" then
		s = get_spr(s)
	end
	
	local spr_w, spr_h = s:attribs()
	local h_pad = attribs.h_pad or 0
	local v_pad = attribs.v_pad or 0
	
	self:apply_defaults{
		w=spr_w+2*h_pad,
		h=spr_h+2*v_pad,
		disabled_icon_col="middle",
		h_pad=0,
		v_pad=0,
		sprite_bg_col=1
	}
end

function StickerBtn:draw()
	local pos = self.canv_pos
	local cur_col = self:get_theme_colour(self.cur_col)
	pal(self.sprite_bg_col,cur_col)
	if self.enabled then
--		pal(cur_col,self:get_theme_colour("bg"))
	else
		pal(7,self:get_theme_colour(self.disabled_icon_col))
	end
	spr(self.sprite, pos.x+self.h_pad, pos.y+self.v_pad)
--	pal(cur_col,cur_col)
	pal(self.sprite_bg_col,self.sprite_bg_col)
	pal(7,7)
end

function StickerBtn:hover()
	_Btn.hover(self)
	Mouse:set_pointer("grab")
end

function StickerBtn:lmb_click()
	self.cur_col = self.click_col

	self:callback()
end

end


:: lib/xi_gui/text_ed/text_line.lua
--[[pod_format="raw",created="2025-03-28 12:21:43",modified="2025-08-16 09:00:02",revision=72041,xstickers={}]]
do

CON_FUNC_DEF = 101
CON_BASE_FUNC = 102
CON_USER_FUNC = 103
CON_TABLE_DOT = 104
CON_FUNC_DEF_VARS = 105
CON_LOCAL_VAR_DEF = 106

CAT_COLS = {
	[0]="te_space",
	"basic_text",
	"te_number",
	"te_comment",
	"te_string",
	"te_special",
	[101] = "te_special",
	[102] = "te_base_func",
	[103] = "te_user_func",
	[104] = "te_special",
	[105] = "te_func_var",
	[106] = "te_local_var",
}

BRACKET_COLS = {
	8,
	9,
	11,
	12,
	30
}

BRACKET_MATCH = {
	[")"] = "(",
	["]"] = "[",
	["}"] = "{",
}

MULTILINE_COLS={[3]="te_comment",[4]="te_string"}
KEYWORDS = {"and", "break", "do", "else", "elseif", "end", "for", "function", "if", "in", "local", "not", "or", "repeat", "return", "then", "until", "while"}
NUMBER_WORDS = {"true","false","nil"}
OPEN_SCOPE_TKNS = {"then","do","else","function","repeat"}
CLOSE_SCOPE_TKNS = {"until","end","else","elseif"}

local orig_coltab = userdata("u8",64,64)
orig_coltab:peek(0x8000,0,64*64)

TextLine = create_class()

function TextLine:_init(attribs)
	self.text=attribs.text
	self.prev=attribs.prev
	self.next=attribs.next
	self.top=attribs.top or 10
	self.btm=attribs.btm or 0
	self.h = 10
	self.end_bracket_state=""
	self.last_token_state=0
	self.stickers={}
end

function TextLine:get_initial_state()
	if self.prev then return self.prev.last_token_state
	else return 0
	end
end

function TextLine:get_initial_bracket()
	if self.prev then return self.prev.end_bracket_state or ""
	else return ""
	end
end
	
function split_next_line(text,width)
	local guess = min(width//5+5, #text)
	
	local cur_x = print(sub(text,1,guess),0,-1000)
	
	while cur_x > width do
		guess -= 1
		while guess > 1 and text[guess] != " " do
			guess-=1
		end
		cur_x = print(sub(text,1,guess),0,-1000)
	end
	
	return sub(text,1,guess), sub(text,guess+1)
end

word_lengths = {}

function TextLine:wrap_lines(width)
	local text = self.text
	local words = split(text," ",false)
	
	width+=5
	
	self.wrapped_lines={}
	local cur_line=""
	local cur_line_len = 0
	
	for i = 1,#words do
		local cw = words[i].." "

		if not word_lengths[cw] then
			word_lengths[cw] = print(cw,0,-1000)
		end
		
		local length = word_lengths[cw]
		
		if cur_line_len + length > width then
			local nl = TextLine{text=sub(cur_line,1,#cur_line-1)}
			add(
				self.wrapped_lines,
				nl
			)
			cur_line = cw
			cur_line_len = length
		else
			cur_line = cur_line..cw
			cur_line_len+=length
		end
		
--		local new_line = cur_line.." "..words[i]
--		local nx = #new_line*5
--		if nx > width or (nx*1.2 > width and print(new_line,0,-1000) > width) then
--			add(self.wrapped_lines,create_text_line(cur_line))
--			cur_line=words[i]
--		else
--			cur_line=new_line
--		end
	end

	if #cur_line > 0 then
		local nl = TextLine{text=sub(cur_line,1,#cur_line-1)}
		add(
			self.wrapped_lines,
			nl
		)
	end
	
	self.h=#self.wrapped_lines*10
end

function TextLine:refresh(lvars,args)
	local pos = 1
	local text =self.text
	local token_state = self:get_initial_state()
--	local func_def = false
--	local local_def = false
--	local func_def_vars = false
	local defined_func=nil
	local defined_group=nil
	local defined_locals = {}
	local defined_func_vars = {}
	local openned, closed = 0, 0
	local bracket_state = self:get_initial_bracket()
	local txt_elems = {}
	local context = 1
	local cost = 0
	local includ = false
	local todo = nil

	local cols = {
		sel = args.theme.te_selection,
		base_func = args.theme.te_base_func,
		user_func = args.theme.te_user_func,
		bg = args.theme.bg,
		curs = args.theme.te_cursor,
	}

	while (pos <= #text) do
		local str, pos1, cat, col, bracket_col
		str, pos1, cat, token_state = tokenoid(text, pos, token_state)
		cost += 0.1
		
		if (not str) assert(false)
		
		if cat == 1 and OPEN_SCOPE_LKP[str] then
			openned+=1
			add(lvars,{})
		end
		if cat == 1 and CLOSE_SCOPE_LKP[str] then
			closed+=1
			if #lvars > 1 then
				deli(lvars,#lvars)
			end
		end
	
		if cat == 1 then
			if str == "function" then
				context = CON_FUNC_DEF
			elseif (str == "local" or str == "for") then
				context = CON_LOCAL_VAR_DEF
			elseif str == "include" then
				includ = true
				context = cat
			elseif context == CON_FUNC_DEF then
				if defined_func then
					defined_group = defined_func
				end
				defined_func = str
			elseif (
				context == CON_LOCAL_VAR_DEF and 
				cat == 1 and 
				str == "in" 
			) then
				context = cat
			elseif context == CON_LOCAL_VAR_DEF then
--				add(defined_locals,str)
				lvars[#lvars][str]="te_local_var"
			elseif context == CON_FUNC_DEF_VARS then
--				add(defined_func_vars,str)
				lvars[#lvars][str]="te_func_var"
			else
				context = cat
			end
		elseif cat == 5 then
			if str == "(" or str == "{" or str == "[" then
				bracket_state = bracket_state..str
				bracket_col = BRACKET_COLS[(#bracket_state-1)%#BRACKET_COLS+1]
			elseif str == ")" or str == "}" or str == "]" then
				if (
					#bracket_state > 0 and 
					BRACKET_MATCH[str] == bracket_state[#bracket_state]
				) then
					bracket_col = BRACKET_COLS[(#bracket_state-1)%#BRACKET_COLS+1]
					bracket_state = sub(bracket_state,1,#bracket_state-1)
				end
			end
			
			if context == CON_FUNC_DEF and str == "(" then
				context = CON_FUNC_DEF_VARS
			elseif str == "=" and context == CON_LOCAL_VAR_DEF then
				context = cat
			elseif str == ")" and context == CON_FUNC_DEF_VARS then
				context = cat
			elseif context == CON_LOCAL_VAR_DEF then
				context = CON_LOCAL_VAR_DEF
			elseif context == CON_FUNC_DEF_VARS then
				context = CON_FUNC_DEF_VARS
			elseif context == CON_FUNC_DEF then
				context = CON_FUNC_DEF
			else
				context = cat
			end
		elseif includ and cat == 4 then
			self.included_file = sub(str,2,#str-1)
			includ = false
		elseif (
			context == CON_LOCAL_VAR_DEF and 
			cat == 1 and 
			str == "in"
		) then
			context = cat
		elseif context == CON_LOCAL_VAR_DEF then
			context = CON_LOCAL_VAR_DEF
		elseif context == CON_FUNC_DEF_VARS then
			context = CON_FUNC_DEF_VARS
		elseif context == CON_FUNC_DEF then
			context = CON_FUNC_DEF
		else
			context = cat
		end
		
		if cat == 3 then
			local p1 = string.find(str,"TODO:")
			
			if p1 then
--				assert(false,tostr(p1))
				p1+=5
				while text[p1] == " " do
					p1+=1
				end
				todo = sub(str,p1)
				if (#todo == 0) todo = nil
			end
		end
		
		local col = args.theme[
			MULTILINE_COLS[cat] or 
			KEYWORD_COLS[str] or 
			CAT_COLS[context]
		]

		if args.rainbow_brackets and bracket_col then
			col = bracket_col
		elseif context == 1 and args.func_descs[str] then
			col = cols.base_func
		elseif context == 3 and string.find(str,"TODO:") then
			col = args.theme["todo_text"]
		elseif context == CON_FUNC_DEF_VARS and cat != 1 then
			col = args.theme[CAT_COLS[cat]]
		elseif context == CON_LOCAL_VAR_DEF and cat != 1 then
			col = args.theme[CAT_COLS[cat]]
		elseif context == 1 then
			for lst in all(lvars) do
				if lst[str] then
					col = args.theme[lst[str]]
					break
				end
			end
			for _,ufds in pairs(args.user_funcs) do
				if ufds[str] then
					col = cols.user_func
					break
				end
			end
		end
		
		col = col or 0
		
		if col >= 10 then
			col = chr(col+87)
		end
		
		add(txt_elems,"\f"..col..str)
		
		pos = pos1
	end
	
--	pos = 1
--	token_state = self:get_initial_state()
--	
--	while (pos <= #self.text) do
--		local str, pos1, cat
--		str, pos1, cat, token_state = tokenoid(self.text, pos, token_state)
--		
--		if cat == 1 and str == "function" then
--			context = CON_FUNC_DEF
--		elseif context == 1 and str == "local" then
--			context = CON_FUNC_DEF
--		elseif context == CON_FUNC_DEF and str == "(" then
--			context = CON_FUNC_DEF_VARS
--		elseif context == CON_FUNC_DEF then
--			context = CON_FUNC_DEF
--		elseif context == CON_FUNC_DEF_VARS and str == ")" then
--			context = cat
--		elseif context == CON_FUNC_DEF_VARS then
--			context = CON_FUNC_DEF_VARS
--		else
--			context = cat
--		end
		
--
--		
--		pos = pos1
--	end
	
	self.highlighted = table.concat(txt_elems,"")
	
	self:text_refresh(false,0)
	
	if token_state != nil then
		self.last_token_state=token_state
	else
		self.last_token_state=0
	end
	self.end_bracket_state = bracket_state
	self.lvars = pod(lvars)
	self.todo = todo

	return {
		func_declared=defined_func,
		group_declared=defined_group,
		locals_declared=defined_locals,
		fvars_declared=defined_func_vars,
		openned_scope=openned,
		closed_scope=closed,
		cost=cost,
	}
end

function TextLine:text_refresh(word_wrap,width)
	self.last_token_state= 0
	
	local unp 
	if sub(self.text,1,7) == "--[[pod" then
		unp = unpod(self.text)
	end
	
	if word_wrap and type(unp) == "userdata" then
		self.wrapped_lines={self}
		self.h=max(unp:height(),10)
	elseif word_wrap then
		self:wrap_lines(width)
	elseif type(unp) == "userdata" then
		self.wrapped_lines = nil
		self.h=max(unp:height(),10)
	else
		self.wrapped_lines = nil
		self.h=10
	end
end

function TextLine:get_token_at_pos(target_pos,func_descs,user_funcs)
	local token_state = self:get_initial_state()
	local pos = 1
	local out = ""
	local context = 1
	
	local r
	if sub(self.text,1,7) == "--[[pod" then
		r = unpod(self.text)
	end
	
	if type(r) == "userdata" then
		return nil,nil
	end
	
	while (pos <= #self.text) do
		local str, pos1, cat
		str, pos1, cat, token_state = tokenoid(self.text, pos, token_state)
		
		if cat == 1 and str == "function" then
			context = CON_FUNC_DEF
		elseif context == CON_FUNC_DEF and str!="(" then
			context = CON_FUNC_DEF
		else
			context = cat
		end
		
		if context == 1 and func_descs[str] then
			context = CON_BASE_FUNC
		end
		for _,ufds in pairs(user_funcs) do
			if context == 1 and ufds[str] then
				context = CON_USER_FUNC
			end
		end
	
		if pos <= target_pos and pos1 > target_pos then
			return str, context
		end
	
		pos = pos1
	end
	
	return nil, nil
end

function TextLine:get_indent()
	local i = 0
	for c in all(self.text) do
		if c == "	" then
			i+=1
		else
			return i
		end
	end
	return i
end

function TextLine:get_block_end()
	local pos = 1
	local token_state = 0
	local block_ends = {
		["function"] = "end",
		["then"] = "end",
		["do"] = "end",
		["else"] = "end",
		["repeat"] = "until",
	}

	while (pos <= #self.text) do
		local str, pos1, cat
		str, pos1, cat, token_state = tokenoid(self.text, pos, token_state)
		
		if cat == 1 and block_ends[str] then
			return block_ends[str]
		end
		
		pos = pos1
	end
	
	return nil
end

--[[GROUP:print]]

function TextLine:print(args)
	if args.word_wrap and not args.highlight_syntax and (self.wrapped_lines == nil or args.focused) then
		self:wrap_lines(args.w)
	end
	
--	for _,sticker in pairs(self.stickers) do
--		sticker:update_dims{pos=sticker.off+vec(0,self.btm)}
--	end

	local unpd
	if sub(self.text,1,7) == "--[[pod" then
		unpd = unpod(self.text)
	end
	if type(unpd) == "userdata" then
		self.h = max(unpd:height(),10)
		if self.prev then
			self.end_bracket_state = self.prev.end_bracket_state
		end
		if args.crs_xpos == nil then
			spr(unpd,args.pos.x,args.pos.y)
			return nil, nil
		else
			return self:print_code(args)
		end
	elseif args.highlight_syntax then
		self.h=10
		return self:print_code(args)
	elseif args.word_wrap then
		return self:print_wrapped(args)
	else
		self.h=10
		return self:print_basic(args)
	end
end

function TextLine:print_code(args)
	local init_stat = self:get_initial_state()

	if not self.highlighted then
		self:refresh(
			unpod(self.lvars) or {{["self"]="te_func_var"}},args
		)
	end

	if (args.crs_xpos == nil) args.crs_xpos = -1
	if (args.sel_start_x == nil) args.sel_start_x = -1
	local out = ""
	local lx = nil
	local x, y = args.pos.x, args.pos.y
	
	local cols = {
		sel = args.theme.te_selection,
		base_func = args.theme.te_base_func,
		user_func = args.theme.te_user_func,
		bg = args.theme.bg,
		curs = args.theme.te_cursor,
	}
	
	if args.sel_start_x > 0 and #self.text == 0 then
		rectfill(x,y-1,x+2,y+7,cols.sel)
	end
	
	print(self.highlighted,x,y)
	
	if args.crs_xpos > 0 then
		lx = print(sub(self.text,0,args.crs_xpos-1),x,-1000)
	end
	
	if args.sel_start_x > 0 and args.sel_start_x != args.sel_end_x and #self.text > 0 then
		sel_coltab:poke(0x8000)
		poke(0x550b,0x3f)
		
		local sx = print(sub(self.text,0,args.sel_start_x-1),x,-1000)
		local ex = print(sub(self.text,0,args.sel_end_x-1),x,-1000)
		rectfill(sx,y-1,ex-2,y+7,args.theme.te_selection)
		orig_coltab:poke(0x8000)
		poke(0x550b,0x00)
	end
	
	if args.err_tkn then
		poke(0x550b,0x3f)
		fillp(
			0b01010101,
			0b10101010,
			0b01010101,
			0b10101010,
			0b01010101,
			0b10101010,
			0b01010101,
			0b10101010
		)
		local st, nd = string.find(self.text,args.err_tkn,1,true)
		while st and nd do
			local sx = print(sub(self.text,0,st-1),x,-1000)
			local ex = print(sub(self.text,0,nd),x,-1000)
			rectfill(sx,y+7,ex,y+8,24)
			st, nd = string.find(self.text,args.err_tkn, nd+1,1,true)
		end
		fillp()
		poke(0x550b,0x00)
	end
	
--	if args.crs_xpos > #self.text then
--		lx=x
--	end
	
	return lx, y
end

function TextLine:print_basic(args)
	if args.crs_xpos == nil then args.crs_xpos = -1 end
	local pos = 1
	local text = self.text
	local lx = nil
	local x,y = args.pos.x, args.pos.y
	
	if args.sel_start_x > 0 and #text == 0 then
		rectfill(x,args.pos.y-1,args.pos.x+2,args.pos.y+7,args.theme.te_selection)
	end
	
	print(text,x,y,args.theme.basic_text)
	
	if args.sel_start_x > 0 and args.sel_start_x != args.sel_end_x and #self.text > 0 then
		sel_coltab:poke(0x8000)
		poke(0x550b,0x3f)
		
		local sx = print(sub(self.text,0,args.sel_start_x-1),x,-1000)
		local ex = print(sub(self.text,0,args.sel_end_x-1),x,-1000)
		rectfill(sx,y-1,ex-2,y+7,args.theme.te_selection)
		orig_coltab:poke(0x8000)
		poke(0x550b,0x00)
	end
	
	if args.crs_xpos > 0 then
		lx = print(sub(self.text,0,args.crs_xpos-1),x,-1000)
	end
	
--	if args.sel_start_x > 0 and #text == 0 then
--		rectfill(x,args.pos.y-1,args.pos.x+2,args.pos.y+7,args.theme.te_selection)
--	elseif args.sel_start_x > 0 then
--		local a, b, c = sub(text,0,args.sel_start_x-1), sub(text,args.sel_start_x,args.sel_end_x-1), sub(text,args.sel_end_x,#text)
--		x = print(a,x,y,args.theme.basic_text)
--		if args.crs_xpos == args.sel_start_x then lx = x end
--		local ex = print(b,x,y,args.theme.basic_text)
--		rectfill(x,y-1,ex-1,y+7,args.theme.te_selection)
--		x = print(b,x,y,args.theme.bg)
--		if args.crs_xpos == args.sel_end_x then lx = x end
--		x = print(c,x,y,args.theme.basic_text)
--	elseif args.crs_xpos > 0 and args.crs_xpos <= #text+1 then
--		local a, b = sub(text,0,args.crs_xpos-1), sub(text,args.crs_xpos)
--		lx = print(a,x,y,args.theme.basic_text)
--		x = print(text,x,y,args.theme.basic_text)
--	else
--		print(text,x,y,args.theme.basic_text)
--	end
	
	return lx, y
end

function TextLine:print_wrapped(args)
	if args.crs_xpos == nil then args.crs_xpos = -1 end
	local crs_xpos = args.crs_xpos
	local sel_start_x = args.sel_start_x
	local sel_end_x = args.sel_end_x
	local pos = 1
	
	local lx, ly = nil
	local clx, cly = nil, nil
	local x,y = args.pos.x, args.pos.y
	local cx = 1
	
	args.word_wrap=false
	local tot_len=0
	
	self.h=#self.wrapped_lines*10
	
	if args.sel_start_x > 0 and #self.text == 0 then
		rectfill(x,y-1,x+2,y+7,args.theme.te_selection)
	end
	
	for ln in all(self.wrapped_lines) do
		
--		if crs_xpos >= tot_len and crs_xpos < next_len then
--			args.crs_xpos = 
--		end
		args.crs_xpos = crs_xpos-tot_len
		if sel_start_x > 0 then
			args.sel_start_x = mid(sel_start_x-tot_len,1,#ln.text+1)
		end
		if sel_end_x > 0 then
			args.sel_end_x = mid(sel_end_x-tot_len,1,#ln.text+1)
		end
		if args.sel_start_x == args.sel_end_x then
			args.sel_start_x, args.sel_end_x = -1,-1
		end
		tot_len+=#ln.text+1
		clx, cly = ln:print_basic(args)
		if clx then
			lx, ly = clx, cly
		end
		args.pos.y+=10
	end
	
	return lx, ly
end

--[[GROUP:create]]

function create_text_lines(text)
	local raw_lns = split(text,"\n",false)
	local lns = {}
	local prev_ln = nil
	local y = 0
	for l in all(raw_lns) do
		local new_ln = TextLine{text=l,prev=prev_ln,btm=y,top=y+10}
		if prev_ln then prev_ln.next = new_ln end
		prev_ln = new_ln
		add(lns,new_ln)
		y+=10
	end
	
	if #lns == 0 then
		add(lns,TextLine{text=""})
	end
	
	return lns
end

end

:: lib/xi_gui/text_ed/todo.lua
--[[pod_format="raw",created="2025-05-25 14:58:21",modified="2025-05-27 11:08:57",revision=319,xstickers={}]]
do

local incomp_spr=(
--[[pod_type="gfx"]]unpod("b64:bHo0ABIAAAAQAAAA8AFweHUAQyAFBQRXIBcgFyBX")
)
local comp_spr=(
--[[pod_type="gfx"]]unpod("b64:bHo0ABYAAAAUAAAA8AVweHUAQyAFBQRXAAcAJwAnAAcAVw==")
)

local cross_spr=(
--[[pod_type="gfx"]]unpod("b64:bHo0ABwAAAAaAAAA8AtweHUAQyAFBQQHIAcABwAHIAcgBwAHAAcgBw==")
)

ToDoGroup = create_class(Canvas)

function ToDoGroup:_init(attribs)
	assert(attribs.todos, "No todos provided when creating group.")

	local h = max(7,#attribs.todos*7) + 7

	self:apply_defaults{
		w_func=full_width(7),
		h=h,
--		bg_col="middle",
		title_col="light",
		text_col="bg",
		hover_col="light",
		highlight_col="highlight",
	}
	
	if (attribs.bg_col == nil) self.bg_col="middle"

end

function ToDoGroup:hover()
	local mse = get_mouse_listener()
	local pos = self.abs_pos
	local prev_hovered = self.hovered
	local over_check = self.over_check
	local over_cross = self.over_cross
	
	self.hovered = (mse.pos.y-pos.y-1)//7
	
	self.over_check=mse.pos.x-pos.x < 10
	self.over_cross=mse.pos.x-pos.x > 89
	
	if self.hovered >= 1 then
		mse:set_pointer("pointer")
	end
	
	if self.hovered != prev_hovered or
		self.over_check != over_check or
		self.over_cross != over_cross
	then
		self:request_redraw(true)
	end
end

function ToDoGroup:end_hover()
	self.hovered=nil
	self.over_check=false
	self.over_cross=false
	self:request_redraw(true)
end

function ToDoGroup:lmb_release()
	local b = self.todos[self.hovered]
	
	if not b or b.ln_n > #self.te.content.lns then return end
	
	self.te.held_crs = nil
	self.te.autocomplete = nil
	self.te:request_redraw(true)
	if self.over_check and not b.complete then
		self.te.content:replace_line_content(
			b.ln_n,
			self.te.content.lns[b.ln_n].text.." COMPLETE"
		)
	elseif self.over_check then
		self.te.content:replace_line_content(
			b.ln_n,
			sub(self.te.content.lns[b.ln_n].text,1,#self.te.content.lns[b.ln_n].text-9)
		)
	elseif self.over_cross then
		self.te.content:delete_line(b.ln_n)
	else
		self.te.scroll_target.y = self.te.content.lns[b.ln_n].btm-20
		self.te.content.crs:move_to(1,b.ln_n)
		self.te.content.selection=nil
	end
	
	self:request_redraw(true)
end

function ToDoGroup:draw()
	local pos = self.canv_pos
	if pos.y > get_display():height() then
		return
	end

	rectfill(
		pos.x,pos.y,
		pos.x+self.w-1,pos.y+self.h-1,
		self:get_theme_colour(self.bg_col)
	)
	if self.hovered and self.hovered >= 1 then
		local i = self.hovered
		rectfill(
			pos.x,pos.y+7*i,
			pos.x+self.w-1,pos.y+7*i+6,
			self:get_theme_colour(self.hover_col)
		)
	end
	
	local y = pos.y+1
	local text_col = self:get_theme_colour(self.text_col)
	local highlight_col = self:get_theme_colour(self.highlight_col)
	
	print("\014tOdO:",pos.x+2,y,self:get_theme_colour(self.title_col))
	y+=7
	
	for i,b in pairs(self.todos) do
		local title = b.text:lower()
		
		if y > get_display():height() then
			return
		end
		
		if #title > 20 then
			title=sub(title,1,19)..">"
		end
--		title=title..#title
		if self.over_check and i == self.hovered then
			pal(7,highlight_col)
		else
			pal(7,text_col)
		end
		if b.complete then
			spr(comp_spr,pos.x+2,y)
		else
			spr(incomp_spr,pos.x+2,y)
		end
		
		if self.over_cross and i == self.hovered  then
			pal(7,highlight_col)
		else
			pal(7,text_col)
		end
		spr(cross_spr,pos.x+91,y)
		pal(7,7)
		
		local x = print("\014"..title,pos.x+10,y,text_col)
		if b.complete then
			line(pos.x+9,y+2,x-1,y+2,text_col)
		end
		y+=7
	end
	
	if #self.todos == 0 then
		print("\014none found!",pos.x+8,y,text_col)
	end
end

function create_todo_drawer(te, top)
	te.todo_drawer=Drawer{
--		h=full_height(ceil(top/2)+7),
		h=1,
		w=112,
		direction=DRAWER_LEFT,
		handle_size=0,
	}:add_to(te,vec(-1,top))

	te.todo_box=create_container{
		h=full_height(),
		w=full_width(),
		vert_layout=true,
		align=ALIGN_RIGHT,
		gap_size=2,
		l_pad=14,
		scrollable=true,
		scroll_args={
			thumb_col="light",
			r_pad=7,
			w=4,
		},
	}:add_to(te.todo_drawer.contents)
end

function set_todos(te, todos)
	local b = ToDoGroup{
		todos=todos,
		te=te,
	}:add_to(te.todo_box)
	
	te.todo_drawer:update_dims{h=min(b.h,te.h-te.bookmark_top-7)}
end

function remove_todos(te)
	for b in all(te.todo_box.elems) do
		if b.special_typ != "scrollbar" then
			b:remove()
		end
	end
	te.todos = {}
end

end
:: lib/xi_gui/text_ed/undo.lua
--[[pod_format="raw",created="2025-04-08 22:19:33",modified="2025-05-26 19:26:59",revision=6810,xstickers={}]]
UndoStack = create_class()

function create_undo_stacks(content)
	content.undo_stacks = UndoStack{content = content}
end

function UndoStack:_init(attribs)
	self.undos={}
	self.redos={}
	self.undo_queue={}
	self.redo_queue={}
	self.steps_since_change=0
	self.content = attribs.content
end

function UndoStack:update(since_inp)
	if since_inp == 0 then
		self.redos = {}
		self.redo_queue = {}
	end

	self.steps_since_change+=1
	self.steps_since_change = min(self.steps_since_change,since_inp)
	if self.steps_since_change > 30 then
		self.steps_since_change = 0
		self:clear_queues()
	end
end

function UndoStack:undo()
	self.steps_since_change = 0
	self:clear_queues()
			
	if #self.undos > 0 then
		local batch = self.undos[#self.undos]
		deli(self.undos,#self.undos)
		local ln_n = 1
		for step in all(batch) do
			local typ,args,_ = unpack(step)
			ln_n = args[1]
			if typ == "rep" then
				self:apply_replace_step(unpack(args))
			elseif typ == "add" then
				self:apply_add_step(unpack(args))
			elseif typ == "del" then
				self:apply_del_step(unpack(args))
			else
				assert(false,"Bad undo type, "..tostr(typ))
			end
		end
		ln_n = min(ln_n, #self.content.lns)
		self.content.crs:move_to(1,ln_n)
		self.content.crs:move_to(#self.content.crs:get_ln().text+1,ln_n)
		self.content.line_refresh_needed=true
--		active_editor.crs:move_to(
--			min(active_editor.crs.xpos,#active_editor.file.lns[ln_n].text+1),
--			ln_n
--		)
	end
end

function UndoStack:redo()
	self.steps_since_change = 0
	self:clear_queues()
	
	if #self.redos > 0 then
		local batch = self.redos[#self.redos]
		deli(self.redos,#self.redos)
		local ln_n = 1
		for step in all(batch) do
			local typ,args,_ = unpack(step)
			ln_n = args[1]
			add(args,true)
			if typ == "rep" then
				self:apply_replace_step(unpack(args))
			elseif typ == "add" then
				self:apply_add_step(unpack(args))
			elseif typ == "del" then
				self:apply_del_step(unpack(args))
			else
				assert(false,"Bad undo type, "..tostr(typ))
			end
		end
		ln_n = min(ln_n, #self.content.lns)
		self.content.line_refresh_needed=true
		self.content.crs:move_to(1,ln_n)
		self.content.crs:move_to(#self.content.crs:get_ln().text+1,ln_n)
		self.content.line_refresh_needed=true
--		active_editor.crs:move_to(
--			min(active_editor.crs.xpos,#active_editor.file.lns[ln_n].text+1),
--			ln_n
--		)
	end
end

function UndoStack:clear_queues()
-- Clears the existing queued updates and adds them to
-- the undo stack.
	if #self.undo_queue > 0 then
		if self.undos[1] and not self.undos[1][3] then
			self.redo_queue = {}
			self.redos={}
		end
		add(self.undos,self.undo_queue)
		self.undo_queue = {}
	end

	if #self.redo_queue > 0 then
		add(self.redos,self.redo_queue)
		self.redo_queue = {}
	end
end

function UndoStack:add_replace_step(ln_n,before,after,is_undo,is_redo)
	local queue = self.undo_queue
	if is_undo then
		queue = self.redo_queue
	end
	
	if #queue > 0 and queue[1][1] == "rep" and queue[1][2][2] == ln_n then
		local cur_step = queue[1]
		local cur_step_args = cur_step[2]
		before = apply_delta(before,cur_step_args[3])
		del(queue,cur_step)
	end

	add(
		queue,
		{
			"rep",
			{
				ln_n,
				create_delta(after,before)
			},
			is_redo
		},
		1
	)
	self.steps_since_change=0
end

function UndoStack:apply_replace_step(ln_n,delta, is_redo)
-- Executes an undo step where text in a line is updated.
-- Restores it to the previous text.
	self.content:replace_line_content(
		ln_n,
		apply_delta(self.content.lns[ln_n].text,delta),
		not is_redo,
		is_redo
	)
end

function UndoStack:add_add_step(ln_n,is_undo,is_redo)
	local queue = self.undo_queue
	if is_undo then
		queue = self.redo_queue
	end
	add(
		queue,
		{
			"add",
			{
				ln_n,
				is_undo,
			},
			is_redo
		},
		1
	)
	self.steps_since_change=0
end

function UndoStack:apply_add_step(ln_n,is_redo)
-- Executes an undo add step (delete the added line)
	self.content:delete_line(
		ln_n,
		not is_redo,
		is_redo
	)
end

function UndoStack:add_del_step(ln_n,content,is_undo,is_redo)
	local queue = self.undo_queue
	if is_undo then
		queue = self.redo_queue
	end
	add(
		queue,
		{
			"del",
			{
				ln_n,
				content,
			},
			is_redo
		},
		1
	)
	self.steps_since_change=0
end

function UndoStack:apply_del_step(ln_n,text,is_redo)
-- Executes an undo delete step (i.e. add the line in again)
	self.content:add_line(
		ln_n,
		text,
		not is_redo,
		is_redo
	)
end

