--[[pod_format="raw",created="2025-04-05 19:08:03",modified="2025-05-22 15:11:22",revision=1692]]
do

Anim=create_class(XiGuiElem)

function Anim:draw()
	local pos = self.canv_pos
	if self.hide then
		return
	end

	local frame = flr(t()*#self.frames*self.length_s)%#self.frames + 1
	local sprite = get_spr(self.frames[frame])
	local w,h = sprite:attribs()
	pos += vec((self.w-w)/2,(self.h-h)/2)
	
	for o_col,n_col in pairs(self.recol) do
		pal(o_col,self:get_theme_colour(n_col))
	end
	spr(sprite,pos.x,pos.y)
	for o_col,n_col in pairs(self.recol) do
		pal(o_col,o_col)
	end
end

function Anim:_init(attribs)
	-- Required attributes:
	-- frames: frames of the animation
	-- length_s: length of the animation in seconds
	
	assert(attribs.frames, "No frames provided when creating animation.")
	assert(attribs.length_s, "No length of animation provided.")
	
	local w,h = get_spr(attribs.frames[1]):attribs()
	
	self:apply_defaults{h=h,w=w,recol={}}
end

end
:: src/footer.lua
--[[pod_format="raw",created="2025-03-31 13:19:09",modified="2025-05-22 15:11:22",revision=23207]]
do

Footer = create_class(Container,VertLayout)

function Footer:update()
	if not text_ed:has_focus() then return end
	local ln = "#lns:"..#text_ed.content.lns.."  ln: "..text_ed.content.crs.ln_n.."  pos: "..text_ed.content.crs.xpos
	local err_msg = ""
	
	if text_ed.content.err and text_ed.content.err.ln_n > #text_ed.content.lns then
		err_msg = text_ed.content.err.msg
	elseif text_ed.content.err then
		err_msg = "error at ln: "..text_ed.content.err.ln_n
--		err_msg = self.text_ed.content.err.msg
	end

	self.coords:set_text(ln)
	self.err_msg:set_text(err_msg)
	
	self.loading_timer = max(0,self.loading_timer-1)
	
--	autosaved = max(0,autosaved-1)
	
	if text_ed.corefresh != nil then
		self.loading_timer = 15
	end
	self.loading.hide = self.loading_timer == 0
--	self.save_icon.hide = not unsaved_changes
--	self.save_label.hide = not unsaved_changes
	
	self:request_redraw(true)
end

function create_footer()
	local footer_wrapper = create_container{
		w=full_width(),
		h=7,
		l_pad=0,
		bg_col="bg",
		t_pad=0,
		hor_layout=true,
	}
	
	local icons = create_container{
		w=50,
		h=7,
		l_pad=2,
	}:add_to(footer_wrapper)

	local footer = Footer{
		wrap=true,
		align=ALIGN_RIGHT,
		w=remaining_width(),
		h=7,
		l_pad=5,
		gap_size=5,
		loading_timer=0,
	}:add_to(footer_wrapper)
	
	footer.loading = Anim{
		frames={24,25,26,27,28,29},
		length_s=1,
		recol={[7]="middle"},
	}:add_to(icons,vec(1,1))
	
--	footer.save_icon = Sprite{
--		sprite=30,
--		recol={[7]="middle"},
--	}:add_to(icons,vec(7,1))
--	
--	footer.save_label = create_sml_label{
--		text="unsaved",
--		text_col="middle",
--	}:add_to(icons,vec(13,0))

	local md = "mode: text"
	if pwf():ext() == "lua" then
		md = "mode: code"
	end

	footer.toggle_mode = TextBtn{
		text=md,
		callback=function(bt)
			if bt.text == "mode: text" then
				bt.text = "mode: code"
			else
				bt.text = "mode: text"
			end
			text_ed.highlight_syntax = bt.text == "mode: code"
			btn_prssd(text_ed)
		end,
		y_off=0,
		w=43,
		base_col="bg",
		text_col="middle",
		small_text=true,
	}:add_to(footer)

	footer.err_msg = Label{
		text="",
		text_col="light",
		y_off=0,
		small_text=true,
	}:add_to(footer)
	
	footer.coords = Label{
		text="",
		text_col="middle",
		y_off=0,
		small_text=true,
	}:add_to(footer)
	
	return footer_wrapper
end

end
:: src/settings.lua
--[[pod_format="raw",created="2025-04-02 07:43:42",modified="2025-07-22 14:33:05",revision=10380,xstickers={}]]
SETTINGS_LOCATION = "/appdata/strawberry_src/settings.pod"

function init_settings()
	load_settings()

	update_settings{debug=false}

--	settings.debug=true

	show_settings=false
end

function load_settings()
	settings = fetch(SETTINGS_LOCATION)
	
	if not settings then
		settings = get_default_settings()
		create_default_settings_file()
		return
	end
	
	for k,v in pairs(get_default_settings()) do
		if settings[k] == nil then settings[k] = v end
	end
	
	apply_settings()
end

function apply_settings()
	if text_ed then
		text_ed:set_word_wrap(settings.word_wrap)
		if settings.line_len_guide then
			text_ed.max_line_len=settings.max_line_len
		else
			text_ed.max_line_len=nil
		end
		text_ed.changed_width=true
		text_ed.smooth_scroll = settings.smooth_scroll
		text_ed.show_bookmarks = settings.show_bookmarks
		if settings.show_bookmarks and pwf():ext()=="lua" then
			text_ed:open_bookmarks()
		elseif pwf():ext()=="lua" then
			text_ed:close_bookmarks()
		end
		text_ed.monospace = settings.monospace
		text_ed.enable_autocomplete = settings.autocomplete
		text_ed.show_ln_ns = pwf():ext()=="lua" or settings.text_ln_ns
		text_ed.rainbow_brackets = settings.rainbow_brackets
		text_ed.file_previews = settings.file_previews
		text_ed.string_previews = settings.string_previews
		word_lengths = {}
		text_ed.content.line_refresh_needed=true
	end
	
	if settings.monospace then
		fetch("/system/fonts/lil_mono.font"):poke(0x4000)
	else
		fetch("/system/fonts/lil.font"):poke(0x4000)
	end
	
	if settings_menu then
		settings_menu.max_line_len.label:set_text(tostr(settings.max_line_len))
		settings_menu.word_wrap.selected = settings.word_wrap
		settings_menu.smooth_scroll.selected = settings.smooth_scroll
		settings_menu.line_len_guide.selected = settings.line_len_guide
--		settings_menu.debug.selected = settings.debug
		settings_menu.code_theme.cur_option = settings.code_theme
		settings_menu.text_theme.cur_option = settings.text_theme
		settings_menu.monospace.selected = settings.monospace
		settings_menu.text_ln_ns.selected = settings.text_ln_ns
		settings_menu.autocomplete.selected = settings.autocomplete
		settings_menu.rainbow_brackets.selected = settings.rainbow_brackets
		settings_menu.file_previews.selected = settings.file_previews
		settings_menu.string_previews.selected = settings.string_previews
		settings_menu.code_fullscreen.selected = settings.code_fullscreen
		settings_menu.text_fullscreen.selected = settings.text_fullscreen
	end
	
	if xgui then
		if pwf():ext()=="lua" then
			set_theme(settings.code_theme)
		else
			set_theme(settings.text_theme)
		end
	end
end

on_event("modified:"..SETTINGS_LOCATION,
	function(msg)
		load_settings()
	end
)

function update_settings(attribs)
	for k,v in pairs(attribs) do
		settings[k] = v
	end
	apply_settings()
	store(SETTINGS_LOCATION, settings)
end

function get_default_settings()
	return {
		word_wrap = true,
		line_len_guide = true,
		max_line_len = 65,
		smooth_scroll = true,
		show_bookmarks = true,
		debug = false,
		code_theme="Classic",
		text_theme="Organic Paper",
		monospace=false,
		text_ln_ns=false,
		autocomplete=true,
		rainbow_brackets=true,
		code_fullscreen=true,
		text_fullscreen=false,
		string_previews=true,
	}
end

function create_default_settings_file()
	if not fstat("/appdata/strawberry_src") then
		mkdir("/appdata/strawberry_src")
	end
	store(SETTINGS_LOCATION, get_default_settings())
end

function create_settings_title(text)
	local title = create_container{
		w=full_width(),
		h=22,
	}:add_to(settings_menu)
	
	local title_txt = Label{
		text=text,
		text_col="light",
		l_pad=1,
		h=9,
	}:add_to(title,vec(0,9))
	
	set_draw_target(userdata("u8",title_txt.w,1))
	
	local w = print(text,0,0)+1
	
	create_container{
		w=w,
		h=1,
		bg_col="light",
	}:add_to(title,vec(0,18))
	
	set_draw_target()
	
	return title
end

function create_settings_menu()
	outer_settings_container = create_container{
		w=full_width(),
		h=full_height(),
		bg_col="bg",
	}
	
	settings_menu = create_container{
		w=full_width(),
		h=full_height(),
		bg_col="bg",
		l_pad=5,
		t_pad=0,
		gap_size=5,
		wrap=false,
		scrollable=true,
		b_pad=20,
		vert_layout=true,
	}
	
	settings_menu.scrollbar.h_func = function()
		return settings_menu.h-16
	end
	
	settings_menu:add_to(outer_settings_container)
	
	settings_menu.scrollbar:update_dims{pos=vec(-1,15)}	
	
	local nt = fetch("/ram/shared/theme.pod")
	
	if tabbed then
		create_container{
			w=full_width(),
			h=1,
			bg_col=nt.toolbar_selected
		}:add_to(outer_settings_container)
	end
	
	create_settings_title("General Settings"):add_to(settings_menu)
	
	settings_menu.smooth_scroll = CheckBox{
		text="Smooth scroll",
		callback=function(cb,val) update_settings{smooth_scroll = val} end,
		selected=settings.smooth_scroll,
	}:add_to(settings_menu)
	
	settings_menu.monospace = CheckBox{
		text="Monospace font",
		callback=function(cb,val) update_settings{monospace = val} end,
		selected=settings.monospace,
	}:add_to(settings_menu)
	
	add_max_line_len()
	
--	settings_menu.debug = create_checkbox{
--		text="Debug view",
--		callback=function(val) update_settings{debug = val} end,
--		selected=settings.debug,
--	}:add_to(settings_menu)
	
	create_settings_title("Code Editor Settings"):add_to(settings_menu)

	settings_menu.code_fullscreen = CheckBox{
		text="Fullscreen (requires restart)",
		callback=function(cb,val) update_settings{code_fullscreen = val} end,
		selected=settings.code_fullscreen,
	}:add_to(settings_menu)

	settings_menu.code_theme = Dropdown{
		options=theme_names,
		cur_option=settings.code_theme,
		callback=function(dd,nt)
			update_settings{code_theme=nt}
		end,
	}
	
	local code_theme_line = create_container{
		h=settings_menu.code_theme.h,
		w=full_width(),
		hor_layout=true,
	}:add_to(settings_menu)
	
	Label{text="Theme:",t_pad=1}:add_to(code_theme_line)
	
	settings_menu.code_theme:add_to(code_theme_line)	
	
	settings_menu.autocomplete = CheckBox{
		text="Enable autocomplete",
		callback=function(cb,val) update_settings{autocomplete = val} end,
		selected=settings.autocomplete,
	}:add_to(settings_menu)
	
	settings_menu.rainbow_brackets = CheckBox{
		text="Enable rainbow brackets",
		callback=function(cb,val) update_settings{rainbow_brackets = val} end,
		selected=settings.rainbow_brackets,
	}:add_to(settings_menu)
	
	settings_menu.file_previews = CheckBox{
		text="Enable file previews",
		callback=function(cb,val) update_settings{file_previews = val} end,
		selected=settings.file_previews,
	}:add_to(settings_menu)
	
	settings_menu.string_previews = CheckBox{
		text="Enable string previews",
		callback=function(cb,val) update_settings{string_previews = val} end,
		selected=settings.string_previews,
	}:add_to(settings_menu)
	
	create_settings_title("Text Editor Settings"):add_to(settings_menu)
	
	settings_menu.text_fullscreen = CheckBox{
		text="Fullscreen (requires restart)",
		callback=function(cb,val) update_settings{text_fullscreen = val} end,
		selected=settings.text_fullscreen,
	}:add_to(settings_menu)
	
	settings_menu.text_theme = Dropdown{
		options=theme_names,
		cur_option=settings.text_theme,
		callback=function(dd,nt)
			update_settings{text_theme=nt}
		end,
	}
	
	local text_theme_line = create_container{
		h=settings_menu.text_theme.h,
		w=full_width(),
		hor_layout=true,
	}:add_to(settings_menu)
	
	Label{text="Theme:",t_pad=1}:add_to(text_theme_line)
	
	settings_menu.text_theme:add_to(text_theme_line)
	
	settings_menu.word_wrap = CheckBox{
		text="Word wrap",
		callback=set_word_wrap,
		selected=settings.word_wrap,
	}:add_to(settings_menu)
	
	settings_menu.text_ln_ns = CheckBox{
		text="Show line numbers",
		callback=function(cb,val) update_settings{text_ln_ns = val} end,
		selected=settings.text_ln_ns,
	}:add_to(settings_menu)
end

function toggle_settings()
	show_settings = not show_settings
	settings_btn.selected = not settings_btn.selected
	
	if show_settings then
		text_ed_container:remove()
		outer_settings_container:add_to(xgui,nil,1)
	else
		outer_settings_container:remove()
		text_ed_container:add_to(xgui,nil,1)
		text_ed:set_focus()
	end
end

function add_max_line_len()
	settings_menu.max_line_len = create_container{
		w=145,
		h=10,
	}:add_to(settings_menu)
	
	settings_menu.line_len_guide = CheckBox{
		text="Line length guide:",
		callback=toggle_max_line_len,
		selected=settings.line_len_guide,
	}:add_to(settings_menu.max_line_len)
	
	IconBtn{
		sprite=10,
		callback=decrease_max_line_len,
		hold_repeat=true,
		v_pad=1,
	}:add_to(settings_menu.max_line_len,vec(103,0))
		
	settings_menu.max_line_len.label = Label{
		text=tostr(settings.max_line_len),
	}:add_to(settings_menu.max_line_len,vec(115,0))
	
	IconBtn{
		sprite=11,
		callback=increase_max_line_len,
		hold_repeat=true,
		v_pad=1,
	}:add_to(settings_menu.max_line_len,vec(127,0))
end

function set_word_wrap(bt,val)
	update_settings{word_wrap=val}
end

function increase_max_line_len()
	update_settings{max_line_len=min(settings.max_line_len+1,99)}
end

function decrease_max_line_len()
	update_settings{max_line_len=max(settings.max_line_len-1,10)}
end

function toggle_max_line_len(cb,tog)
	update_settings{line_len_guide=tog}
end
