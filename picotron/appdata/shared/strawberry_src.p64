		te_selection=13,
		te_cursor=1,
		bg = 7,
		middle = 22,
		light = 21,
		highlight = 1,
		contrast1 = 24,
		contrast2 = 25,
		contrast3 = 27,
		contrast_text=7,
		todo_text = 25,
	},
	Spaghettieis = {
		basic_text=21,
		te_number=18,
		te_comment=31,
		te_special=1,
		te_string=18,
		te_space=7,
		te_keyword=25,
		te_base_func=24,
		te_user_func=2,
		te_local_var=4,
		te_func_var=20,
		te_selection=14,
		te_cursor=24,
		bg = 15,
		middle = 24,
		light = 14,
		highlight = 7,
		contrast1 = 24,
		contrast2 = 25,
		contrast3 = 27,
		contrast_text=7,
		todo_text = 25,
	},
}

theme_names = {}
for k,v in pairs(themes) do
	add(theme_names,k)
end
theme_names = sort_list_alpha(theme_names)

function refresh_theme()
	local matches = true
	
	local new_gui_theme = {
		middle=theme"toolbar_item",
		light=theme"toolbar_selected",
		highlight=theme"toolbar_back",
		tab_text=theme"toolbar_back",
		tab_bar_bg=theme"icon3",
	}
	
	for k,v in pairs(new_gui_theme) do
		if not cur_theme or cur_theme[k] != v then
			matches=false
			break
		end
	end
	
	if not matches then
		cur_theme = new_gui_theme
		xgui:set_theme(new_gui_theme)
		xgui:redraw_all()
	end
end

function set_theme(nt)
	cur_theme=nil
	if not themes[nt] then
		nt = "System"
--		update_settings{theme="System"}
	end
	if nt != "System" then
		xgui:set_theme(themes[nt])
	else
		refresh_theme()
	end
	xgui:redraw_all()
end

:: src/toggle.lua
--[[pod_format="raw",created="2025-04-04 12:50:06",modified="2025-05-12 19:56:06",revision=2859]]
do

local Toggle={}

function Toggle:draw_self(pos)
	local cur_col = self:get_theme_colour(self.cur_col)
	
	round_rect(pos.x,pos.y+self.y_off,self.w,self.h,cur_col,true)
	
	print_small(
		self.text,
		pos.x+self.l_pad-1,
		pos.y+self.t_pad+self.y_off-1,
		self:get_theme_colour(self.text_col)
	)
end

function Toggle:click()
	if not self.enabled then return end

	get_mouse_listener():set_pointer("pointer")
	
	self.cur_option = (self.cur_option % #self.options) + 1
	
	self.text = self.options[self.cur_option]
	
	self.callback(self.text)
end

function create_toggle(attribs)
	assert(attribs.options,"No options given for toggle")
	assert(attribs.callback,"No callback given for toggle")
	
	local cur_option = attribs.cur_option or 1
	
	merge_template(attribs,
		{
			text = attribs.options[cur_option],
			w=4*#attribs.options[cur_option]+4,
			l_pad=2,
			cur_option = cur_option,
			y_off=0,
		}
	)

	return create_new_elem(Toggle,attribs,create_text_button)
end

end

