include "lib/xi_gui/gui.lua"
include "lib/perf.lua"
include "lib/sort_list.lua"

include "src/footer.lua"
include "src/anim.lua"
include "src/theme.lua"
include "src/settings.lua"

--TODO: Test todos! COMPLETE

--[[BOOKMARK:file wrangling]]

--[[GROUP:init]]

color(1)

function _init()
	include_text_editor()

	local w,h = 350,200
	tabbed = false
	
	current_filename = "help.txt"
	
	sandboxed = fetch_metadata(pwd()).sandbox
	
	if not fullpath(current_filename) then
		-- can't resolve: use /appdata. happens when e.g. /ram/cart is not available because sandboxed
		current_filename = "/appdata/"..current_filename:basename()
	end
	
	if (env().location) then
		current_filename = env().location
	elseif (env().argv and env().argv[1]) then
		current_filename = env().argv[1]
	end
	
	current_filename = fullpath(current_filename)
	
	init_settings()
	
--	settings.debug=true
	
	if env().tabbed != nil then
		tabbed = env().tabbed
	else
		tabbed = (
			(current_filename:ext() == "lua" and settings.code_fullscreen) or
			(current_filename:ext() != "lua" and settings.text_fullscreen)
		)
	end
	
	if tabbed then
		w,h=nil,nil
	end
	
	window{
		title="Strawberry Src",
		width=w,
		height=h,
		pauseable=false,
		tabbed = tabbed,
		icon = (
--[[pod_type="gfx"]]unpod("b64:bHo0ACQAAAAiAAAA8BNweHUAQyAIBwRgByAXABcQBwAXAAcARwAXABcAFwB3AFcA")
		),
	}

	wrangle_working_file(
	
		-- save to obj
		function ()
			file_content.unsaved_changes=false
			local txt, meta = file_content:get_text()
			return txt, meta
		end,
	
		-- load from obj (assumed to be a string)
		function (str, meta)
			file_content = TextContent{text=str,meta=meta,id=pwf()}
		end,
	
		-- default filename
		"help.txt",
		
		-- location string
		function()
			return file_content.crs.ln_n..","..file_content.crs.xpos
		end,

		-- jump to location string
		function(loc, highlight)
--			printh("[code] recieved loc: "..pod{loc,highlight})
			local spl = split(loc,",")
			
			local xpos,ypos
			
			if spl then
				ypos = tonum(spl[1])
				xpos = tonum(spl[2])
			end
			
			if ypos then
				file_content.crs:move_to(1,tonum(loc))
				if xpos then
					file_content.crs:move_to(xpos)
				else
					file_content.crs:move_to(#file_content.crs:get_ln().text+1)
				end
				if text_ed then
					text_ed:jump_to_cursor()
				end
				if highlight then
					local lns = file_content.crs:copy()
					lns:move_to(1)
					file_content.selection = create_selection(lns,file_content.crs)
				end
			end
		end
	)

	menuitem{
		id=4,
		divider=true,
		greyed=true
	}
	
	menuitem{
		id=5,
		label="Manual",
		shortcut="F1",
		action=function()
			show_help()
		end,
		icon=(
--[[pod_type="gfx"]]unpod("b64:bHo0ABoAAAAYAAAA8AlweHUAQyAIBwQQITABIAFgAUARUAHgATA=")
		)
	}
	
menuitem{
	id = "open_file",
	label = "\^:7f4141417f616500 Open File",
	shortcut = "CTRL-O",
	action = function()
		local segs = split(current_filename,"/",false)
		local path = string.sub(current_filename, 1, -#segs[#segs] - 2) -- same folder as current file
		--create_process("/system/apps/filenav.p64", {path = path, window_attribs= {workspace = "current", autoclose=true}})

		--printh("Open File // _env().prog_name: ".._env().prog_name)
		-- can assume when program is terminal, co-running /ram/cart and should use that to open the file (useful for developing tools that use file wrangler)
		local open_with = env().argv[0]

		-- when opening with terminal, can assume co-running ram/cart
		--> use /ram/cart to run it.   //  allows wrangling files from load'ed cartridge; useful for tool dev
		if (open_with == "/system/apps/terminal.lua") then
			open_with = "/ram/cart/main.lua"
		end

		create_process("/system/apps/filenav.p64", {prog_name=env().argv[0], path = path, open_with = open_with, window_attribs= {workspace = "current", autoclose=true}})
	end
}
	
	
	fetch("pal/extended.pal"):poke(0x5000)
	
	init_gui()
	
	create_settings_menu()
--	
--	if settings.debug then
--		perf = create_perf_tracker()
--	end
	
	autosaved = 0

	unsaved_changes = false
	first_load = true
	
	
--	local s = Sticker{te=text_ed,idx=3,ln=text_ed.content.lns[10],off=vec(50,5)}:add_to(text_ed,vec(1000,1000))
--	add(text_ed.content.lns[10].stickers,s)
end

function init_gui()
	local ct = settings.text_theme
	if pwf and pwf():ext()=="lua" then
		ct = settings.code_theme
	end

	xgui = XiGui{theme=themes[ct]}
	
	if ct == "System" then
		refresh_theme()
	end
	
	text_ed_container= create_container{
		w=full_width(),
		h=full_height(),
		vert_layout=true,
		bg_col=0,
	}:add_to(xgui)
	
	local top_offset = 0
	
	if tabbed then
		sep = create_container{
			w=full_width(),
			h=1,
			bg_col=theme"toolbar_selected"
		}:add_to(text_ed_container)
		top_offset = 1
	end
	
	init_text_ed(top_offset)
	
	init_overlay(top_offset)
	
	sep = create_container{
		w=full_width(),
		h=1,
		bg_col="middle",
	}:add_to(text_ed_container)
	
	footer = create_footer{}:add_to(text_ed_container)

	text_ed:set_focus()
end

function init_text_ed(top_offset)
	text_ed = TextEditor{
		w=full_width(),
		h=remaining_height(),
		show_ln_ns=pwf():ext()=="lua" or settings.text_ln_ns,
		word_wrap=settings.word_wrap,
		content=file_content,
		highlight_syntax = pwf():ext()=="lua",
		bookmark_top=16,
		smooth_scroll=settings.smooth_scroll,
		show_bookmarks=settings.show_bookmarks and pwf():ext()=="lua",
		searchable=true,
		monospace=settings.monospace,
		enable_autocomplete=settings.autocomplete,
		rainbow_brackets=settings.rainbow_brackets,
		file_previews=settings.file_previews,
		string_previews=settings.string_previews,
		scroll_args={
			b_pad=50,
			z=20,
		}
	}:add_to(text_ed_container)
	
	
	if settings.line_len_guide then
		text_ed.max_line_len=settings.max_line_len
	end
	
	text_ed.scrollbar:update_dims{pos=vec(-1,14+top_offset)}
	text_ed.scrollbar.h_func = function() return text_ed.h-15-top_offset end
end

function init_overlay(top_offset)
--	overlay=create_container{
--		w=full_width(),
--		h=13,
--		z=10,
--		hor_layout=true,
--	}:add_to(xgui,vec(0,top_offset))
--	
--	create_padding{w=remaining_width()}:add_to(overlay)
	
	local menubar_w = 61
	
	menubar_drawer = Drawer{
		h=13,
		w=menubar_w,
		contents_col="middle",
		handle_size=19,
		direction=DRAWER_LEFT
	}:add_to(xgui,vec(-1,top_offset))
	
	menubar_drawer:open()
	
	icon = SpriteBtn{
		sprite=19,
		sprite_bg_col=30,
		callback=function() menubar_drawer:toggle() end
	}:add_to(menubar_drawer.handle)
	
	menubar = create_container{
		w=full_width(),
		h=full_height(),
		gap_size=1,
		hor_layout=true
	}:add_to(menubar_drawer.contents)

	bookmark_btn = IconBtn{
		sprite=12,
		callback=function()
			text_ed:toggle_bookmarks()
			text_ed.changed_width = true
			if text_ed.word_wrap and not text_ed.highlight_syntax then
				text_ed.content.line_refresh_needed=true
			end
			if pwf():ext()=="lua" then
				update_settings{show_bookmarks = text_ed.bookmark_drawer._open}
			end
		end,
		tooltip={text="Bookmarks"}
	}:add_to(menubar)
	
	todo_btn = IconBtn{
		sprite=37,
		callback=function()
			text_ed:toggle_todos()
			text_ed.changed_width = true
			if text_ed.word_wrap and not text_ed.highlight_syntax then
				text_ed.content.line_refresh_needed=true
			end
--			if pwf():ext()=="lua" then
--				update_settings{show_bookmarks = text_ed.bookmark_drawer._open}
--			end
		end,
		tooltip={text="ToDos"}
	}:add_to(menubar)
	
--	stickers_btn = IconBtn{
--		sprite=38,
--		callback=function()
--			text_ed:toggle_stickers()
--			text_ed.changed_width = true
--			if text_ed.word_wrap and not text_ed.highlight_syntax then
--				text_ed.content.line_refresh_needed=true
--			end
--			if pwf():ext()=="lua" then
--				update_settings{show_bookmarks = text_ed.bookmark_drawer._open}
--			end
--		end,
--		tooltip={text="stickers"}
--	}:add_to(menubar)
	
	settings_btn = IconBtn{
		sprite=6,
		callback=toggle_settings,
		tooltip={text="Settings"},
	}:add_to(menubar)
end

--[[GROUP]]

function _update()
	Mouse:update()
	xgui:update()
	
	if (keyp("f1")) show_help()
	
	if text_ed.content.unsaved_changes then
		window{title="*"..pwf():basename()}
	else
		window{title=pwf():basename()}
	end
	
	if settings.debug then
		if not perf then
			perf = PerfTracker{bg_col=1}:add_to(xgui,vec(20,100))
		end
		perf:log_update()
	elseif perf then
		perf:remove()
		perf=nil
	end
end

function _draw()
	cls(1)
	xgui:draw()
--	if settings.debug then
--		perf:log_draw()
--	end
--	print(test,5,5,8)

--	if sandboxed then
--		local y = get_display():height()-52
--		rectfill(0,y,220,get_display():height(),8)
--		print("RUNNING SANDBOXED",2,y+2,7)
--		print("Due to current bugs in Picotron, this can",2,y+12,7)
--		print("cause instabilities/data loss. Sorry :(",2,y+22,7)
--		print("Instructions on how to unsandbox are",2,y+32,7)
--		print("on the BBS page.",2,y+42,7)
--	end
end

function show_help()
	create_process(pwd(),{argv={pwd().."/help.txt"},tabbed=tabbed})
end

