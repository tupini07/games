function include_text_editor()
	for file in all(ls("lib/xi_gui/text_ed")) do
		include("lib/xi_gui/text_ed/"..file)
	end
	
	if not te_func_descs then
		init_tokenizer()
	end
end

function TextEditor(attribs)
	include_text_editor()
	
	return TextEditor(attribs)
end

do 

local basic_theme = {
	te_local_var = 15,
	te_func_var = 31,
	te_keyword=14,
	te_special=7,
	te_user_func = 27,
	te_base_func = 11,
	te_string = 12,
	te_comment = 13,
	te_space = 1,
	te_number = 12,
	te_cursor = 7,
	te_selection = 10,
	bg = 1,
	middle = 16,
	light = 12,
	highlight = 7,
	basic_text = 6,
	contrast1 = 24,
	contrast2 = 25,
	contrast3 = 9,
	contrast_text = 15,
	todo_text = 25,
}

local _has_focus = true
on_event("gained_focus", function() _has_focus = true end)
on_event("lost_focus", function() _has_focus = false end)

XiGui = create_class()

function XiGui:_init(attribs)
	self.elems = {}
	self:set_theme(attribs.theme or {})
	self.w = 480
	self.h = 270
	self.z=0
	self.pos = vec(0,0)
	self.abs_pos = vec(0,0)
	self.canv_pos = vec(0,0)
end

function XiGui:update()
	self.reset_tooltip=true
	
	self.cw = get_display():width()
	self.ch = get_display():height()
	
	if self.cw != self.w then
		self.w = self.cw
		for e in all(self.elems) do
			e:parent_width_change()
		end
	end
	if self.ch != self.h then
		self.h = self.ch
		for e in all(self.elems) do
			e:parent_height_change()
		end
	end
	
	for e in all(self.elems) do
		e:update_all(vec(0,0),vec(0,0))
	end
	
	local mouse_over = self:find_click_target()
	
	if self.mouse_over and self.mouse_over != mouse_over then
		self.mouse_over:end_hover()
	end
	
	self.mouse_over = mouse_over
	
	local was_fixed = self.fixed_hold
	
	if self.fixed_hold then
		mouse_over = self.fixed_hold
	end
	
	if mouse_over then
		mouse_over:hover()
		mouse_over:click_signal()
	end
	
	if Mouse.lmb:released() then 
		self.fixed_hold = nil
	end
	
	if Mouse.scroll.y != 0 or Mouse.scroll.x != 0 then
		local st = self:find_scroll_target()
		if st then
			st:mouse_scroll()
		end
	end
	
	if self.reset_tooltip then
		self.tooltip_origin=nil
		if self.tooltip then
			self.tooltip:remove()
			self.tooltip=nil
		end
	end
end

function XiGui:draw()
	for e in all(self.elems) do
		e:draw_all()
	end
	clip()
end

function XiGui:clip()
	clip()
end

function XiGui:request_redraw()
end

function XiGui:get_gui()
	return self
end

function XiGui:show_tooltip(args,origin)
	args = args or {title = self.tooltip and self.tooltip.title}
	self.reset_tooltip=false
	if (
		self.tooltip_origin == origin and 
		self.tooltip.title == args.title
	) then
		return
	end

	self.tooltip_origin=origin

	if self.tooltip then self.tooltip:remove() end
	if args.spritesheet then
		self.tooltip=GFXTooltip(args):add_to(self)
	else
		self.tooltip=Tooltip(args):add_to(self)
	end
	self.tooltip:update_pos()
	self.tooltip:update_all(self.abs_pos,self.canv_pos)
end





function XiGui:get_theme()
	return self.theme
end

function XiGui:set_theme(new_theme)
	self.apply_defaults(new_theme,basic_theme)
	for i = 0,63 do
		new_theme[i] = i
	end
	self.theme = new_theme
	
	self:redraw_all()
end

function XiGui:redraw_all()
	for _, el in pairs(self.elems) do
		el:redraw_all()
	end
end

function XiGui:has_focus(target)
	target = target or self
	return _has_focus and target == self.focus
end

function XiGui:set_focus(target)
	while readtext() do end
	self.focus = target
end

function XiGui:fix_hold(target)
	self.fixed_hold = target
end

function XiGui:get_theme_colour(col_name)
	return self.theme[col_name]
end

function XiGui:get_pos()
	return vec(0,0)
end

function XiGui:add_elem(e)
	e:add_to(self)
end

function XiGui:child_height_change()
end

function XiGui:child_width_change()
end

function XiGui:child_moved()
end

function XiGui:find_click_target()
	if (not _has_focus) return nil
	local best_option = nil
	for e in all(self.elems) do
		local op = e:get_top_click_target()
		if best_option == nil or (op and op.z >= best_option.z) then
			best_option = op
		end
	end
	return best_option
end

function XiGui:find_scroll_target()
	local best_option = nil
	for e in all(self.elems) do
		local op = e:get_top_scroll_target()
		if best_option == nil or (op and op.z >= best_option.z) then
			best_option = op
		end
	end
	return best_option
end

