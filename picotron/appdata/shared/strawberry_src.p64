:: lib/xi_gui/mixins/clickable.lua
--[[pod_format="raw",created="2025-05-20 15:56:37",modified="2025-05-28 12:23:58",revision=5549,xstickers={}]]
Clickable = create_class()

function Clickable:_init(attribs)
	self.clickable = true
end

MBTN_STATE_NAME = {
	[CLICK_STATES.clicked] = "click",
	[CLICK_STATES.held] = "hold",
	[CLICK_STATES.released] = "release",
}

MBTN_NCLICKS_NAME = {
	"",
	"_double",
	"_triple"
}

function Clickable:click_signal()
	local func_name, mb
	
	for _,bt in pairs(Mouse.btns) do
		if not bt:not_clicked() then
			func_name = bt.name.."_"
			mb = bt
		end
	end
	
	if not func_name then return end
	
	self:set_focus()
	
	assert(MBTN_STATE_NAME[mb.click_state:get()],tostr(mb.click_state:get()))
	
	local func_name_base = func_name .. 
		MBTN_STATE_NAME[mb.click_state:get()]
	local func_name = func_name_base .. 
		MBTN_NCLICKS_NAME[(mb.n_clicks-1)%3+1]
	
	if self[func_name] then
		self[func_name](self)
	elseif self[func_name_base] then
		self[func_name_base](self)
	end
end

function Clickable:hover()
end

function Clickable:end_hover()
end

Draggable = create_class(Clickable)

function Draggable:hover()
	Mouse:set_pointer("grab")
end

function Draggable:lmb_click()
	self.dragged=true
	self:fix_hold()
	self.hold_pnt = self.pos-Mouse.pos
end

function Draggable:lmb_hold()
	local npos = self.hold_pnt+Mouse.pos
	npos.x = max((sgn(self.pos.x)-1)//2,npos.x)
	npos.y = max((sgn(self.pos.y)-1)//2,npos.y)
	self:update_dims{pos=npos}
end

function Draggable:lmb_release()
	self.dragged=false
end

:: lib/xi_gui/mixins/hor_layout.lua
--[[pod_format="raw",created="2025-05-21 16:47:23",modified="2025-05-23 12:00:32",revision=552]]
do 

HorLayout = create_class()

function HorLayout:_init(attribs)
	self:apply_defaults{
		gap_size=attribs.gap_size or 0,
		l_pad=attribs.l_pad or 0,
		t_pad=attribs.t_pad or 0,
		wrap=attribs.wrap,
--		align=attribs.align or ALIGN_LEFT,
	}
end

function HorLayout:refresh_content_position()
	local rows = {
		{
			y=self.t_pad,
			max_height=0,
		},
	}
	local x = self.l_pad
	local cur_row = rows[1]
	
	for e in all(self.elems) do
		if self.wrap and x+(e.w or 0)+self.l_pad > self.w then
			x = self.l_pad
			add(rows,
				{
					y = cur_row.y+cur_row.max_height+self.gap_size,
					max_height = 0
				}
			)
			cur_row = rows[#rows]
		end
		add(cur_row, e)
		x+=self.gap_size+(e.w or 0)
		cur_row.max_height = max(cur_row.max_height,(e.h or 0))
	end
	
	for row in all(rows) do
		x = self.l_pad
		for e in all(row) do
			e.pos = vec(x,row.y+(row.max_height-(e.h or 0))/2)
			x+=self.gap_size+(e.w or 0)
		end
	end
	
	self:request_redraw(true)
end

function HorLayout:self_height_change()
	self:refresh_content_position()
end

function HorLayout:self_width_change()
	self:refresh_content_position()
end

function HorLayout:child_height_change()
	self:refresh_height()
	self:refresh_content_position()
end

function HorLayout:child_width_change()
	self:refresh_width()
	self:refresh_content_position()
end

end
:: lib/xi_gui/mixins/scrollable.lua
--[[pod_format="raw",created="2025-05-21 08:31:48",modified="2025-05-28 12:23:58",revision=2375,xstickers={}]]
Scrollable = create_class()

function Scrollable:_init(attribs)
	self.scroll_target = attribs.scroll or vec(0,0)
	self.scroll = attribs.scroll or vec(0,0)
	self.b_pad = attribs.b_pad or 0
	self.scrollable = true
	
	self.content_h = 0
	self.content_w = 0
	
	self.scrollbar = ScrollBar(attribs.scroll_args)
end

function Scrollable:update_scroll()
--	if self.scrollable then
	self.scroll_target.y = mid(0,max(self.content_h-(self.h or 0)+self.b_pad,0),self.scroll_target.y)
	local cur_scroll = self.scroll
	self.scroll=self.scroll_target+0
	if self.scroll.x != cur_scroll.x or 
		self.scroll.y != cur_scroll.y 
	then
		self:request_redraw(true)
		for el in all(self.elems) do
			if not el.special_typ then
				el.offset = self.scroll*-1
				el:calc_pos(self.abs_pos,self.canv_pos)
--				el:request_redraw(true)
			end
		end
	end
--	end
end
	
function Scrollable:mouse_scroll()
	if Mouse.scroll.y > 0 then
		self.scroll_target.y -= 33
	elseif Mouse.scroll.y < 0 then
		self.scroll_target.y += 33
	end
	self:update_scroll()
	if self.scrollbar then
		self.scrollbar:update_thumb()
	end
end

:: lib/xi_gui/mixins/vert_layout.lua
--[[pod_format="raw",created="2025-05-21 13:50:15",modified="2025-05-28 12:23:58",revision=1715,xstickers={}]]
do 

ALIGN_LEFT = 1
ALIGN_RIGHT = 2
ALIGN_CENTRE = 3

VertLayout = create_class()

function VertLayout:_init(attribs)
	self:apply_defaults{
		gap_size=attribs.gap_size or 0,
		l_pad=attribs.l_pad or 0,
		t_pad=attribs.t_pad or 0,
		wrap=attribs.wrap,
		align=attribs.align or ALIGN_LEFT,
	}
end

function VertLayout:refresh_content_position()
	local cols = {
		{
			max_width=0,
		},
	}
	local y = self.t_pad
	local cur_col = cols[1]
	
	for e in all(self.elems) do
		if not e.special_typ then
			if self.wrap and y+e.h+self.t_pad > self.h then
				y = self.t_pad
				add(cols,
					{
						max_width = 0
					}
				)
				cur_col = cols[#cols]
			end
			add(cur_col, e)
			y+=self.gap_size+(e.h or 0)
			cur_col.max_width = max(cur_col.max_width,e.w)
		end
	end
	
	local tw = 0--self.l_pad*2
	for i,col in ipairs(cols) do
		tw+=col.max_width
	end
	
--	local adj = max((self.w-self.l_pad*(#cols+1))/tw,1)
	local adj = ((self.w or 0)-self.l_pad*(#cols+1))/tw
	
	local x = self.l_pad
	for col in all(cols) do
		y = self.t_pad
		for e in all(col) do
			local xpos = 0
			if self.align == ALIGN_RIGHT then
				xpos=col.max_width*adj-(e.w or 0)
			elseif self.align == ALIGN_CENTRE then
				xpos=(col.max_width*adj-(e.w or 0))/2 
			end
			e.pos = vec(x+xpos,y)
			y+=self.gap_size+(e.h or 0)
		end
		x+=col.max_width*adj+self.l_pad
	end
	
	self:update_content_size()
	
	self:request_redraw(true)
end

function VertLayout:self_height_change()
	self:refresh_content_position()
end

function VertLayout:self_width_change()
	self:refresh_content_position()
end

function VertLayout:child_height_change()
	self:refresh_height()
	self:refresh_content_position()
end

function VertLayout:child_width_change()
	self:refresh_width()
	self:refresh_content_position()
end

end
