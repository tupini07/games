:: lib/xi_gui/elems/canvas.lua
--[[pod_format="raw",created="2025-05-21 08:29:48",modified="2025-05-28 12:23:58",revision=3226,xstickers={}]]
Canvas = create_class(Container, Clickable)

function Canvas:_init()
	self.bg_col = self.bg_col or 0
	self.parent_canv_pos = self.canv_pos
	self.redraw_needed = true
end

function Canvas:calc_pos(abs_origin, canv_origin)
	self.abs_pos = abs_origin + self.pos
	self.canv_pos = canv_origin + self.pos
	
	if self.offset then
		self.abs_pos+=self.offset
		self.canv_pos+=self.offset
	end
	
	if self.pos.x < 0 then
		self.canv_pos.x += (self.parent.w or 0) - (self.w or 0) + 1
		self.abs_pos.x += (self.parent.w or 0) - (self.w or 0) + 1
	end
	
	if self.pos.y < 0 then
		self.canv_pos.y += (self.parent.h or 0) - (self.h or 0) + 1
		self.abs_pos.y += (self.parent.h or 0) - (self.h or 0) + 1
	end
	
	self.parent_canv_pos = self.canv_pos
	
	self.canv_pos = vec(0,0)
	
	for _,el in pairs(self.elems) do
--		if (not el:out_of_bounds()) el:update_all(self.abs_pos,self.canv_pos)
		el:calc_pos(self.abs_pos,self.canv_pos)
	end
end

function Canvas:update_all(abs_origin, canv_origin)
	self:calc_pos(abs_origin,canv_origin)

	self:update()
	
	for _,el in pairs(self.elems) do
		el:update_all(self.abs_pos,vec(0,0))
	end
end

function Canvas:reset_canvas()
	self.canvas = userdata("u8",self.w or 1, self.h or 1) + self:get_theme_colour(self.bg_col)
end

function Canvas:draw()
end

function Canvas:draw_canvas()
	self.parent:clip()
	clip(self.parent_canv_pos.x,self.parent_canv_pos.y,self.w,self.h,true)
	self.canvas:blit(get_draw_target(),0,0,self.parent_canv_pos.x,self.parent_canv_pos.y)
end

function Canvas:draw_all()
	if self.redraw_needed then
		self:reset_canvas()
		local pdt = get_draw_target()
		set_draw_target(self.canvas)
		self:draw()
		for _,el in pairs(self.elems) do
			el:calc_pos(self.abs_pos,vec(0,0))
			if not el:out_of_bounds() then
				el:draw_all()
			end
		end
		set_draw_target(pdt)
	end
	self:draw_canvas()
	self.redraw_needed = false
	self.child_requested_redraw = false
end

function Canvas:clip()
	clip(0,0,self.w,self.h)
end

function create_container(attribs)
	local classes = {(attribs.bg_col and Canvas) or Container}
	if (attribs.scrollable) add(classes,Scrollable,1)
	if (attribs.vert_layout) add(classes,VertLayout)
	if (attribs.hor_layout) add(classes,HorLayout)
	
	return create_class(unpack(classes))(attribs)
end

:: lib/xi_gui/elems/checkbox.lua
--[[pod_format="raw",created="2025-03-31 20:35:42",modified="2025-05-28 12:23:58",revision=7690,xstickers={}]]
do

CheckBox = create_class(XiGuiElem,Clickable)

local checked_spr = (
--[[pod_type="gfx"]]unpod("b64:bHo0ACcAAAAlAAAA8BZweHUAQyAIBwRHEBdABwAHMAcQBwAHAAcgBxAHEAcAB0AHAGcA")
)

local unchecked_spr = (
--[[pod_type="gfx"]]unpod("b64:bHo0ABYAAAAUAAAA8AVweHUAQyAHBwR3QBdAF0AXQBdAdw==")
)

function CheckBox:_init(attribs)
	assert(self.callback, "No callback provided when creating checkbox.")

	local l_pad = self.l_pad or 0
	local text  = self.text or ""

	self:apply_defaults{
		l_pad=l_pad,
		w=12+2*l_pad+5*#text,
		h=10,
		text=text,
		text_col="basic_text",
		hover_col="light",
		t_pad=0,
		selected=false,
	}
end

function CheckBox:draw()
	local origin = self.canv_pos
	local sprite = unchecked_spr
	local col = self:get_theme_colour(
		(self.hovered and self.hover_col) or self.text_col
	)
	if self.selected then
		sprite = checked_spr
	end
	pal(7,col)
	spr(sprite,origin.x+self.l_pad,origin.y+self.t_pad)
	pal(7,7)
	print(
		self.text,
		origin.x+10+self.l_pad,
		origin.y+self.t_pad,
		col
	)
end

function CheckBox:lmb_release()
	self.selected = not self.selected
	self:callback(self.selected)
	self:request_redraw(true)
end

function CheckBox:hover()
	get_mouse_listener():set_pointer("pointer")
	if (self.hovered) return
	self.hovered = true
	self:request_redraw(true)
end

function CheckBox:end_hover()
	self.hovered = false
	self:request_redraw(true)
end

end

:: lib/xi_gui/elems/container.lua
--[[pod_format="raw",created="2025-03-27 11:44:55",modified="2025-05-27 11:03:34",revision=18571,xstickers={}]]
Container = create_class(XiGuiElem)

function Container:update_content_size()
	local max_pos = vec(0,0)
	for _,el in pairs(self.elems) do
		local el_pos = el.pos
		max_pos.x = max(el_pos.x+(el.w or 1),max_pos.x)
		max_pos.y = max(el_pos.y+(el.h or 1),max_pos.y)
	end
	self.content_dims = max_pos
	self.content_w = max_pos.x
	self.content_h = max_pos.y
	
	if self.scrollbar then
		self.scrollbar:update_thumb()
	end
	
--	if self.scrollable then
--		self:update_scroll()
--	end
end

function Container:child_height_change()
	self:refresh_height()
	self:update_content_size()
end

function Container:child_width_change()
	self:refresh_height()
	self:update_content_size()
end

function Container:child_moved()
	self:update_content_size()
end

:: lib/xi_gui/elems/drawer.lua
--[[pod_format="raw",created="2025-05-03 12:44:04",modified="2025-05-25 23:09:17",revision=2936]]
do

local function smoothstep(x)
	x = mid(0,x,1)
	return 6*x^5-15*x^4+10*x^3
end

DRAWER_UP = 1
DRAWER_DOWN = 2
DRAWER_LEFT = 3
DRAWER_RIGHT = 4

local handle_pos={
	vec(0,0),
	vec(0,-1),
	vec(0,0),
	vec(-1,0),
}

local contents_pos={
	vec(0,1),
	vec(0,-1),
	vec(1,0),
	vec(-1,0),
}

Drawer = create_class(XiGuiElem)

function Drawer:_init(attribs)
	assert(attribs.w or attribs.w_func, "No width provided when creating drawer.")
	assert(attribs.h or attribs.h_func, "No height provided when creating drawer.")
	assert(attribs.handle_size, "No handle_size provided when creating drawer.")
	assert(attribs.direction, "No direction provided when creating drawer.")
	
	if (attribs.direction == DRAWER_UP or attribs.direction == DRAWER_DOWN) and
		self.h_func
	then
		assert(false,"Cannot have dynamic height in the direction of the drawer")
	end
	if (attribs.direction == DRAWER_LEFT or attribs.direction == DRAWER_RIGHT) and
		self.w_func
	then
		assert(false,"Cannot have dynamic height in the direction of the drawer")
	end

	local contents_w_func, contents_h_func = full_width(), full_height()
	local handle_w_func, handle_h_func = full_width(), full_height()
	local handle_w, handle_h, contents_h, contents_w
	
	if attribs.direction == DRAWER_UP or attribs.direction == DRAWER_DOWN then
		contents_h = self.h-attribs.handle_size
		handle_h = attribs.handle_size
		contents_h_func = nil
		handle_h_func = nil
	else
		contents_w = self.w-attribs.handle_size
		handle_w = attribs.handle_size
		contents_w_func = nil
		handle_w_func = nil
	end

	self:apply_defaults{
		_open=false,
		perc_open=0,
		smooth_open=0,
		handle=create_container{
			w=handle_w,
			h=handle_h,
			w_func=handle_w_func,
			h_func=handle_h_func,
			bg_col = attribs.handle_col,
		},
		contents=create_container{
			w=contents_w,
			h=contents_h,
			w_func=contents_w_func,
			h_func=contents_h_func,
			bg_col = attribs.contents_col,
		},
		frames_to_open=12,
	}
	
	self.needs_refresh = true

	self.handle:add_to(self,handle_pos[self.direction])
	self.contents:add_to(self,contents_pos[self.direction]*self.handle_size)
end

function Drawer:open()
	self._open=true
end

function Drawer:close()
	self._open=false
end

function Drawer:toggle()
	self._open=not self._open
end

function Drawer:refresh_position()
--	if (
--		type(self.contents.h) == "function" or
--		not self.contents.h or
--		type(self.contents.w) == "function" or
--		not self.contents.w or
--		type(self.handle.h) == "function" or
--		not self.handle.h or
--		type(self.handle.w) == "function" or
--		not self.handle.w
--	) then
--		return
--	end
		
	if self.direction == DRAWER_DOWN then
--		self.handle.pos = vec(0,self.smooth_open*self.contents.h)
--		self.contents.pos = self.handle.pos-vec(0,self.contents.h)
		self:update_dims{h=ceil(self.smooth_open*self.contents.h+self.handle.h)}
	elseif self.direction == DRAWER_RIGHT then
--		self.handle.pos = vec(self.smooth_open*self.contents.w,0)
--		self.contents.pos = self.handle.pos-vec(self.contents.w,0)
		self:update_dims{w=ceil(self.smooth_open*self.contents.w+self.handle.w)}
	elseif self.direction == DRAWER_UP then
--		self.handle.pos = vec(0,(1-self.smooth_open)*self.contents.h)
--		self.contents.pos = self.handle.pos+vec(0,self.handle.h)
		self:update_dims{h=ceil(self.smooth_open*self.contents.h+self.handle.h)}
	elseif self.direction == DRAWER_LEFT then
--		self.handle.pos = vec((1-self.smooth_open)*self.contents.w,0)
--		self.contents.pos = self.handle.pos+vec(self.handle.w,0)
		self:update_dims{w=ceil(self.smooth_open*self.contents.w+self.handle.w)}
	end
	self.needs_refresh = false
	self:request_redraw(true)
end

function Drawer:update_all(abs_origin,canv_origin)
	self:update()

	self:calc_pos(abs_origin,canv_origin)

	local to_update = {self.handle}
	if self.perc_open > 0 then
		add(to_update, self.contents)
	end

	for el in all(to_update) do
		el:update_all(self.abs_pos,self.canv_pos)
	end
end

function Drawer:draw_all()
	self:clip()
--	rectfill(0,0,480,270,30)
	local to_draw = {self.handle}
	if self.perc_open > 0 then
		add(to_draw, self.contents)
	end
	
	for _,el in pairs(to_draw) do
		el:draw_all()
	end
	
end

function Drawer:update()
	if self.needs_refresh then
		self.smooth_open = smoothstep(self.perc_open)
		self:refresh_position()
	end

	if (
		(self._open and self.perc_open == 1) or
		(not self._open and self.perc_open == 0)
	) then
		return
	end
	
	if self._open then
		self.perc_open = min(self.perc_open+1/self.frames_to_open,1)
	else
		self.perc_open = max(self.perc_open-1/self.frames_to_open,0)
	end
	
	self.smooth_open = smoothstep(self.perc_open)
	
	self:refresh_position()
end

end

:: lib/xi_gui/elems/dropdown.lua
--[[pod_format="raw",created="2025-05-05 18:06:02",modified="2025-05-22 15:11:22",revision=1285]]
do

Dropdown=create_class(_SolidBtn)

local DropdownMenu=create_class(XiGuiElem,Clickable)

function Dropdown:_init(attribs)
	assert(attribs.options,"options required to create a dropdown.")
	assert(attribs.callback,"callback required to create a dropdown.")

	local max_l = 0
	for o in all(attribs.options) do
		max_l = max(max_l,#o)
	end
	
	local h_pad, v_pad = attribs.h_pad or 4, attribs.v_pad or 2

	self:apply_defaults{
		cur_option=self.options[1],
		w=max_l*5+2*h_pad+10,
		h=8+2*v_pad,
		h_pad=h_pad,
		v_pad=v_pad,
		text_col="basic_text",
		filled=false,
	}
end

function DropdownMenu:_init(attribs)
	local options = {}
	
	for op in all(attribs.options) do
		if op != attribs.excluded then
			add(options,op)
		end
	end
	
	self.options = options

	self:apply_defaults{
		h=#self.options*10+2,
		text_col="basic_text",
		z=10,
	}
end

local dd_icon = (
--[[pod_type="gfx"]]unpod("b64:bHo0ABMAAAARAAAA8AJweHUAQyAFBARHACcQJyAHEA==")
)

function DropdownMenu:draw()
	local pos = self.canv_pos
	local bg_col = self:get_theme_colour(self.bg_col)
	local hover_col = self:get_theme_colour(self.hover_col)
	local text_col = self:get_theme_colour(self.text_col)
	
	rectfill(
		pos.x,pos.y,
		pos.x+self.w-1,pos.y+self.h-1,
		bg_col
	)
	
	if self.hovered then
		rectfill(
			pos.x,pos.y+(self.hovered-1)*10+1,
			pos.x+self.w-1,pos.y+self.hovered*10,
			hover_col
		)
	end
	
	line(
		pos.x,pos.y+self.h-1,
		pos.x+self.w-1,pos.y+self.h-1,
		hover_col
	)
	
	line(
		pos.x,pos.y,
		pos.x+self.w-1,pos.y,
		hover_col
	)
	local y = pos.y+2
	for i,op in pairs(self.options) do
		local c = text_col
		if (i == self.hovered) c = bg_col
		print(op,pos.x+self.h_pad,y,c)
		y+=10
	end
end

function DropdownMenu:hover()
	Mouse:set_pointer("pointer")
	local cur_hovered = self.hovered
	self.hovered = (Mouse.pos.y-self.abs_pos.y)//10+1
end

function DropdownMenu:lmb_release()
	self.dd_parent:request_redraw(true)
	self:remove()
	self.dd_parent.menu=nil
	if self.options[self.hovered] != nil then
		self.dd_parent.cur_option = self.options[self.hovered]
		self.dd_parent:callback(self.options[self.hovered])
	end
end

function DropdownMenu:end_hover()
	self.hovered=nil
end

function Dropdown:toggle()
	if self.menu then
		self:close()
	else
		self:open()
	end
end

function Dropdown:is_open()
	return self.menu != nil
end

function Dropdown:open()
	if self:is_open() then return end
	local pos = self.abs_pos+vec(0,self.h)
	
	local h = (#self.options-1)*10+2
	
	if pos.y+h >= self:get_gui().h  then
		pos = self.abs_pos-vec(0,h)
	end
	
--	notify(pos.y+h..", "..self:get_gui().h)
	
	self.menu = DropdownMenu{
		w=self.w,
		options=self.options,
		excluded=self.cur_option,
		bg_col=self.bg_col,
		hover_col=self.hover_col,
		click_col=self.click_col,
		dd_parent=self,
		h_pad=self.h_pad
	}:add_to(self:get_gui(),pos)
	
	self.cur_col = self.hover_col
end


function Dropdown:close()
	if not self:is_open() then return end
	self.menu:remove()
	self.menu=nil
	self.cur_col = self.bg_col
end

function Dropdown:update()
	_Btn.update(self)

	if (
		self:is_open() and 
		Mouse.lmb:clicked() and
		not get_mouse_listener():is_in(self.menu:get_rect()) and
		not get_mouse_listener():is_in(self:get_rect())
	) then
		self:close()
	end
end

function Dropdown:lmb_release()
	if not self.enabled then return end

	if not self.selected then
		self.cur_col = self.click_col
	end
	get_mouse_listener():set_pointer("pointer")
	self:toggle()
end

function Dropdown:draw()
	local pos = self.canv_pos
	local cur_colour = self:get_theme_colour(self.cur_col)
	local df = rect
	
	if (self.filled) rect = rectfill
	
	df(
		pos.x,pos.y,
		pos.x+self.w-1,pos.y+self.h-1,
		cur_colour
	)
	rectfill(
		pos.x+self.w-9,pos.y,
		pos.x+self.w-1,pos.y+self.h-1,
		cur_colour
	)
	
	pal(7,self:get_theme_colour("bg"))
	spr(dd_icon,pos.x+self.w-7,pos.y+self.v_pad+2)
	pal(7,7)
	
	print(
		self.cur_option,
		pos.x+self.h_pad,
		pos.y+self.v_pad,
		self:get_theme_colour(self.text_col)
	)
end



end

:: lib/xi_gui/elems/gfx_tooltip.lua
--[[pod_format="raw",created="2025-05-15 19:20:54",modified="2025-05-25 22:12:50",revision=579]]
do

GFXTooltip=create_class(Tooltip)

function GFXTooltip:_init(attribs)
	assert(attribs.title,"No title specified when creating gfx tooltip.")
	assert(attribs.spritesheet,"No spritesheet specified when creating gfx tooltip.")
	
	self.w=max(self.w,8*16+8)
	self.h=62
end

function GFXTooltip:draw()
	local pos = self.canv_pos
	local y = pos.y+2
	rectfill(
		pos.x,pos.y,pos.x+self.w-1,pos.y+self.h-1,self:get_theme_colour(self.bg_col)
	)
	rect(
		pos.x,pos.y,pos.x+self.w-1,pos.y+self.h-1,self:get_theme_colour(self.border_col)
	)
	if self.title then
		print(self.title,pos.x+6,y,self:get_theme_colour(self.title_col))
		y += 10
	end
	
	for j = 0,2 do
		for i = 0,7 do
			self:draw_icon(self.spritesheet[i+j*8].bmp,pos.x+4+i*16,y)
		end
		y+=16
	end
end

function GFXTooltip:draw_icon(bmp,x,y)
	local scale = 1
	local ww,hh = bmp:width(), bmp:height()
	-- to do: this makes very thin bmps invisible in preview
	scale = 16 / max(ww,hh)
	if (scale >= 1) then
		scale = scale \ 1
	elseif (scale >= 0.666) then
		scale = 1 -- up to 24x24, still show pixel for pixel
	end
--	clip(self.sx + x*16, self.sy + y*16, 16,16)
	rectfill(x,y,x+15,y+15,0)
	sspr(bmp,
		0,0,nil,nil,
		x + 8 - ww * scale/2,
		y + 8 - hh * scale/2,
		ww*scale, hh*scale
	)
end

end
:: lib/xi_gui/elems/hor_layout.lua
--[[pod_format="raw",created="2025-03-28 07:09:58",modified="2025-05-21 16:48:08",revision=2350]]
do

local HorLayout={
}

function HorLayout:refresh_content_position()
	local rows = {
		{
			y=self.t_pad,
			max_height=0,
		},
	}
	local x = self.l_pad
	local cur_row = rows[1]
	
	for e in all(self.elems) do
		if self.wrap and x+e.w+self.l_pad > self.w then
			x = self.l_pad
			add(rows,
				{
					y = cur_row.y+cur_row.max_height+self.gap_size,
					max_height = 0
				}
			)
			cur_row = rows[#rows]
		end
		add(cur_row, e)
		x+=self.gap_size+e.w
		cur_row.max_height = max(cur_row.max_height,e.h)
	end
	
	for row in all(rows) do
		x = self.l_pad
		for e in all(row) do
			e.pos = vec(x,row.y+(row.max_height-e.h)/2)
			x+=self.gap_size+e.w
		end
	end
end

function HorLayout:self_width_change()
	self:refresh_content_position()
end

function HorLayout:child_height_change()
	self:refresh_height()
	self:refresh_content_position()
end

function HorLayout:child_width_change()
	self:refresh_width()
	self:refresh_content_position()
end

function create_hor_layout(attribs)
	-- Clips contents to size
	-- Required attributes:
	-- w, h: width, height
	-- Optional attributes:
	-- bg_col: background colour name
	-- gap_size: gap size between items
	-- l_pad: left pad
	-- t_pad: top pad
	-- wrap: whether columns should wrap
	-- draggable: whether it can be dragged
	
	assert(attribs.w, "No width provided when creating horizontal layout.")
	assert(attribs.h, "No height provided when creating horizontal layout.")

	merge_template(attribs,
		{
			gap_size=0,
			l_pad=0,
			t_pad=0,
			wrap=false,
		}
	)

	return create_new_elem(HorLayout,attribs,create_container)
end

end
:: lib/xi_gui/elems/icon_button.lua
--[[pod_format="raw",created="2025-03-27 12:49:01",modified="2025-05-25 22:12:50",revision=5269]]
do

IconBtn = create_class(_SolidBtn)

function IconBtn:_init(attribs)
	-- Required attributes:
	-- sprite: sprite to display
	-- callback: function to call when button
	-- 	is pressed. No arguments are
	-- 	passed to the funciton.
	-- Optional attributes:
	-- pos: vec containing position on screen
	--	     relative to parent
	-- w, h: width, height
	-- bg_col, hover_col, click_col:
	-- 	colour names
	-- v_pad, h_pad: padding around icon
	-- selected: true, false or function
	
	assert(attribs.sprite, "No sprite provided when creating text button.")
	assert(attribs.callback, "No callback provided when creating text button.")
	
	local spr_w, spr_h = get_spr(attribs.sprite):attribs()
	local h_pad = attribs.h_pad or 2
	local v_pad = attribs.v_pad or 2
	
	self:apply_defaults{
		w=spr_w+2*h_pad,
		h=spr_h+2*v_pad,
		disabled_icon_col="middle",
		r=0,
		recol={},
		h_pad=2,
		v_pad=2,
	}
end

function IconBtn:draw()
	local pos = self.canv_pos
	local cur_col = self:get_theme_colour(self.cur_col)
	
	rrectfill(pos.x,pos.y,self.w,self.h,self.r,cur_col)
	if self.enabled then
		for o,n in pairs(self.recol) do
			pal(o,self:get_theme_colour(n))
		end
		pal(cur_col,self:get_theme_colour("bg"))
	else
		pal(7,self:get_theme_colour(self.disabled_icon_col))
	end
	spr(self.sprite, pos.x+self.h_pad, pos.y+self.v_pad)
	pal(cur_col,cur_col)
	pal(7,7)
	for o,n in pairs(self.recol) do
		pal(o,o)
	end
end

RoundedIconBtn = create_class(_Btn)

function RoundedIconBtn:_init(attribs)
	-- Required attributes:
	-- sprite: sprite to display
	-- callback: function to call when button
	-- 	is pressed. No arguments are
	-- 	passed to the funciton.
	-- Optional attributes:
	-- pos: vec containing position on screen
	--	     relative to parent
	-- w, h: width, height
	-- bg_col, hover_col, click_col:
	-- 	colour names
	-- v_pad, h_pad: padding around icon
	-- selected: true, false or function
	
	assert(attribs.sprite, "No sprite provided when creating text button.")
	assert(attribs.callback, "No callback provided when creating text button.")
	
	local spr_w, spr_h = get_spr(attribs.sprite):attribs()
	local h_pad = attribs.h_pad or 2
	local v_pad = attribs.v_pad or 2
	
	self:apply_defaults{
		w=spr_w+2*h_pad,
		h=spr_h+2*v_pad,
		disabled_icon_col="middle",
		r=1,
		h_pad=2,
		v_pad=2,
	}
end

function RoundedIconBtn:draw()
	local pos = self.canv_pos
	local cur_col = self:get_theme_colour(self.cur_col)
	
	rrectfill(pos.x,pos.y,self.w,self.h,self.r,cur_col)
	if self.enabled then
		pal(cur_col,self:get_theme_colour("bg"))
	else
		pal(7,self:get_theme_colour(self.disabled_icon_col))
	end
	spr(self.sprite, pos.x+self.h_pad, pos.y+self.v_pad)
	pal(cur_col,cur_col)
	pal(7,7)
end

end

:: lib/xi_gui/elems/label.lua
--[[pod_format="raw",created="2025-03-28 07:29:23",modified="2025-05-22 15:11:22",revision=4313]]
Label=create_class(XiGuiElem)

function Label:_init(attribs)
	-- Required attributes:
	-- text: text to display
	-- Optional attributes:
	-- text_col: text colour name
	
	assert(self.text, "No text provided when creating label.")
	
	if attribs.small_text then
		self:apply_defaults{
			w=#attribs.text*4+2,
			h=7,
			l_pad=0,
			t_pad=1,
			text_col="basic_text",
			pref="\014",
		}
	else
		self:apply_defaults{
			text_col="basic_text",
			h=10,
			w=#attribs.text*5+2,
			l_pad=0,
			t_pad=0,
			pref="",
		}
	end
end

function Label:set_text(text)
	if text == self.text then return end

	self.text=text
	
	local nw = print(self.text,0,-1000)
	if nw and nw != self.w then
		self:update_dims{w=nw}
	end
	
	self:request_redraw(true)
end

function Label:draw()
	print(self.pref..self.text,self.canv_pos.x+self.l_pad,self.canv_pos.y+self.t_pad,self:get_theme_colour(self.text_col))
end

:: lib/xi_gui/elems/perf.lua
--[[pod_format="raw",created="2025-05-21 10:51:29",modified="2025-05-27 09:44:09",revision=3082,xstickers={}]]
do

PerfTracker = create_class(XiGuiElem,Draggable)

local min_icon = (
--[[pod_type="gfx"]]unpod("b64:bHo0ABgAAAAWAAAA8AdweHUAQyAHBwR3QBdAFwAnABdAF0B3")
)
local max_icon = (
--[[pod_type="gfx"]]unpod("b64:bHo0ABwAAAAaAAAA8AtweHUAQyAHBwR3QBcQBxAXACcAFxAHEBdAdw==")
)

function PerfTracker:_init(attribs)
	self:apply_defaults{
		h=31,
		w=90,
		update_log = userdata("f64",1,61),
		draw_log = userdata("f64",1,60),
		bg_col=1,
		z=100,
		hidden=false
	}
	
	self.hide_btn=IconBtn{
		w=7,
		h=7,
		h_pad=0,
		v_pad=0,
		base_col = 1,
		hover_col= 16,
		click_col=12,
		sprite=min_icon,
		callback=function(bt)
			self.hide=not self.hide
			if self.hide then
				bt.sprite = max_icon
			else
				bt.sprite = min_icon
			end
			bt:request_redraw(true)
		end
	}:add_to(self,vec(-1,0))
end

function PerfTracker:log_draw()
	self.draw_log:set(0,0,self.draw_log:get(0,1,59))
	self.draw_log:set(0,59,stat(1)/0.9*100)
--	assert(false,self.draw_log:get(0,0))
end

function PerfTracker:log_update()
	self.update_log:set(0,0,self.update_log:get(0,1,60))
	self.update_log:set(0,60,stat(1)/0.9*100)
end

function PerfTracker:update()
	self:request_redraw(true)
end

function PerfTracker:draw()
	self:log_draw()

	if (self.hide) return
--	if (Mouse:is_in(self:get_rect())) return

	local pos = self.canv_pos
	rectfill(pos.x,pos.y,pos.x+self.w,pos.y+self.h,self:get_theme_colour(self.bg_col))
	rect(pos.x,pos.y,pos.x+self.w-1,pos.y+self.h-1,7)
	
	local scrn = {
		pos = pos+vec(2,3),
		w=50,
		h=25
	}
	
	local mx = flr(long_max(self.draw_log:column(0):get()))
	local c = 3
	
	if mx > 100 then
		c = 8
	elseif mx > 50 then
		c = 9
	end
	
	print("\014"..chr(150)..mx.."%",pos.x+56,pos.y+5,c)
	
	stat(0)
	
	print("\014"..(flr(stat(3)/1024^2*100)/100).."mb",pos.x+56,pos.y+13,6)
	
	fps = flr(stat(7))
	if fps == 60 then
		c=3
	elseif fps == 30 then
		c = 9
	else
		c = 8
	end
	
	print("\014".."fps: "..fps,pos.x+56,pos.y+21,c)
	
	rectfill(scrn.pos.x,scrn.pos.y,scrn.pos.x+scrn.w-1,scrn.pos.y+scrn.h-1,0)
	
	clip(scrn.pos.x,scrn.pos.y,scrn.w,scrn.h, true)
	
--	line(scrn.pos.x,scrn.pos.y+12,scrn.pos.x+scrn.w-1,scrn.pos.y+12,13)

--	assert(self.draw_log:get(0,279)==0,draw_lines:get(0,w-1))
	rectfill(get_batch_rect_args(scrn,self.draw_log,25))
	rectfill(get_batch_rect_args(scrn,self.update_log,16))
	
	for i = 0,4 do
		pset(scrn.pos.x,scrn.pos.y+25/4*i,7)
	end
--	line(draw_lines:get(0,w-1),draw_lines:get(1,w-1),draw_lines:get(2,w-1),draw_lines:get(3,w-1),8)
--	line(439,227,439,224,8)
end

function long_max(...)
	local m = nil
	for v in all({...}) do
		if m == nil or m < v then m = v end
	end
	return m
end

function get_batch_rect_args(scrn,ud,col)
	local w = 60
	local draw_lines = userdata("f64", 5, w)
	
	local x = userdata("f64", 1, w) + 1
	x:add(x,true,0,1)
	x += scrn.pos.x-1
	
	x:blit(draw_lines,0,0,0,0)
	x:blit(draw_lines,0,0,2,0)
	
	local top = userdata("f64", 1, w)+scrn.pos.y+scrn.h-1
	
--	assert(false,self.top:height())
	
	top = top - ud/4
	
	top:blit(draw_lines,0,0,1,0)
	
	local btm = userdata("f64", 1, w)+scrn.pos.y+scrn.h-1
	
	btm:blit(draw_lines,0,0,3,0)
	
	local col = userdata("f64", 1, w) + col
	
	col:blit(draw_lines,0,0,4,0)
	
	return draw_lines
end

end

:: lib/xi_gui/elems/scrollbar.lua
--[[pod_format="raw",created="2025-04-06 12:25:17",modified="2025-05-28 12:23:58",revision=20398,xstickers={}]]
do

ScrollBar=create_class(XiGuiElem, Clickable)

function ScrollBar:_init(attribs)
	self:apply_defaults{
		w=5,
		h=10,
		h_func=full_height(),
		thumb_col="middle",
		r_pad=0,
		thumb = {
			pos=vec(0,0),
			h=3,
			w=attribs.thumb_w or attribs.w or 5,
		},
		thumb_w=attribs.w or 5,
		special_typ = "scrollbar",
		held_for = 0,
	}
	self.w += self.r_pad
	self.timer = 0
end


function ScrollBar:hover()
	if self.hide then return end

	local mse = get_mouse_listener()
	local pos = self.abs_pos
	
	if mse:is_in({
		pos=self.thumb.pos+pos,
		h=self.thumb.h,
		w=self.thumb.w,
	}) then
		get_mouse_listener():set_pointer("grab")
	else
		get_mouse_listener():set_pointer("pointer")
	end
end

function ScrollBar:lmb_click()
	if self.hide then return end
	
	local pos = self.abs_pos
	
	if Mouse:is_in({
		pos=self.thumb.pos+pos,
		h=self.thumb.h,
		w=self.thumb.w,
	}) then
		Mouse:set_pointer("grab")
		self.thumb_hold_start = get_mouse_listener().pos.y
		self.scroll_start = self.thumb.pos.y
		self:fix_hold()
	else
		Mouse:set_pointer("pointer")
		if Mouse.pos.y > self.thumb.pos.y+pos.y then
			self.parent.scroll_target.y += 200
		else
			self.parent.scroll_target.y -= 200
		end
		self.thumb_hold_start = nil
		self.scroll_start = nil
	end
end

function ScrollBar:lmb_release()
	self.thumb_hold_start = nil
	self.scroll_start = nil
end

function ScrollBar:lmb_hold()
	if self.hide then return end

	local mse = get_mouse_listener()
	local pos = self.abs_pos
	
	if self.thumb_hold_start then
		Mouse:set_pointer("grab")
		self.thumb.pos.y = mid(
			self.scroll_start + mse.pos.y - self.thumb_hold_start,
			0,
			self.h-self.thumb.h
		)
		local denom = (self.h-self.thumb.h)
--		denom = max(1,denom)
		self.parent.scroll_target.y = (
			(self.parent.content_h-self.parent.h+self.parent.b_pad)*self.thumb.pos.y/denom
		)
	elseif mse:is_in({
		pos=self.thumb.pos+pos,
		h=self.thumb.h,
		w=self.thumb.w,
	}) then
		get_mouse_listener():set_pointer("grab")
		self.thumb_hold_start = get_mouse_listener().pos.y
		self.scroll_start = self.thumb.pos.y
		self:fix_hold()
		self.held_for = 0
	else
		get_mouse_listener():set_pointer("pointer")
		self.held_for += 1
			if self.held_for > 15 and self.held_for % 8 == 0 then
				if mse.pos.y > self.thumb.pos.y+pos.y then
				self.parent.scroll_target.y += 200
			else
				self.parent.scroll_target.y -= 200
			end
		end
	end
	
	self.parent:update_scroll()
end

--function ScrollBar:add_to(parent,pos,index)
--	if self.parent then self:remove() end
--	
--	if self.mse_last_frame != XG_HELD then
--		self.held_for = 0
--		self.thumb_hold_start = nil
--		self.scroll_start = nil
--	end
--
--	self.parent = parent
--	self.pos = pos or vec(0,0)
--	self:calc_z()
--	
--	index = index or #parent.elems+1
--	
--	add(parent.elems,self,index)
--
--	self:parent_width_change()
--	self:parent_height_change()
--	self.parent:child_width_change()
--	self.parent:child_height_change()
--	
--	self.parent.scrollbar = self
--	
--	return self
--end

function ScrollBar:update_thumb()
	if (not self.parent) return
	
	self:self_moved()

	if self.parent.content_h + (self.parent.b_pad or 0) <= self.parent.h then
		self.hide = true
		return
	else
		self.hide = false
	end
	
	if (not self.h) then
		self:request_redraw(true)
		return
	end

	local th = mid(
		self.h*self.parent.h / self.parent.content_h,
		self.h-4,
		7
	)
	local remain = self.h-th
	local offset = remain * self.parent.scroll.y/(self.parent.content_h-self.parent.h+(self.parent.b_pad or 0))
	
	self.thumb = {
		pos=vec(0,offset),
		h=ceil(th),
		w=self.thumb_w,
	}
	
	self:request_redraw(true)
end

function ScrollBar:after_added()
	self:update_thumb()
end

function ScrollBar:parent_height_change()
	self:refresh_height()
	self:update_thumb()
	self.timer = 15
end

function ScrollBar:draw()
	local pos = self.canv_pos

	if (self.hide) return
	
	if self.bg_col then
		rectfill(
			pos.x,
			pos.y,
			pos.x+self.w-1,
			pos.y+self.h-1,
			self:get_theme_colour(self.bg_col)
		)
	end
	
	if (not self.thumb) return
	
--	if text_ed and self.parent == text_ed.bookmark_box then
--		assert(false,self.thumb.h)
--	end
	
	local tc = self:get_theme_colour(self.thumb_col)
	
	rectfill(
		pos.x+self.thumb.pos.x+1,
		pos.y+self.thumb.pos.y,
		pos.x+self.thumb.pos.x+self.thumb.w-2,
		pos.y+self.thumb.pos.y+self.thumb.h-1,
		tc
	)
	rectfill(
		pos.x+self.thumb.pos.x,
		pos.y+self.thumb.pos.y+1,
		pos.x+self.thumb.pos.x+self.thumb.w-1,
		pos.y+self.thumb.pos.y+self.thumb.h-2,
		tc
	)
end


end

:: lib/xi_gui/elems/sprite.lua
--[[pod_format="raw",created="2025-03-31 13:08:53",modified="2025-05-26 19:27:07",revision=2480,xstickers={}]]
do

Sprite=create_class(XiGuiElem)

function Sprite:_init(attribs)
	-- Required attributes:
	-- sprite: text to display
	
	assert(attribs.sprite, "No sprite provided when creating sprite elements.")
	
	local w,h = get_spr(attribs.sprite):attribs()
	
	self:apply_defaults{h=h,w=w,recol={}}
end

function Sprite:draw()
	local pos = self.canv_pos
	if self.hide then return end

	local w,h = get_spr(self.sprite):attribs()
	pos += vec((self.w-w)/2,(self.h-h)/2)
	
	for o_col,n_col in pairs(self.recol) do
		pal(o_col,self:get_theme_colour(n_col))
	end
	spr(self.sprite,pos.x,pos.y)
	for o_col,n_col in pairs(self.recol) do
		pal(o_col,o_col)
	end
end

end
:: lib/xi_gui/elems/sprite_button.lua
--[[pod_format="raw",created="2025-05-05 14:45:05",modified="2025-05-26 19:26:59",revision=587,xstickers={}]]
do

SpriteBtn = create_class(_Btn)

function SpriteBtn:_init(attribs)
	-- Required attributes:
	-- sprite: sprite to display
	-- callback: function to call when button
	-- 	is pressed. No arguments are
	-- 	passed to the funciton.
	-- Optional attributes:
	-- pos: vec containing position on screen
	--	     relative to parent
	-- w, h: width, height
	-- bg_col, hover_col, click_col:
	-- 	colour names
	-- v_pad, h_pad: padding around icon
	-- selected: true, false or function
	
	assert(attribs.sprite, "No sprite provided when creating text button.")
	assert(attribs.callback, "No callback provided when creating text button.")
	
	local s = attribs.sprite
	if type(s) != "userdata" then
		s = get_spr(s)
	end
	
	local spr_w, spr_h = s:attribs()
	local h_pad = attribs.h_pad or 0
	local v_pad = attribs.v_pad or 0
	
	self:apply_defaults{
		w=spr_w+2*h_pad,
		h=spr_h+2*v_pad,
		disabled_icon_col="middle",
		h_pad=0,
		v_pad=0,
		sprite_bg_col=1
	}
end

function SpriteBtn:draw()
	local pos = self.canv_pos
	local cur_col = self:get_theme_colour(self.cur_col)
	pal(self.sprite_bg_col,cur_col)
	if self.enabled then
--		pal(cur_col,self:get_theme_colour("bg"))
	else
		pal(7,self:get_theme_colour(self.disabled_icon_col))
	end
	spr(self.sprite, pos.x+self.h_pad, pos.y+self.v_pad)
--	pal(cur_col,cur_col)
	pal(self.sprite_bg_col,self.sprite_bg_col)
	pal(7,7)
end

end

