--		w=20,
--		vert_layout=true,
--		align=ALIGN_CENTRE,
--		gap_size=2,
--		l_pad=0,
--		scrollable=true,
--		scroll_args={
--			thumb_col="light",
--			r_pad=7,
--			w=4,
--		},
--		bg_col="middle",
--		t_pad=2,
--	}:add_to(self.sticker_drawer.contents)
--	
--	for i = 0,7 do
--		StickerBtn{
--			sprite = STICKERS[i].bmp,
--			sprite_bg_col = 30,
--			callback=function()
--				local s = self:add_sticker(i)
--				s:update_dims{pos=Mouse.pos-vec(s.sprite:width(),s.sprite:height())/2+vec(self.scroll.x,self.scroll.y)}
--				s.offset=vec(self.scroll.x,self.scroll.y)*-1
--				s:lmb_click()
--	--			s:fix_hold()
--				self.sticker_drawer:close()
--			end,
--			base_col=7
--		}:add_to(self.sticker_box)
--	end
	
	create_bookmark_drawer(self, self.bookmark_top or 0)
	
	if attribs.show_bookmarks then
		self.bookmark_drawer:open()
	end
	
	if self.searchable then
		self:add_search_boxes()
	end
	
	if self.todos then
		create_todo_drawer(self, self.bookmark_top or 0)
	end
	
	if self.scrollable then
		local scroll_args = self.scroll_args or {}
		scroll_args.b_pad=50
		self.scrollbar = ScrollBar(scroll_args)
	end
end

function TextEditor:add_search_boxes()
	self.ln_drawer = Drawer{
		h = 29,
		w = 100,
		contents_col="middle",
		handle_size=12,
		direction=DRAWER_UP,
		z=10,
	}:add_to(self,vec(-30,-1))
	
	RoundedIconBtn{
		sprite=ln_sprite,
		callback=function()
			self.ln_drawer:toggle()
			if self.ln_drawer._open then
				self.search_drawer:close()
			end
		end,
		w=15,
		h=15,
		h_pad=3,
		v_pad=2,
		r=3,
	}:add_to(self.ln_drawer.handle,vec(-1,0))
	
	local goto_btn = TextBtn{
		text="Goto ln #",
		callback=function()
			local ln_n = tonum(self.goto_textbox:get_text())
			if ln_n then
				ln_n = flr(ln_n)
				self.content.selection=nil
				self.content.crs:move_to(1,ln_n)
				self.content.crs:move_to(#self.content.crs:get_ln().text+1)
				self:jump_to_cursor()
				self:set_focus()
				self:request_redraw(true)
			else
				notify("Didn't recognise '"..self.goto_textbox:get_text().."' as a number.")
			end
		end,
		bg_col="light",
		hover_col="highlight",
		click_col="light",
	}:add_to(self.ln_drawer.contents,vec(2,3))
	
	self.goto_textbox = TextEditor{
		w=100-6-goto_btn.w,
		h=13,
		t_pad=3,
		l_pad=3,
		single_line=true,
		enter_callback=function()
			local ln_n = tonum(self.goto_textbox:get_text())
			if ln_n then
				ln_n = flr(ln_n)
				self.content.crs:move_to(1,ln_n)
				self.content.crs:move_to(#self.content.crs:get_ln().text+1)
				self:jump_to_cursor()
				self:set_focus()
				self:request_redraw(true)
				self.ln_drawer:close()
			else
				notify("Didn't recognise '"..self.goto_textbox:get_text().."' as a number.")
			end
		end,
		tab_callback=function() self:set_focus() end,
	}:add_to(self.ln_drawer.contents,vec(4+goto_btn.w,2))
	
	self.search_drawer = Drawer{
		h = 45,
		w = 120,
		contents_col="middle",
		handle_size=12,
		direction=DRAWER_UP,
		z=15,
	}:add_to(self,vec(-10,-1))
	
	RoundedIconBtn{
		sprite=search_sprite,
		callback=function()
			self.search_drawer:toggle()
			if self.search_drawer._open then
				self.ln_drawer:close()
			end
		end,
		w=15,
		h=15,
		r=3,
		h_pad=3,
		v_pad=2,
	}:add_to(self.search_drawer.handle,vec(-1,0))
	
	local find_btn = TextBtn{
		text="Find",
		callback=function()
			self:perform_find()
			self:set_focus()
		end,
		base_col="light",
		hover_col="highlight",
		click_col="light",
		r=1
	}:add_to(self.search_drawer.contents,vec(2,3))
	
	self.find_textbox = TextEditor{
		w=120-6-find_btn.w,
		h=13,
		t_pad=3,
		l_pad=3,
		single_line=true,
		enter_callback=function() self:perform_find() end,
		tab_callback=function() self:set_focus() end,
	}:add_to(self.search_drawer.contents,vec(4+find_btn.w,2))
	
	local replace_btn = TextBtn{
		text="Replace",
		callback=function()
			self:perform_replace()
			self:set_focus()
		end,
		base_col="light",
		hover_col="highlight",
		r=1
	}:add_to(self.search_drawer.contents,vec(2,19))
	
	self.replace_textbox = TextEditor{
		w=120-6-replace_btn.w,
		h=13,
		t_pad=3,
		l_pad=3,
		single_line=true,
		enter_callback=function() self:perform_replace() end,
		tab_callback=function() self:set_focus() end,
	}:add_to(self.search_drawer.contents,vec(4+replace_btn.w,18))
end

function TextEditor:set_word_wrap(val)
	self.word_wrap = val
	self.content.line_refresh_needed=true
	self:request_redraw(true)
end

function TextEditor:jump_to_cursor()
	local ln = self.content.crs:get_ln()
	local x = print(sub(ln.text,0,self.content.crs.xpos-1),0,-1000)
	
	local scrl_x = mid(
		self.scroll_target.x,
		x-50,
		x-self.w+min(100,self.w/2)
	)
	
	if self.w*0.8 >= self.content_w or scrl_x < 0 then
		scrl_x = 0
	end
	
	local scrl_y = mid(
		self.scroll_target.y,
		ln.btm-30,
		ln.top-self.h+30
	)
	
	if self.content_h < self.h*0.8 or scrl_y < 0 then
		scrl_y = 0
	end
	
	self.scroll_target = vec(scrl_x,scrl_y)
end

function TextEditor:binary_search_top_ln(low, high)
	local arr = self.content.lns
	local x = self.scroll.y
	low = low or 1
	high = high or #arr

	if low > high then
		return {max(low,1), 0}
	end
	
	local midd = (low + high) // 2 
	if x < arr[midd].top and x >= arr[midd].btm then
		return {midd, arr[midd].btm-x}
	elseif x > arr[midd].top then
		return self:binary_search_top_ln(midd + 1, high)
	else
		return self:binary_search_top_ln(low, midd - 1)
	end
end

function TextEditor:self_width_change()
	self.changed_width = true
	if self.word_wrap then
		self.content.line_refresh_needed = true
	end
end

function TextEditor:self_height_change()
	self.changed_height = true
end

function TextEditor:get_content_size()
	return self.content.w, self.content.h
end

function TextEditor:get_text()
	return self.content:get_text()
end

function TextEditor:create_crs_at_mse()
	local mse = get_mouse_listener()
	local pos = self.abs_pos
	local x = pos.x+self.l_pad-self.scroll.x
	if self.show_ln_ns then
		x+=self.ln_n_width
	end
	if (self.monospace) then
		x-=self.l_pad
		x=print("	",x,-1000)
	end
	
	local base_x = x
	local xpos = 1
	local y = self.t_pad + self.top_offset + pos.y
	local ln_n = self.ln_at_top
	local pref_pos = nil
	
	while ln_n <= #self.content.lns and y+self.content.lns[ln_n].h < mse.pos.y do
		y += self.content.lns[ln_n].h
		ln_n += 1
	end
	if ln_n > #self.content.lns then
		return create_cursor(self.content,#self.content.lns,#self.content.lns[#self.content.lns].text+1)
	end
	
	local ln = self.content.lns[ln_n]
	
	if self.word_wrap and ln.wrapped_lines and not self.highlight_syntax then
		local sub_ln_n = 1
		while sub_ln_n <= #ln.wrapped_lines and y+ln.wrapped_lines[sub_ln_n].h < mse.pos.y do
			y += ln.wrapped_lines[sub_ln_n].h
			xpos+=#ln.wrapped_lines[sub_ln_n].text+1
			sub_ln_n += 1
		end
		if sub_ln_n > #ln.wrapped_lines then
			return create_cursor(self.content,ln_n,#self.content.lns[ln_n].text+1)
		end
		local wrapped_ln = ln.wrapped_lines[sub_ln_n]
		local wrapped_xpos=1
		local ix = x
		while x < mse.pos.x and wrapped_xpos <= #wrapped_ln.text do
			x=print(sub(wrapped_ln.text,0,wrapped_xpos),ix,-1000)
			wrapped_xpos+=1
		end
		if x > mse.pos.x then
			wrapped_xpos-=1
		end
		if wrapped_xpos < 1 then wrapped_xpos = 1 end
		xpos+=wrapped_xpos-1
		pref_pos=wrapped_xpos
	else
		local lnt = ""
		while x < mse.pos.x and xpos <= #ln.text do
			lnt = lnt .. ln.text[xpos]
			x=print(lnt,base_x,-1000)
			xpos+=1
		end
		if x > mse.pos.x then
			xpos-=1
		end
		if xpos < 1 then xpos = 1 end
	end
	return create_cursor(self.content,ln_n,xpos,pref_pos)
end

function TextEditor:toggle_bookmarks()
	self.bookmark_drawer:toggle()
	self.show_bookmarks = self.bookmark_drawer._open
	if self.bookmark_drawer._open then
		self.todo_drawer:close()
--		self.sticker_drawer:close()
	end
end

function TextEditor:close_bookmarks()
	self.bookmark_drawer:close()
	self.show_bookmarks = false
end

function TextEditor:open_bookmarks()
	self.bookmark_drawer:open()
	self.show_bookmarks = true
	self.todo_drawer:close()
end

function TextEditor:toggle_todos()
	self.todo_drawer:toggle()
	if self.todo_drawer._open then
		self.bookmark_drawer:close()
--		self.sticker_drawer:close()
	end
end

function TextEditor:close_todos()
	self.todo_drawer:close()
end

function TextEditor:open_todos()
	self.todo_drawer:open()
	self.bookmark_drawer:close()
end

