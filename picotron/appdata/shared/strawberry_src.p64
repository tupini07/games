TextEditor = create_class(XiGuiElem,Clickable)


function TextEditor:_init(attribs)
	local content = attribs.content or 
		TextContent{text=attribs.text}
	
	self.since_inp=0
	self.content_h=0
	self.content_w=0
--	screen_refresh_needed=true
	
	self.autocomp_pos=1
--	just_refreshed = false,
	
	self:apply_defaults{
--		w=100,
--		h=100,
		content = content,
		ln_at_top=1,
		top_guess=1,
		top_offset=0,
		l_pad=3,
		t_pad=3,
		b_pad=50,
		bg_col="bg",
		text_col="basic_text",
		cursor_col="highlight",
		selection_col="te_selection",
		show_ln_ns=false,
		bold_col="highlight",
		ln_n_width=17,
		ln_n_bg_col="middle",
		ln_n_highlight_col="light",
		highlight_syntax=false,
		word_wrap=false,
		smooth_scroll=true,
		user_funcs={},
		scroll = SecOrdDyn{f=0.08,z=1,r=0,pos=vec(0,0)},
		scroll_target = vec(0,0),
		bookmark_top=3,
		show_bookmarks=false,
		enable_autocomplete=true,
		rainbow_brackets=false,
		scrollable=not attribs.single_line,
		todos=true,
	}
	
	if attribs.w == nil and attribs.w_func == nil then
		self.w_func=full_width()
	end
	
	if attribs.h == nil and attribs.h_func == nil then
		self.h_func=full_height()
	end
	
	self.func_descs = te_func_descs
	
--	for _,sticker in pairs(self.content.stickers) do
--		sticker:add_to(self,vec(-1000,1000))
--		sticker.te=self
--	end
	
--	self.sticker_drawer=Drawer{
