:: lib/xi_gui/text_ed/
:: lib/xi_gui/text_ed/autocomp.lua
--[[pod_format="raw",created="2025-04-23 08:59:00",modified="2025-05-22 11:54:08",revision=1349]]
function get_autocomp_list(e)
	local to_comp = get_token_to_autocomp(e)

	if to_comp == nil or #to_comp < 1 then
		return nil, nil
	end
	
	local var_lst
	
	if to_comp[1] == chr(34) then
		var_lst = get_autocomp_path(e,to_comp)
		
	else
		var_lst = get_autocomp_var(e,to_comp)
	end
	
	if not var_lst or #var_lst == 0 then
		return nil, nil
	end
	
	return var_lst, to_comp
end

function get_autocomp_path(e,to_comp)
	to_comp = sub(to_comp,2)

	local parts = split(to_comp,"/",false)
	local part_path = ""
	
	for i = 1,#parts-1 do
		if i > 1 then
			part_path=part_path.."/"
		end
		part_path=part_path..parts[i]
	end
	
	local partial_end = parts[#parts]
	
	if #part_path > 0 or to_comp[1] == "/" then
		part_path = part_path.."/"
	end
	
	local path = e.content:get_fullpath(part_path)
	
	if not path or fstat(path) != "folder" then
		return nil
	end
	
	local files = ls(path)
	
	local var_lst = {}
	
	local folders = {}
	
	for file in all(files) do
		if sub(file,1,#partial_end) == partial_end then
			if #partial_end!= #file then
				add(var_lst,chr(34)..part_path..file)
			end
			if file[#file] != "/" then
				file = file.."/"
			end
			if fstat(path.."/"..file) == "folder" then
				add(folders,file)
				
			end
		end
	end
	sort_list_alpha(var_lst)
	sort_list_alpha(folders)
	
	for folder in all(folders) do
		files = ls(path.."/"..folder)
		local fld_lst = {}
		for file in all(files) do
			if #partial_end!= #file then
				add(var_lst,chr(34)..part_path..folder..file)
			end
		end
		sort_list_alpha(fld_lst)
		for f in all(fld_lst) do
			add(var_lst,f)
		end
	end
	
	return var_lst
end

function get_autocomp_var(e,to_comp)
	local lvars = unpod(e.content.crs:get_ln().lvars)

	local core_lst = {}
	local usr_lst = {}
	local var_lst = {}

	for nm,_ in pairs(e.func_descs) do
		if #to_comp < #nm and sub(nm,0,#to_comp) == to_comp then
			add(core_lst,nm)
		end
	end
	sort_list_alpha(core_lst)

	for _,lst in pairs(e.user_funcs) do
		for nm,_ in pairs(lst) do
			if #to_comp < #nm and sub(nm,0,#to_comp) == to_comp then
				add(usr_lst,nm)
			end
		end
	end
	sort_list_alpha(usr_lst)
	
	for lst in all(lvars) do
		for nm,_ in pairs(lst) do
			if #to_comp < #nm and sub(nm,0,#to_comp) == to_comp then
				add(var_lst,nm)
			end
		end
	end
	sort_list_alpha(var_lst)
	
	for item in all(core_lst) do
		add(var_lst,item)
	end
	for item in all(usr_lst) do
		add(var_lst,item)
	end
	
	if #var_lst < 1 then
		return nil, nil
	end

	return var_lst
end

function sort_list_alpha(lst)
	local n = #lst
	
	for i = 1,n do
		local swapped = false
		for j = 1,n-i do
			if alpha_a_gt_b(lst[j],lst[j+1]) then
				lst[j], lst[j+1] = lst[j+1], lst[j]
				swapped=true
			end
		end
		
		if not swapped then
			break
		end
	end
	
	return lst
end

function alpha_a_gt_b(a,b)
	for i = 1,min(#a,#b) do
		if ord(a[i]) < ord(b[i]) then
			return false
		elseif ord(a[i]) > ord(b[i]) then
			return true
		end
	end
	return #a > #b
end

function get_token_to_autocomp(e)
	local text = e.content.crs:get_ln().text
	local token_state = 0
	local target_pos = e.content.crs.xpos
	local pos = 1
	local out = ""
	
	
	local r
	if sub(text,1,7) == "--[[pod" then
		r = unpod(text)
	end
	
	if type(r) == "userdata" then
		return nil,nil
	end
	
	while (pos <= #text) do
		local str, pos1, cat
		str, pos1, cat, token_state = tokenoid(text, pos, token_state)
		
		if (not str) then return nil end
	
		if pos <= target_pos and pos1 > target_pos then
			return nil
		elseif pos1 == target_pos then-- and pos1 > #text then
			return str
--		elseif pos1 == target_pos then
--			return nil
		end
	
		pos = pos1
	end
	return nil
end

:: lib/xi_gui/text_ed/bookmarks.lua
--[[pod_format="raw",created="2025-05-06 12:38:58",modified="2025-08-31 08:47:26",revision=4066,xstickers={}]]
do

BookmarkGroup = create_class(Canvas)

function BookmarkGroup:_init(attribs)
	assert(not attribs.show_title or attribs.title, "Either don't show bookmark group title or give it one.")
	assert(attribs.bookmarks, "No bookmarks provided when creating group.")

	local h = #attribs.bookmarks*7
	
	if attribs.show_title then
		h+=7
	end

	self:apply_defaults{
		w_func=full_width(7),
		h=h,
--		bg_col="middle",
		title_col="light",
		text_col="bg",
		hover_col="light"
	}
	
	if (attribs.bg_col == nil) self.bg_col="middle"

end

function BookmarkGroup:hover()
	local mse = get_mouse_listener()
	local pos = self.abs_pos
	local prev_hovered = self.hovered
	
	self.hovered = (mse.pos.y-pos.y-1)//7
	if not self.show_title then
		self.hovered += 1
	end
	
	if self.hovered >= 1 then
		mse:set_pointer("pointer")
	end
	
	if self.hovered != prev_hovered then
		self:request_redraw(true)
	end
end

function BookmarkGroup:end_hover()
	self.hovered=nil
	self:request_redraw(true)
end

function BookmarkGroup:lmb_release()
	local b = self.bookmarks[self.hovered]
	
	if not b or b.ln_n > #self.te.content.lns then return end
	self.te.scroll_target.y = self.te.content.lns[b.ln_n].btm-20
	self.te.content.crs:move_to(1,b.ln_n)
	self.te.content.selection=nil
	
	self.te.held_crs = nil
	self.te.autocomplete = nil
	self.te:request_redraw(true)
end

function BookmarkGroup:draw()
	local pos = self.canv_pos
--	if pos.y > get_display():height() then
--		return
--	end

	rectfill(
		pos.x,pos.y,
		pos.x+self.w-1,pos.y+self.h-1,
		self:get_theme_colour(self.bg_col)
	)
	if self.hovered and self.hovered >= 1 then
		local i = self.hovered
		if not self.show_title then
			i-=1
		end
		rectfill(
			pos.x,pos.y+7*i,
			pos.x+self.w-1,pos.y+7*i+6,
			self:get_theme_colour(self.hover_col)
		)
	end
	
	local y = pos.y+1
	local text_col = self:get_theme_colour(self.text_col)
	
	if self.show_title then
		print("\014"..self.title,pos.x+2,y,self:get_theme_colour(self.title_col))
		y+=7
	end
	
	for b in all(self.bookmarks) do
		local title = b.title:lower()
		
		if #title > 18 then
			title=sub(title,1,17)..">"
		end
		print("\014- "..title,pos.x+2,y,text_col)
		y+=7
	end
end

function create_bookmark_drawer(te, top)
	te.bookmark_drawer=Drawer{
--		h=full_height(ceil(top/2)+7),
		h=100,
		w=98,
		direction=DRAWER_LEFT,
		handle_size=0,
	}:add_to(te,vec(-1,top))

	te.bookmark_box=create_container{
		h=full_height(),
		w=full_width(),
		vert_layout=true,
		align=ALIGN_RIGHT,
		gap_size=2,
		l_pad=14,
		scrollable=true,
		scroll_args={
			thumb_col="light",
			r_pad=7,
			w=4,
		},
	}:add_to(te.bookmark_drawer.contents)
end

function set_bookmarks(te, bookmarks)
	local groups_lkp = {}
	local groups={}
	local assigned = 0
	
	local general = "functions"
	
	if not te.highlight_syntax then
		general = "sections"
	end
	
--	local max_w = 50
	
	for b in all(bookmarks) do
		if b.group and not groups_lkp[b.group] then
			groups_lkp[b.group] = {}
			add(groups,b.group)
		elseif not b.group and not groups_lkp[general] then
			groups_lkp[general] = {}
			add(groups,general)
		end
		
		if b.group then
			add(groups_lkp[b.group],b)
--			max_w = max(max_w,(min(#b.group,18))*4+5)
		else
			add(groups_lkp[general],b)
		end
		
--		max_w = max(max_w,(min(#b.title,18)+2)*4+5)
	end
	
--	te.bookmark_drawer:update_dims{w=max_w+13}
	
	if te.bookmark_drawer._open then
		te.changed_width = true
	end

	local h = 0

	for g in all(groups) do
		local title = g:lower()
		
		local b = BookmarkGroup{
			title=title,
			bookmarks=groups_lkp[g],
			show_title=true,
			te=te,
		}:add_to(te.bookmark_box)
		h+=b.h+2
	end
	
	te.bookmark_drawer:update_dims{h=min(h,te.h-te.bookmark_top-7)}
end

function remove_bookmarks(te)
	for b in all(te.bookmark_box.elems) do
		if b.special_typ != "scrollbar" then
			b:remove()
		end
	end
	te.bookmarks = {}
end

end
:: lib/xi_gui/text_ed/content.lua
--[[pod_format="raw",created="2025-03-28 11:54:22",modified="2025-05-28 12:23:58",revision=28695,xstickers={}]]
do

local next_content_id=0

TextContent = create_class()

function TextContent:_init(attribs)
	self.line_refresh_needed = true
	self.w=0
	self.unsaved_changes = false

	local text = attribs.text or ""
	if attribs.id == nil then
		attribs.id = next_content_id
		next_content_id+=1
	end
	
	self.id = attribs.id
	self.lns=create_text_lines(text)
	self.bookmarks={}
	self.todos={}
	
	self.stickers={}
	
--	if attribs.meta and attribs.meta.xstickers then
--		for sticker in all(attribs.meta.xstickers) do
--			self:add_sticker(sticker)
--		end
--	end
	
	self.h = #self.lns*10
	self.crs = create_cursor(self,1,1)

	create_undo_stacks(self)
end

function TextContent:add_sticker(attribs)
	local s = Sticker{
		idx=attribs.idx,
		ln=self.lns[attribs.ln_n],
		off=attribs.off,
	}
	add(self.stickers,s)
	add(s.ln.stickers,s)
	return s
end

function TextContent:update(since_inp)
	self.undo_stacks:update(since_inp)
end

function TextContent:find(to_find)
	local found = {}
	for ln_n,ln in pairs(self.lns) do
		local st, nd = string.find(ln.text, to_find,1,true)
		while st and nd do
			add(found,
				create_selection(
					create_cursor(self,ln_n,st),
					create_cursor(self,ln_n,nd+1)
				)
			)
			st, nd = string.find(ln.text, to_find, nd+1,true)
		end
	end
	return found
end

function TextContent:add_line(ln_n,text,is_undo,is_redo)
	if ln_n <= #self.lns then
		local next_ln = self.lns[ln_n]
		local new_ln = TextLine{
			text=text,
			prev=next_ln.prev,
			next=next_ln,
			btm=next_ln.btm,
			top=next_ln.btm+10
		}
		add(self.lns,new_ln,ln_n)
		if next_ln.prev then
			next_ln.prev.next = new_ln
		end
		next_ln.prev = new_ln
	else
		local prev_ln = self.lns[#self.lns]
		local new_ln = TextLine{
			text=text,
			prev=prev_ln,
			btm=prev_ln.btm-10,
			top=prev_ln.btm
		}
		add(self.lns,new_ln)
		prev_ln.next = new_ln
	end
	self.line_refresh_needed=true
	self.unsaved_changes=true
	self.undo_stacks:add_add_step(ln_n,is_undo,is_redo)
end

function TextContent:delete_line(ln_n,is_undo,is_redo)
	local ln = self.lns[ln_n]
	local prev_ln = ln.prev
	local next_ln = ln.next
	del(self.lns,ln)
	
	if prev_ln then
		prev_ln.next = ln.next
	end
	if next_ln then
		next_ln.prev = ln.prev
	end
	
	for _,s in pairs(ln.stickers) do
		s:remove()
		del(self.stickers,s)
		del(ln.stickers,s)
	end
	
	self.line_refresh_needed=true
	self.unsaved_changes=true
	self.undo_stacks:add_del_step(ln_n,ln.text,is_undo,is_redo)
end

function TextContent:replace_line_content(ln_n,text,is_undo,is_redo)
	local ln = self.lns[ln_n]
	local btext = ln.text
	ln.text = text
	ln.wrapped_lines = nil
	ln.highlighted = nil
	self.line_refresh_needed=true
	self.unsaved_changes=true
	self.undo_stacks:add_replace_step(ln_n,btext,text,is_undo,is_redo)
end

function refresh_content(self,args)
	local syntax = args.syntax
	local word_wrap = args.word_wrap
	local width = args.width
	local lvars = {{["self"]="te_func_var"}}
	local fds = {}
	local frames = 1
	local lns_done = 0
	local w=0
	local h=0
	local ch=0
	local bookmarks={}
	local text_lines={}
	local just_text=""
	local cur_group = nil
	local included_files = {}
	local todos = {}
	local apos = false
	
	local podded_user_funcs = pod(self.user_funcs)
	
	local cost = 0
	
	self.line_refresh_needed=false
	for ln_n,l in pairs(self.lns) do
		add(text_lines,l.text)
	
		if syntax then
			local indent = l:get_indent()
		
			if sub(l.text,indent+1,indent+9)=="--[[GROUP" then
				if sub(l.text,indent+10,indent+11) == "]]" then
					cur_group = nil
				elseif l.text[indent+10]==":" then
					local nd = string.find(l.text,"]]",1,true)
					if nd and nd > indent+11 then
						cur_group = sub(l.text,indent+11,nd-1)
					end
				end
			end
		
			local state = l:refresh(lvars,args)
			
			if l.included_file and type(self.id) == "string" then
				add(included_files, l.included_file)
			end
			if l.todo then
				local txt, comp = l.todo,sub(l.todo,#l.todo-7)=="COMPLETE"
				if (comp) txt = sub(txt,1,#txt-9)
				add(todos, {
					text=txt,
					ln_n=ln_n,
					complete = comp
				})
			end
			
			if args.no_highlight then
				l.highlighted=nil
			end
			
			cost += state.cost+0.25
			
			if state.func_declared then
				--add_user_func(fds,l)
				fds[state.func_declared]=self:extract_func_def(ln_n)
			end
			
			if state.func_declared then
				add(bookmarks,{title=state.func_declared,ln_n=ln_n,group=cur_group or state.group_declared})
			elseif sub(l.text,indent+1,indent+13)=="--[[BOOKMARK:" then
				local nd = string.find(l.text,"]]",1,true)
				if nd and nd > indent+14 then
					add(bookmarks,{title=sub(l.text,indent+14,nd-1),ln_n=ln_n,group="bookmarks"})
				end
			end
			
			if l.text[#l.text] == "'" then
				apos = true
			end
	
		else
			l:text_refresh(not syntax and word_wrap, width)
			
			cost += 1
			
			if sub(l.text,1,2)=="# " then
				cur_group = sub(l.text,3)
			elseif sub(l.text,1,3)=="## " then
				add(bookmarks,{title=sub(l.text,4),ln_n=ln_n,group=cur_group})
			elseif sub(l.text,1,2)=="* " then
				local nd = string.find(l.text," *",1,true)
				if nd and nd > 3 then
					cur_group = sub(l.text,3,nd-1)
				end
			elseif sub(l.text,1,3)=="** " then
				local nd = string.find(l.text," **",1,true)
				if nd and nd > 4 then
					add(bookmarks,{title=sub(l.text,4,nd-1),ln_n=ln_n,group=cur_group})
				end
			end
		end
		
		l.btm=ch
		ch+=l.h
		l.top=ch
		
		for _,sticker in pairs(l.stickers) do
			sticker:update_dims{pos=sticker.off+vec(0,l.btm)}
		end
		
		h+=l.h
		
		if l.wrapped_lines and not syntax and word_wrap then
			cost += #l.wrapped_lines
			for _,wl in pairs(l.wrapped_lines) do
				w=max(w,#wl.text*5+10)
			end
		else
			w=max(w,#l.text*5+10)
		end
		
		if cost >= 40 then
			frames+=1
			cost=0
			yield()
		end
	end
	
	yield()
	
	just_text = table.concat(text_lines,"\n")
	
	yield()
	
	self.w = w
	self.h = h
	frames_to_refresh = frames
	
	if pod(fds) != podded_user_funcs then
		self.user_funcs=fds
		self.line_refresh_needed = true
	end
	self.bookmarks=bookmarks
	self.included_files = included_files
	self.todos = todos
	
--	for _,sticker in pairs(self.stickers) do
--		if sticker.ln_n > #self.lns then
--			sticker:remove()
--			del(self.stickers,sticker)
--		else
--			sticker:update_dims{
--				pos=vec(
--					sticker.off.x,
--					sticker.off.y+self.lns[sticker.ln_n].btm
--				)
--			}
--		end
--	end
	
	if syntax then --and not apos then
		local f, msg = load(just_text,"@"..self.id,"t",{})
		
		if f then
			self.err = nil
		else
			self.err = process_err_msg(msg)
		end
	else
		self.err = nil
	end
end

function TextContent:extract_func_def(ln_n)
	local ln = self.lns[ln_n]
	local text = ln.text
	local pos = 1
	local token_state = 0
	local func_start = false
	
	local fd = {
		ln_n=ln_n
	}
	
	while (pos <= #text) do
		local str, pos1, cat
		str, pos1, cat, token_state = tokenoid(text, pos, token_state)
		
		if str == "function" and cat == 1 then
			func_start = true
		elseif func_start and cat == 1 then
			break
		end
		
		pos = pos1
	end
	
	fd.title = sub(text,pos)
	fd.text = {}
	
	local next_line_n = ln_n+1
	
	
	while (
		next_line_n <= #self.lns 
	) do
		local next_line_indent = self.lns[next_line_n]:get_indent()
		local _, _, start_cat = tokenoid(
			self.lns[next_line_n].text,
			next_line_indent+1,
			self.lns[next_line_n]:get_initial_state()
		)
		if start_cat!=3 then
			break
		end
		
		local txt = sub(
			self.lns[next_line_n].text,next_line_indent+1
		)
		
		if (sub(txt,1,4) == "--[[") then
			txt = sub(txt,5)
		elseif (sub(txt,1,2) == "--") then
			txt = sub(txt,3)
		end
		if (sub(txt,#txt-1) == "]]") txt = sub(txt,1,#txt-2)
		
		if #txt > 0 then
			add(fd.text,txt)
		end
		next_line_n += 1
	end
	
	if #fd.text == 0 then
		local next_line_n = ln_n-1
		
		while (
			next_line_n > 0
		) do
			local next_line_indent = self.lns[next_line_n]:get_indent()
			local _, _, start_cat = tokenoid(
				self.lns[next_line_n].text,
				next_line_indent+1,
				self.lns[next_line_n]:get_initial_state()
			)
			if start_cat!=3 then
				break
			end
			
			local txt = sub(
				self.lns[next_line_n].text,next_line_indent+1
			)
		
			if (sub(txt,1,4) == "--[[") then
				txt = sub(txt,5)
			elseif (sub(txt,1,2) == "--") then
				txt = sub(txt,3)
			end
			if (sub(txt,#txt-1) == "]]") txt = sub(txt,1,#txt-2)
			
			if #txt > 0 then
				add(fd.text,txt,1)
			end
			
			next_line_n -= 1
		end
	end
	
	return fd
end

function process_err_msg(msg)
	local lst = split(msg,":",false)
	local _, ln_n, content  = unpack(lst)
	local s = split(msg,"'",false)
	local tkn = s[#s-1]
	
	if not ln_n or not content or not tkn or #tkn==0 then
		return nil
	end
	
	return {
		ln_n=tonum(ln_n),
		msg=content,
		tkn=tkn,
	}
end

function TextContent:get_fullpath(path)
	local fpath = nil
			
	if path[1] == "/" then
		return path
	elseif type(self.id) != "string" then
		return nil
	else
		local path_parts = split(self.id,"/",false)
		fpath = path_parts[1]
		local found = false
		for i = 2,#path_parts+1 do
			if fstat(fpath.."/main.lua") then
				found = true
				break
			end
			if i <= #path_parts then
				fpath = fpath.."/"..path_parts[i]
			end
		end
	
		if found then
			fpath = fpath.."/"..path
			return fpath
		else
			return nil
		end
		
		
	end
end

function TextContent:get_text()
	local text_lines = {}
	local stickers = {}
	for i, l in ipairs(self.lns) do
		add(text_lines,l.text)
		for _,sticker in pairs(l.stickers) do
			add(stickers,{idx=sticker.idx,off=sticker.off,ln_n=i})
		end
	end

	return table.concat(text_lines,"\n"), {xstickers=stickers}
end

function TextContent:save()
	if type(self.id) != "string" then
		notify("Can't save non-file content.")
	else
		store(fullpath(self.id),self:get_text())
	end
end

function load_text_file(path)
	local raw_text, meta = fetch(path)
	if raw_text == nil or type(raw_text) != "string" then
		return nil
	end
	local 	tc = TextContent{text=raw_text,meta=meta,id=path}
	
--	local ref = cocreate(refresh_content)
--	while costatus(ref) != "dead" do
--		coresume(ref,tc,{syntax=tc.id:ext()=="lua",no_highlight=true,theme={},func_descs={},user_funcs={}})
--	end
--	tc.line_refresh_needed=true
	return tc
end

end

:: lib/xi_gui/text_ed/cursor.lua
--[[pod_format="raw",created="2025-03-28 12:16:55",modified="2025-05-18 15:14:46",revision=14275]]
function create_cursor(content,ln_n,xpos,pref_pos)
	if not pref_pos then
		if ln_n <= #content.lns then
			pref_pos = xpos + min(content.lns[ln_n]:get_indent(),xpos-1)*2
		else
			pref_pos = xpos
		end
	end

	return {
		content=content,
		ln_n=ln_n,
		xpos=xpos,
		pref_xpos=pref_pos,
		get_ln=get_ln_at_cursor,
		move_to=move_cursor,
		left=cur_left,
		right=cur_right,
		up=cur_up,
		down=cur_down,
		matches=cursors_match,
		copy=function(c)
			return create_cursor(c.content,c.ln_n,c.xpos)
		end,
	}
end

function cursors_match(c1,c2)
	--[[
		Checks if cursors c1 and c2 are equivalent
		(same line, content, and position
	]]
	return c1.content == c2.content and c1.ln_n == c2.ln_n and c1.xpos == c2.xpos
end

function get_ln_at_cursor(c)
	return c.content.lns[c.ln_n]
end

function move_cursor(c, xpos, ln_n, content)
	if ln_n == nil then ln_n = c.ln_n end
	if content == nil then content = c.content end
	
	c.ln_n = mid(ln_n, 1, #content.lns)
	c.xpos = mid(xpos, 1, #content.lns[c.ln_n].text+1)
	c.pref_xpos = c.xpos + min(c:get_ln():get_indent(),c.xpos-1)*2
end

function cur_left(c,n,wrap)
	n = n or 1
	c.xpos-=n
	if c.xpos < 1 then
		c.ln_n-=1
		if c.ln_n >= 1 then
			c.xpos=#c:get_ln().text+1
		else
			c.xpos=1
			c.ln_n=1
		end
	end
	local ln = c:get_ln()
	if wrap and ln.wrapped_lines then
		local w_ln_n = 1
		local tl = 0
		
		while c.xpos > tl+#ln.wrapped_lines[w_ln_n].text+1 do
			tl+=#ln.wrapped_lines[w_ln_n].text+1
			w_ln_n+=1
		end
		
		c.pref_xpos=c.xpos-tl
	else
		c.pref_xpos=c.xpos+ min(ln:get_indent(),c.xpos-1)*2
	end
end

function cur_right(c,n,wrap)
	n = n or 1
	c.xpos+=n
	if c.xpos > #c:get_ln().text+1 then
		c.xpos=1
		c.ln_n+=1
		if c.ln_n > #c.content.lns then
			c.ln_n = #c.content.lns
			c.xpos=#c.content.lns[#c.content.lns].text+1
		end
	end
	local ln = c:get_ln()
	if wrap and ln.wrapped_lines then
		local w_ln_n = 1
		local tl = 0
		
		while c.xpos > tl+#ln.wrapped_lines[w_ln_n].text+1 do
			tl+=#ln.wrapped_lines[w_ln_n].text+1
			w_ln_n+=1
		end
		
		c.pref_xpos=c.xpos-tl
	else
		c.pref_xpos=c.xpos+ min(ln:get_indent(),c.xpos-1)*2
	end
end

function cur_up(c,n,wrap)
	n = n or 1
	local ln=c:get_ln()
	
	if wrap and ln.wrapped_lines then
		local w_ln_n = 1
		local tl = 0
		
		while c.xpos > tl+#ln.wrapped_lines[w_ln_n].text+1 do
			tl+=#ln.wrapped_lines[w_ln_n].text+1
			w_ln_n+=1
		end
		local w_xpos = c.xpos-tl
		
		if w_ln_n-n < 1 then
			if c.ln_n == 1 then
				c:up()
				return
			end
			
			c.ln_n-=1
			ln=c:get_ln()
			tl=0
			for i = 1,#ln.wrapped_lines-1 do
				tl+=#ln.wrapped_lines[i].text+1
			end
			c.xpos=min(tl+c.pref_xpos,tl+#ln.wrapped_lines[#ln.wrapped_lines].text+1)
			if n-w_ln_n > 0 then
				c:up(n-w_ln_n,true)
			end
			
			return
		end
		
		for i = 1,n do
			w_ln_n-=1
			tl-=#ln.wrapped_lines[w_ln_n].text+1
		end

		c.xpos=tl+c.pref_xpos
		c.xpos=min(c.xpos,tl+#ln.wrapped_lines[w_ln_n].text+1)
	else
		c.ln_n-=n
		if c.ln_n >= 1 then
			c.xpos = c.pref_xpos
			if c:get_ln():get_indent()*3 >= c.xpos then c.xpos -= (c.xpos-1)%3 end
			c.xpos -= min(c:get_ln():get_indent(),flr((c.xpos-1)/3))*2
			c.xpos=min(c.xpos,#c:get_ln().text+1)
		else
			c.xpos=1
			c.ln_n=1
			c.pref_xpos=c.xpos+ min(c:get_ln():get_indent(),c.xpos-1)*2
		end
	end
end

function cur_down(c,n,wrap)
	n = n or 1
	local ln = c:get_ln()

	if wrap and ln.wrapped_lines then
		local w_ln_n = 1
		local tl = 0
		
		while c.xpos > tl+#ln.wrapped_lines[w_ln_n].text+1 do
			tl+=#ln.wrapped_lines[w_ln_n].text+1
			w_ln_n+=1
		end
		local w_xpos = c.xpos-tl
		
		if w_ln_n+n > #ln.wrapped_lines then
			c:down()
			if n-(#ln.wrapped_lines-w_ln_n)-1 > 0 then
				c:down(n-(#ln.wrapped_lines-w_ln_n)-1,true)
			end
			return
		end
		
		for i = 1,n do
			tl+=#ln.wrapped_lines[w_ln_n].text+1
			w_ln_n+=1
		end
		c.xpos=tl+c.pref_xpos

		c.xpos=min(c.xpos,tl+#ln.wrapped_lines[w_ln_n].text+1)
	else
		c.ln_n+=n
		if c.ln_n <= #c.content.lns then
			c.xpos = c.pref_xpos
			if c:get_ln():get_indent()*3 >= c.xpos then c.xpos -= (c.xpos-1)%3 end
			c.xpos -= min(c:get_ln():get_indent(),flr((c.xpos-1)/3))*2
			c.xpos=min(c.xpos,#c:get_ln().text+1)
		else
			c.ln_n=#c.content.lns
			c.xpos=#c:get_ln().text+1
			c.pref_xpos=c.xpos+ min(c:get_ln():get_indent(),c.xpos-1)*2
		end
	end
end

function select_token(c,e)
	local txt = c:get_ln().text
	if c.xpos > #txt then
		e.content.selection = nil
		e.content.crs=c
		return
	end
	local c2 = c:copy()
	local base_type = get_char_type(txt[c.xpos])
	while c.xpos <= #txt and get_char_type(txt[c.xpos]) == base_type do
		c:right()
	end
	if c2.xpos > 1 then
		while c2.xpos-1 >= 1 and get_char_type(txt[c2.xpos-1]) == base_type do
			c2:left()
		end
	end
	e.content.selection = create_selection(c,c2)
	e.content.crs=c
end

-- Categorizes characters by type
-- Returns a number, 1-3
-- 1: control chars/whitespace
-- 2: punctuation
-- 3: letters, numbers, underscore
function get_char_type(c)
	c = ord(c)
	if c < 33 then return 1 end
	if c < 48 then return 2 end
	if c < 58 then return 3 end
	if c < 65 then return 2 end
	if c < 91 then return 3 end
	if c == 95 then return 3 end
	if c < 97 then return 2 end
	if c < 123 then return 3 end
	return 2
end

