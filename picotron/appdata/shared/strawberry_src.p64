--[[pod_type="gfx"]]unpod("b64:_MABTUAchE3AXABNxEKAMHwATEwESAREBEAERAIAFMQURBRABAAsBAxkDEQERAREDEQ")

-- A slightly-less-simple code & text editor
-- Author: Matt Sutton
-- Version: 1.2.1

